{
  "rules": [
    {
      "enabled": true,
      "name": "attachments-14d-expiry",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": [ "blockBlob" ],
          "prefixMatch": [ "attachments/" ]
        },
        "actions": {
          "baseBlob": {
            "delete": { "daysAfterCreationGreaterThan": 14 }
          }
        }
      }
    }
  ]
}
