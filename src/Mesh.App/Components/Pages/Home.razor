    async Task CancelQueued(ChatLine line)
    {
        var queued = QueueInfo(line);
        if (queued is null) return;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:cancel:{queued.ThreadId}",
            queued.ThreadId,
            line.Id,
            runId: queued.RunId);
        if (!await TopicRouter.CancelQueuedAsync(
                operationScope, CancellationToken.None))
            State.TryApplyScopedAsyncOperation(
                operationScope,
                () => dispatchError = "The queued turn could not be cancelled yet.");
        else
            State.TryCompleteScopedAsyncOperation(operationScope);
    }
    IReadOnlyList<ChatLine> OrderedVisibleLines => Active is null
        ? Array.Empty<ChatLine>()
        : TopicTranscriptOrdering.OrderForDisplay(Active.Lines.Where(line => !line.Internal));

