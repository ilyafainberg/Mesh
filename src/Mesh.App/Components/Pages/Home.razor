    async Task PickFile()
    {
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:pick-file",
            Active?.Id);
        attachError = null;
        try
        {
            await JS.InvokeVoidAsync("meshUI.prepareForNativePicker", composerEl);
            var file = await Microsoft.Maui.Storage.FilePicker.Default.PickAsync();
            if (file is null) return;
            await using var stream = await file.OpenReadAsync();
            var staged = await PickedFileStager.StageAsync(file.FileName, file.ContentType, stream);
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                LocalFiles.Allow(staged.Path);
                attachments.Add(new StagedFile(staged.Name, staged.Path, staged.Size));
            });
        }
        catch (Exception ex)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError = "Couldn't attach that file: " + ex.Message);
        }
    }

    static string Human(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }

    async Task StopActive()
    {
        if (Active is null) return;
        var thread = Active;
        var runId = CurrentRunId(thread);
        if (string.IsNullOrWhiteSpace(runId)) return;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:stop:{thread.Id}",
            thread.Id,
            runId: runId);
        var stopped = await TopicRouter.StopAsync(operationScope, CancellationToken.None);
        // No live run to cancel (a stranded run id from a completed or lost remote run): reconcile
        // locally so the phantom "thinking" indicator and Stop button clear immediately.
        State.TryCompleteScopedAsyncOperation(operationScope, () =>
        {
            if (!stopped
                && State.GetRemoteRunProjection(thread.Id) is null
                && IsRemoteBound(thread))
                State.ClearRemoteRunProjection(thread.Id, runId);
        });
    }

    async Task RequestAiResponse()
    {
        if (SendDisabled) return;
        var runtimeScope = State.CaptureAgentRuntimeScope();
        using var runtimeContext = State.EnterAgentRuntimeScope(runtimeScope);
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:assistant-send");
        dispatchError = null;
        var text = input;
        IReadOnlyList<global::Mesh.Shared.DeviceInfo> freshDevices;
        try
        {
            freshDevices = await TopicRouter.ListDevicesAsync(rosterLifetime.Token);
        }
        catch
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
                dispatchError = "Could not verify an execution host. Bring an agent device online and retry.");
            return;
        }
        if (!State.IsCurrentAgentRuntimeScope(runtimeScope)) return;
        var freshEligible =
            global::Mesh.Shared.DeviceExecutionEligibility.EligibleHosts(freshDevices);
        var selectedHostId = Active?.AgentExecutionHostDeviceId;
        var executionHost = freshEligible.FirstOrDefault(device =>
                                string.Equals(device.DeviceId, selectedHostId, StringComparison.Ordinal))
                            ?? freshEligible.FirstOrDefault(device =>
                                string.Equals(device.DeviceId, Mesh.MyDeviceId, StringComparison.Ordinal))
                            ?? freshEligible.FirstOrDefault();
        if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                rosterDevices.Clear();
                rosterDevices.AddRange(freshDevices);
                eligibleDevices.Clear();
                eligibleDevices.AddRange(freshEligible);
            }))
            return;
        if (executionHost is null)
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
                dispatchError = "Bring an agent device online or move this topic to an online agent-ready Desktop.");
            return;
        }
        var requestedHost = ToAgentExecutionHost(executionHost);
        OwnThread thread;
        try
        {
            thread = Active ?? await State.NewOwnThreadAsync(
                "New chat",
                requestedHost);
        }
        catch
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
                dispatchError = "Could not create the assistant chat. Your draft was preserved.");
            return;
        }
        if (!State.TryAdvanceScopedAsyncOperation(
                operationScope,
                out var threadOperationScope,
                topicId: thread.Id)
            || !State.TryApplyScopedAsyncOperation(threadOperationScope!, () =>
            {
                activeThread = thread.Id;
                input = text;
                if (!string.Equals(
                        thread.AgentExecutionHostDeviceId,
                        requestedHost.DeviceId,
                        StringComparison.Ordinal))
                    State.AssignOwnThreadAgentExecutionHost(thread.Id, requestedHost);
            }))
            return;
        operationScope = threadOperationScope!;

        var chosenWidget = selectedWidget;
        var titleText = !string.IsNullOrWhiteSpace(text)
            ? text
            : chosenWidget is not null ? $"Use widget: {chosenWidget.Name}" : "";
        if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                if (string.Equals(thread.Title, "New chat", StringComparison.Ordinal)
                    && !string.IsNullOrWhiteSpace(titleText))
                    State.RenameOwnThread(thread.Id, Titleize(titleText));
            }))
            return;

        var files = attachments.ToList();
        var wasWidget = widgetMode;
        List<ChatAttachment> turnAttachments;
        try
        {
            turnAttachments = await LoadAttachmentsAsync(files, CancellationToken.None);
            if (!State.IsCurrentAgentRuntimeScope(runtimeScope)) return;
        }
        catch (Exception ex)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => dispatchError = ex.Message);
            return;
        }

        var prompt = BuildTurnPrompt(text, chosenWidget, wasWidget);
        var executionTarget = ResolveExecutionTarget(thread);
        var trigger = new ChatLine
        {
            Id = Guid.NewGuid().ToString("n"),
            Role = "user",
            Text = prompt,
            Via = "agent",
            AddressedToAgent = true,
            SenderHandle = State.Profile.Handle,
            Attachments = turnAttachments,
            At = DateTimeOffset.UtcNow
        };
        var runId = Guid.NewGuid().ToString("n");
        inFlightAssistantDispatches.Add(runId);
        try
        {
        var durableTarget = executionTarget is null
            ? null
            : ToAgentExecutionHost(executionTarget);
        AssistantAiRequestMutationScope requestScope;
        try
        {
            var durableRequest = await State.CommitAssistantAiRequestAsync(
                thread.Id,
                trigger,
                runId,
                runId,
                durableTarget);
            if (!State.TryCaptureAssistantAiRequestMutationScope(
                    durableRequest,
                    out var capturedRequestScope)
                || !State.TryAdvanceScopedAsyncOperation(
                    operationScope,
                    out var requestOperationScope,
                    scopeKey: $"{asyncScopeOwner}:assistant-send:{thread.Id}",
                    topicId: thread.Id,
                    messageId: trigger.Id,
                    requestId: durableRequest.OperationId,
                    runId: durableRequest.RunId))
                return;
            requestScope = capturedRequestScope!;
            operationScope = requestOperationScope!;
            if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
                {
                    scrollToLatestRequested = true;
                    ApplyAssistantProjection(durableRequest);
                }))
                return;
        }
        catch
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => dispatchError = "Message could not be saved. AI was not requested.");
            return;
        }
        var clearedVisibleDraft = false;
        if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                clearedVisibleDraft = ClearSubmittedDraft(thread.Id, text);
                attachments.Clear();
                widgetMode = false;
                widgetPickerOpen = false;
                selectedWidget = null;
                widgetLoading = false;
                widgetLoadError = null;
            }))
            return;
        if (clearedVisibleDraft)
        {
            await ResetComposer();
            if (!State.IsCurrentScopedAsyncOperation(operationScope)) return;
        }

        // Paint the persisted prompt before dispatch can classify it as queued or start streaming.
        await InvokeAsync(StateHasChanged);
        if (!State.IsCurrentAssistantAiRequestMutationScope(requestScope)) return;
        // A selected widget from the picker is a body-less summary; hydrate its body before it is
        // sent so the widget context never carries blank HTML.
        if (WidgetConsumerPolicy.RequiresBodyLoad(chosenWidget))
        {
            var full = await State.LoadFullWidgetAsync(chosenWidget!.Id);
            if (!State.IsCurrentAssistantAiRequestMutationScope(requestScope)) return;
            if (full is not null) chosenWidget = full;
        }

        var widgetContext = BuildWidgetContext(chosenWidget, wasWidget, text);
        var draft = new TopicTurnDraft(
            runId,
            thread.Id,
            trigger.Id,
            State.Profile.Handle,
            prompt,
            trigger.At,
            global::Mesh.Shared.TopicTurnMode.Single,
            executionTarget?.DeviceId,
            chosenWidget?.Id,
            widgetContext,
            turnAttachments);

        // Let the persisted prompt paint before dispatch can reclassify it as queued.
        await Task.Yield();
        if (!State.IsCurrentAssistantAiRequestMutationScope(requestScope)) return;
        try
        {
            var result = await TopicRouter.SubmitAsync(draft, null, CancellationToken.None);
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                var transition = State.RecordAssistantAiDispatch(requestScope, result);
                ApplyAssistantProjection(transition.Request);
            });
        }
        catch (Exception ex)
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                var transition = State.RecordAssistantAiDispatch(
                    requestScope,
                    TopicDispatchResult.Reject("dispatch_failed", runId, ex.Message));
                ApplyAssistantProjection(transition.Request);
            });
        }
        }
        finally
        {
            inFlightAssistantDispatches.Remove(runId);
            RestorePendingAiRequest();
        }
    }

    async Task RetryPendingAiResponse()
    {
        if (aiRetryRunning) return;
        aiRetryRunning = true;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:assistant-retry");
        try
        {
        RestorePendingAiRequest();
        var pending = pendingAiRetry;
        if (pending is null) return;
        var durableRequest = State.GetPendingAssistantAiRequest(pending.ThreadId);
        if (durableRequest is null
            || !string.Equals(durableRequest.RunId, pending.RunId, StringComparison.Ordinal))
            return;
        if (!State.TryCaptureAssistantAiRequestMutationScope(
                durableRequest,
                out var capturedRequestScope))
            return;
        var requestScope = capturedRequestScope!;
        if (!State.TryAdvanceScopedAsyncOperation(
                operationScope,
                out var retryOperationScope,
                scopeKey: $"{asyncScopeOwner}:assistant-retry:{pending.ThreadId}",
                topicId: pending.ThreadId,
                messageId: pending.TriggerLineId,
                requestId: requestScope.OperationId,
                runId: requestScope.RunId))
            return;
        operationScope = retryOperationScope!;
        var threadScope = State.CaptureActiveThreadMutationScope(pending.ThreadId);
        var runtimeScope = State.CaptureAgentRuntimeScope();
        using var runtimeContext = State.EnterAgentRuntimeScope(runtimeScope);
        await LoadDevicesAsync();
        if (!State.IsCurrentAssistantAiRequestMutationScope(requestScope)) return;
        var thread = State.Profile.OwnThreads.FirstOrDefault(item => item.Id == pending.ThreadId);
        var trigger = thread?.Lines.FirstOrDefault(line => line.Id == pending.TriggerLineId);
        var target = thread is null ? null : ResolveExecutionTarget(thread);
        if (thread is null || trigger is null)
        {
            State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                pendingAiRetry = null;
                dispatchError = "The original message is no longer available for AI retry.";
            });
            return;
        }
        if (target is null)
        {
            State.TryApplyScopedAsyncOperation(
                operationScope,
                () => dispatchError =
                    "Message saved. AI unavailable: choose an online agent-ready Desktop, then retry.");
            return;
        }

        if (!State.MoveOwnThreadAgentExecutionHost(
                threadScope,
                ToAgentExecutionHost(target),
                requestScope))
            return;
        var reassignedRequest = State.GetAssistantAiRequest(requestScope.RunId);
        if (!State.TryApplyScopedAsyncOperation(
                operationScope,
                () => ApplyAssistantProjection(reassignedRequest)))
            return;
        if (reassignedRequest?.IsTerminal == true) return;
        var draft = new TopicTurnDraft(
            pending.RunId,
            thread.Id,
            trigger.Id,
            State.Profile.Handle,
            trigger.Text,
            trigger.At,
            global::Mesh.Shared.TopicTurnMode.Single,
            target.DeviceId,
            Attachments: trigger.Attachments,
            TriggerOperationId: durableRequest?.OperationId ?? pending.RunId);
        var result = await TopicRouter.SubmitAsync(draft, null, CancellationToken.None);
        State.TryApplyScopedAsyncOperation(operationScope, () =>
        {
            var transition = State.RecordAssistantAiDispatch(requestScope, result);
            ApplyAssistantProjection(transition.Request);
        });
        }
        finally
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => aiRetryRunning = false);
        }
    }

    static string BuildTurnPrompt(string text, Widget? widget, bool buildWidget)
        => buildWidget ? $"Build a widget: {text}"
            : widget is null ? text
            : string.IsNullOrWhiteSpace(text) ? $"Use widget: {widget.Name}"
            : $"Update widget {widget.Name}: {text}";

    static string? BuildWidgetContext(Widget? widget, bool buildWidget, string request)
    {
        if (!buildWidget && widget is null) return null;
        return System.Text.Json.JsonSerializer.Serialize(new
        {
            operation = buildWidget ? "build" : string.IsNullOrWhiteSpace(request) ? "use" : "refine",
            widgetId = widget?.Id,
            name = widget?.Name,
            canonicalPrompt = widget?.Prompt,
            html = widget?.Html,
            request
        });
    }

    static string DispatchFailure(string code) => code.ToLowerInvariant() switch
    {
        "offline" or "target-offline" or "target_offline" => "The assigned device is offline.",
        "not-connected" or "not_connected" or "unreachable" => "Could not reach the assigned device.",
        "busy" or "queued" => "This turn could not be queued.",
        _ => "The assigned device rejected this turn."
    };

    private static readonly Dictionary<string, string> AttachmentMimes = new(StringComparer.OrdinalIgnoreCase)
    {
        [".png"] = "image/png", [".jpg"] = "image/jpeg", [".jpeg"] = "image/jpeg",
        [".gif"] = "image/gif", [".webp"] = "image/webp", [".bmp"] = "image/bmp",
        [".pdf"] = "application/pdf", [".txt"] = "text/plain", [".md"] = "text/markdown",
        [".json"] = "application/json", [".csv"] = "text/csv", [".xml"] = "application/xml"
    };

    static async Task<List<ChatAttachment>> LoadAttachmentsAsync(List<StagedFile> files, CancellationToken ct)
    {
        var result = new List<ChatAttachment>();
        foreach (var file in files)
        {
            if (file.Size > PickedFileStager.MaxAttachmentBytes) throw new InvalidOperationException($"{file.Name} is larger than the 20 MB attachment limit.");
            var mime = AttachmentMimes.GetValueOrDefault(System.IO.Path.GetExtension(file.Path), "application/octet-stream");
            var bytes = await System.IO.File.ReadAllBytesAsync(file.Path, ct);
            result.Add(new ChatAttachment(file.Name, mime, bytes));
        }
        return result;
    }

    // A short title from the first message of a new chat.
    static string Titleize(string text)
    {
        var clean = text.Replace("\r", " ").Replace("\n", " ").Trim();
        if (clean.Length == 0) return "New chat";
        return clean.Length > 40 ? clean[..40].TrimEnd() + "…" : clean;
    }

    void PinWidget(string html, ChatLine line)
    {
        pinHtml = html;
        pinName = "";
        pinPrompt = line.WidgetPrompt;
        pinError = null;
    }

    void OnPinKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(pinName)) ConfirmPin();
    }

    void ConfirmPin()
    {
        if (pinHtml is null || string.IsNullOrWhiteSpace(pinName)) return;
        var name = pinName.Trim();
        if (State.Profile.Widgets.Any(w => string.Equals(w.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            pinError = $"A widget named \"{name}\" already exists. Choose a different name.";
            return;
        }
        var widget = new Widget
        {
            Name = name,
            Html = pinHtml!,
            Prompt = pinPrompt ?? "Pinned from conversation",
            Visibility = "private",
            ModifiedAt = DateTimeOffset.UtcNow,
        };
        State.SaveAssetContent(AssetKind.Widget, widget.Id, p => p.Widgets.Add(widget));
        pinHtml = null;
        pinName = "";
        pinPrompt = null;
        pinError = null;
    }

    public void Dispose()
    {
        disposed = true;
        rosterLifetime.Cancel();
        if (rosterRefreshLoop is not null)
            Shutdown.Track(rosterRefreshLoop, "home roster refresh disposal");
        NotificationViews.Clear("desktop-topics");
        State.Changed -= Refresh;
        Mesh.ReplicationStateChanged -= Refresh;
        selfRef?.Dispose();
    }
}
