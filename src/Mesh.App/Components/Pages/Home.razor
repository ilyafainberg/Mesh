    // Messages submitted while a topic is busy stay visible below the live response. The runner answers
    // them FIFO, one serialized turn per prompt, and reply correlation restores prompt/answer pairing.
    bool IsQueued(ChatLine line) => State.IsLineQueued(line);
    QueuedTopicRunInfo? QueueInfo(ChatLine line) => State.QueuedTopicRunForLine(line);
