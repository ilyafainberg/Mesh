    {
        get
        {
            var current = new global::Mesh.Shared.DeviceInfo(Mesh.MyDeviceId, State.Profile.DeviceName, true, PlatformCaps.DevicePlatform, true);
            return new[] { current }.Concat(OtherEligibleDevices).ToList();
        }
    }
    bool ActiveDeviceOnline => Active is null || Active.ExecutionDeviceId is null
        || Active.ExecutionDeviceId == Mesh.MyDeviceId || IsDeviceOnline(Active.ExecutionDeviceId);
    bool ActiveUsesCurrentDevice => Active is null || Active.ExecutionDeviceId is null
        || Active.ExecutionDeviceId == Mesh.MyDeviceId;
    string ActiveDeviceStatus => Active is null ? "" : Active.ExecutionDeviceId is null
        ? "This device on next send"
        : $"{ThreadDeviceName(Active)} ({(ActiveDeviceOnline ? "online" : "offline")})";

    bool ShowPreview => !string.IsNullOrWhiteSpace(input) && Markdown.LooksLikeMarkdown(input);

    // The free model returns a friendly limit message when the daily token budget is spent.
    bool QuotaExhausted
    {
        get
        {
            if (State.Profile.Model.Provider != global::Mesh.App.Domain.ModelProvider.MeshHosted) return false;
            var last = Active?.Lines.LastOrDefault(l => l.Role == "assistant");
            return last is not null && last.Text.StartsWith("You've reached today's free-model limit", StringComparison.Ordinal);
        }
    }

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        Mesh.DeviceSyncStateChanged += Refresh;
        // Deep links take precedence, then local desktop history, then the existing recent-topic fallback.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var wanted = ParseQueryValue(uri.Query, "thread");
        var remembered = State.GetLastDesktopTopicId();
        if (!string.IsNullOrWhiteSpace(wanted) && State.Profile.OwnThreads.Any(t => t.Id == wanted))
            activeThread = wanted;
        else if (!string.IsNullOrWhiteSpace(remembered)
                 && State.Profile.OwnThreads.Any(t => t.Id == remembered))
            activeThread = remembered;
        else if (activeThread is null && State.Profile.OwnThreads.Count > 0)
            activeThread = State.Profile.OwnThreads[^1].Id;
        else if (!string.IsNullOrWhiteSpace(remembered))
            State.SetLastDesktopTopicId(null);

        if (activeThread is not null) State.MarkThreadSeen(activeThread);
    }

    protected override async Task OnInitializedAsync() => await LoadDevicesAsync();

    static string? ParseQueryValue(string queryString, string key)
    {
        if (string.IsNullOrEmpty(queryString)) return null;
        foreach (var pair in queryString.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0) continue;
            if (Uri.UnescapeDataString(pair[..eq]) == key) return Uri.UnescapeDataString(pair[(eq + 1)..]);
        }
        return null;
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            selfRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);

        // Wire each helper when its element actually exists. On mobile the list and composer are
        // mutually exclusive, so firstRender alone cannot initialize both.
        if (selfRef is not null)
        {
            if (!composerWired)
            {
                try
                {
                    await JS.InvokeVoidAsync("meshUI.composer", composerEl, selfRef, 5);
                    await JS.InvokeVoidAsync("meshPaste.attach", composerEl, selfRef);
                    composerWired = true;
                }
                catch { }
            }
        }

        try { await JS.InvokeVoidAsync("meshUI.autoScroll", scrollEl, scrollToLatestEl); } catch { }

        var scrollToLatest = scrollToLatestRequested;
        scrollToLatestRequested = false;
        if (preserveHistoryScroll)
        {
            preserveHistoryScroll = false;
            if (!scrollToLatest) return;
        }

        // Scroll on first paint, when a line is added, AND when the active thread's turn finishes
        // (busy true->false): the reply is added while the thread is still busy, so tracking that
        // transition guarantees the final answer scrolls into view even if its line count collides
        // with an earlier render.
        var count = Active?.Lines.Count ?? 0;
        var activeChanged = activeThread != lastScrolledThread;
        if (activeChanged)
        {
            try { await JS.InvokeVoidAsync("meshUI.resizeComposer", composerEl, 5); } catch { }
        }
        if (scrollToLatest || firstRender || activeChanged || count != lastCount || ActiveBusy != lastBusy || ActiveBusy)
        {
            lastCount = count;
            lastBusy = ActiveBusy;
            lastScrolledThread = activeThread;
            var method = scrollToLatest || firstRender || activeChanged
                ? "meshUI.scrollToBottom"
                : "meshUI.scrollToBottomIfPinned";
            try { await JS.InvokeVoidAsync(method, scrollEl); } catch { }
        }
    }

    async Task ScrollToLatest()
    {
        try { await JS.InvokeVoidAsync("meshUI.scrollToBottom", scrollEl); } catch { }
    }

    /// <summary>Invoked from JS when the user presses Enter (without Shift) in the composer.</summary>
    [Microsoft.JSInterop.JSInvokable]
    public Task SendFromComposer() => Send();

    /// <summary>
    /// Invoked from paste.js when a file is pasted into the composer. Writes the pasted bytes to a temp
    /// file and stages it so it sends by path (the same flow as the attach button), then re-renders.
    /// </summary>
    [Microsoft.JSInterop.JSInvokable]
    public Task OnPasteFile(string name, string mime, string base64)
    {
        attachError = null;
        var staged = PasteFiles.SaveTemp(name, mime, base64);
        if (staged is { } s)
        {
            LocalFiles.Allow(s.Path);
            attachments.Add(new StagedFile(s.Name, s.Path, s.Size));
        }
        else
        {
            attachError = "Could not read the pasted file.";
        }
        return InvokeAsync(StateHasChanged);
    }

    void ShowEarlierMessages()
    {
        messageRenderCount = MessageRenderWindow.NextCount(OrderedVisibleLines.Count, messageRenderCount);
        preserveHistoryScroll = true;
    }

    void Select(string id)
    {
        activeThread = id;
        confirmDelete = false;
        renaming = false;
        State.MarkThreadSeen(id);
    }

    void OnThreadKey(KeyboardEventArgs e, string id)
    {
        if (e.Key is "Enter" or " ") Select(id);
    }

    void OpenReport()
    {
        if (Active is null) return;
        reportDialog?.Show($"Me topic: {Active.Title}", Active.Lines,
            l => l.Role == "assistant" ? "agent" : "me", State.CurrentModelKey());
    }

    void NewLocalThread() => CreateThreadOn(CurrentDevice);

    void CreateThreadOn(ExecutionDevice device)
    {
        if (device.DeviceId != Mesh.MyDeviceId && !IsDeviceOnline(device.DeviceId)) return;
        var t = State.NewOwnThread("New chat", device);
        activeThread = t.Id;
        confirmDelete = false;
        renaming = false;
        input = "";
        createMenuOpen = false;
    }

    async Task LoadDevicesAsync()
    {
        loadingDevices = true;
        deviceError = null;
        try
        {
            eligibleDevices.Clear();
            eligibleDevices.AddRange(await TopicRouter.ListEligibleDevicesAsync(CancellationToken.None));
        }
        catch
        {
            deviceError = "Could not load linked devices. Check your connection and try again.";
        }
        finally
        {
            loadingDevices = false;
        }
    }

    async Task ToggleCreateMenu()
    {
        createMenuOpen = !createMenuOpen;
        moveMenuOpen = false;
        if (createMenuOpen) await LoadDevicesAsync();
    }

    async Task ToggleMoveMenu()
    {
        moveMenuOpen = !moveMenuOpen;
        createMenuOpen = false;
        if (moveMenuOpen) await LoadDevicesAsync();
    }

    async Task CloseCreateMenu()
    {
        createMenuOpen = false;
        await createMenuButton.FocusAsync();
    }

    async Task CloseMoveMenu()
    {
        moveMenuOpen = false;
        await moveMenuButton.FocusAsync();
    }

    async Task OnCreateMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseCreateMenu();
    }

    async Task OnMoveMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseMoveMenu();
    }

    void RequestMove(ExecutionDevice target)
    {
        moveMenuOpen = false;
        if (Active is null) return;
        if (ActiveBusy)
        {
            var runId = CurrentRunId(Active);
            if (string.IsNullOrWhiteSpace(runId))
            {
                dispatchError = "The active run could not be identified. Wait for it to finish before moving this topic.";
                return;
            }
            pendingMove = new PendingTopicMove(Active.Id, ThreadTitle(Active), runId, target);
            return;
        }
        MoveActiveTo(target);
    }

    async Task ConfirmActiveMove()
    {
        var target = pendingMove;
        pendingMove = null;
        if (target is null) return;
        if (!await TopicRouter.StopAsync(target.ThreadId, target.RunId, CancellationToken.None))
        {
            dispatchError = $"Could not stop {target.TopicTitle}. It was not moved.";
            return;
        }
        State.MoveOwnThreadToDevice(target.ThreadId, target.Target);
    }

    void MoveActiveTo(ExecutionDevice target)
    {
        if (Active is null) return;
        State.MoveOwnThreadToDevice(Active.Id, target);
    }

    void TogglePin(OwnThread thread) => State.SetOwnThreadPinned(thread.Id, !thread.IsPinned);
    static string ThreadRenderKey(OwnThread thread) => $"{(thread.IsPinned ? "pinned" : "recent")}:{thread.Id}";

    bool IsTopicBusy(OwnThread thread) => RemoteRunActivity.IsBusy(
        thread,
        State.IsThreadBusy(thread.Id),
        State.GetRemoteRunProjection(thread.Id),
        IsRemoteBound(thread),
        DateTimeOffset.UtcNow,
        UsesAuthoritativeState(thread));

    bool UsesAuthoritativeState(OwnThread thread) => RemoteRunActivity.UsesAuthoritativeState(
        Mesh.SupportsAuthoritativeTopicState,
        thread.ExecutionDeviceId,
        Mesh.MyDeviceId,
        eligibleDevices);

    bool IsRemoteBound(OwnThread thread) => !string.IsNullOrWhiteSpace(thread.ExecutionDeviceId)
        && thread.ExecutionDeviceId != Mesh.MyDeviceId;
    bool IsDeviceOnline(string? deviceId) => deviceId == Mesh.MyDeviceId
        || eligibleDevices.Any(d => d.DeviceId == deviceId && d.Online && d.CanHostRemoteTurn);
    string ThreadTitle(OwnThread thread) => string.IsNullOrWhiteSpace(thread.Title) ? "New chat" : thread.Title;
    string ThreadDeviceName(OwnThread thread) => !string.IsNullOrWhiteSpace(thread.ExecutionDeviceName)
        ? thread.ExecutionDeviceName : DeviceNameForId(thread.ExecutionDeviceId);
    string DeviceNameForId(string? id) => eligibleDevices.FirstOrDefault(d => d.DeviceId == id) is { } d
        ? DeviceName(d) : "Linked device";
    string DeviceStatusText(OwnThread thread) => $"{ThreadDeviceName(thread)} is {(IsDeviceOnline(thread.ExecutionDeviceId) ? "online" : "offline")}";
    static string DeviceName(global::Mesh.Shared.DeviceInfo device) => string.IsNullOrWhiteSpace(device.Name) ? "Linked device" : device.Name;
    static string DeviceName(ExecutionDevice device) => string.IsNullOrWhiteSpace(device.DeviceName) ? "Linked device" : device.DeviceName;
    static ExecutionDevice ToExecutionDevice(global::Mesh.Shared.DeviceInfo device) => new(device.DeviceId, device.Name, device.Platform);
    static string PlatformLabel(string? platform) => platform?.ToLowerInvariant() switch
    {
        global::Mesh.Shared.DevicePlatforms.Windows => "Windows",
        global::Mesh.Shared.DevicePlatforms.MacOS => "Mac",
        global::Mesh.Shared.DevicePlatforms.Android => "Android",
        global::Mesh.Shared.DevicePlatforms.IOS => "iPhone or iPad",
        _ => "Device"
    };
    static string PlatformIcon(string? platform) => platform?.ToLowerInvariant() switch
    {
        global::Mesh.Shared.DevicePlatforms.Windows => "bi-windows",
        global::Mesh.Shared.DevicePlatforms.MacOS => "bi-apple",
        global::Mesh.Shared.DevicePlatforms.Android => "bi-android2",
        global::Mesh.Shared.DevicePlatforms.IOS => "bi-phone",
        _ => "bi-device-ssd"
    };
    string? CurrentRunId(OwnThread thread) => State.GetRemoteRunProjection(thread.Id)?.RunId
        ?? State.AgentRunFor(thread.Id)?.RunId
        ?? thread.ExecutionRunId;
    static string RunItemClass(global::Mesh.Shared.TopicRunItemState state) => state.ToString().ToLowerInvariant();
    static string RunItemIcon(global::Mesh.Shared.TopicRunItemState state) => state switch
    {
        global::Mesh.Shared.TopicRunItemState.Running => "bi-arrow-repeat spin",
        global::Mesh.Shared.TopicRunItemState.Completed => "bi-check2",
        global::Mesh.Shared.TopicRunItemState.Failed => "bi-exclamation-triangle",
        global::Mesh.Shared.TopicRunItemState.Cancelled => "bi-x",
        _ => "bi-circle"
    };

    void BeginRename()
    {
        if (Active is null) return;
        renameText = Active.Title;
        renaming = true;
    }

    void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveRename();
        else if (e.Key == "Escape") renaming = false;
    }

    void SaveRename()
    {
        if (Active is not null) State.RenameOwnThread(Active.Id, renameText);
        renaming = false;
    }

    void ClearActive()
    {
        if (Active is not null) State.ClearOwnThread(Active.Id);
        messageRenderCount = MessageRenderWindow.InitialCount;
        confirmDelete = false;
    }

    void DeleteActive()
    {
        if (Active is null) return;
        var id = Active.Id;
        confirmDelete = false;
        State.DeleteOwnThread(id);
        activeThread = State.Profile.OwnThreads.Count > 0 ? State.Profile.OwnThreads[^1].Id : null;
    }

    void ToggleWidgetPicker() => widgetPickerOpen = !widgetPickerOpen;

    void CreateNewWidget()
    {
        widgetPickerOpen = false;
        selectedWidget = null;
        widgetMode = true;
    }

    void SelectWidget(Widget widget)
    {
        widgetPickerOpen = false;
        widgetMode = false;
        selectedWidget = widget;
    }

    void ClearWidgetMode()
    {
        widgetPickerOpen = false;
        widgetMode = false;
        selectedWidget = null;
    }

    async Task ResetComposer()
    {
        try { await JS.InvokeVoidAsync("meshUI.resetComposer", composerEl); } catch { }
    }

    bool ClearSubmittedDraft(string threadId, string submittedText)
    {
        if (!string.Equals(activeThread, threadId, StringComparison.Ordinal))
        {
            State.SetTopicDraft(threadId, "");
            return false;
        }
        if (!string.Equals(input, submittedText, StringComparison.Ordinal)) return false;
        input = "";
        return true;
    }

    async Task PickFile()
    {
        attachError = null;
        try
        {
            await JS.InvokeVoidAsync("meshUI.prepareForNativePicker", composerEl);
            var file = await Microsoft.Maui.Storage.FilePicker.Default.PickAsync();
            if (file is null) return;
            await using var stream = await file.OpenReadAsync();
            var staged = await PickedFileStager.StageAsync(file.FileName, file.ContentType, stream);
            LocalFiles.Allow(staged.Path);
            attachments.Add(new StagedFile(staged.Name, staged.Path, staged.Size));
        }
        catch (Exception ex) { attachError = "Couldn't attach that file: " + ex.Message; }
    }

    static string Human(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }

    async Task StopActive()
    {
        if (Active is null) return;
        var thread = Active;
        var runId = CurrentRunId(thread);
        if (string.IsNullOrWhiteSpace(runId)) return;
        var stopped = await TopicRouter.StopAsync(thread.Id, runId, CancellationToken.None);
        // No live run to cancel (a stranded run id from a completed or lost remote run): reconcile
        // locally so the phantom "thinking" indicator and Stop button clear immediately.
        if (!stopped && State.GetRemoteRunProjection(thread.Id) is null && IsRemoteBound(thread))
            State.ClearRemoteRunProjection(thread.Id, runId);
    }

    async Task Send()
    {
        if (SendDisabled) return;
        dispatchError = null;
        var text = input;
        var thread = Active ?? State.NewOwnThread("New chat", CurrentDevice);
        activeThread = thread.Id;
        input = text;
        if (thread.ExecutionDeviceId is null)
            State.BindOwnThreadForSend(thread.Id, CurrentDevice);

        var chosenWidget = selectedWidget;
        var titleText = !string.IsNullOrWhiteSpace(text)
            ? text
            : chosenWidget is not null ? $"Use widget: {chosenWidget.Name}" : "";
        if (string.Equals(thread.Title, "New chat", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(titleText))
            State.RenameOwnThread(thread.Id, Titleize(titleText));

        var files = attachments.ToList();
        var wasWidget = widgetMode;
        List<ChatAttachment> turnAttachments;
        try
        {
            turnAttachments = await LoadAttachmentsAsync(files, CancellationToken.None);
        }
        catch (Exception ex)
        {
            dispatchError = ex.Message;
            return;
        }

        var prompt = BuildTurnPrompt(text, chosenWidget, wasWidget);
        var trigger = new ChatLine
        {
            Id = Guid.NewGuid().ToString("n"),
            Role = "user",
            Text = prompt,
            Attachments = turnAttachments,
            At = DateTimeOffset.UtcNow
        };
        var runId = Guid.NewGuid().ToString("n");
        scrollToLatestRequested = true;
        State.AddOwnChatLine(thread.Id, trigger);

        var clearedVisibleDraft = ClearSubmittedDraft(thread.Id, text);
        attachments.Clear();
        widgetMode = false;
        widgetPickerOpen = false;
        selectedWidget = null;
        if (clearedVisibleDraft) _ = ResetComposer();

        var widgetContext = BuildWidgetContext(chosenWidget, wasWidget, text);
        var draft = new TopicTurnDraft(
            runId,
            thread.Id,
            trigger.Id,
            State.Profile.Handle,
            prompt,
            trigger.At,
            global::Mesh.Shared.TopicTurnMode.Single,
            thread.ExecutionDeviceId,
            chosenWidget?.Id,
            widgetContext,
            turnAttachments);

        // Let the persisted prompt paint before dispatch can reclassify it as queued.
        await Task.Yield();
        try
        {
            var result = await TopicRouter.SubmitAsync(draft, null, CancellationToken.None);
            if (!result.Accepted)
            {
                dispatchError = result.Error ?? DispatchFailure(result.Code);
                State.AddOwnChatLine(thread.Id, new ChatLine
                {
                    Role = "assistant",
                    Text = $"[{dispatchError}]",
                    ReplyToLineId = trigger.Id
                });
            }
        }
        catch (Exception ex)
        {
            dispatchError = $"Could not submit this turn: {ex.Message}";
            State.AddOwnChatLine(thread.Id, new ChatLine
            {
                Role = "assistant",
                Text = $"[{dispatchError}]",
                ReplyToLineId = trigger.Id
            });
        }
    }

    static string BuildTurnPrompt(string text, Widget? widget, bool buildWidget)
        => buildWidget ? $"Build a widget: {text}"
            : widget is null ? text
            : string.IsNullOrWhiteSpace(text) ? $"Use widget: {widget.Name}"
            : $"Update widget {widget.Name}: {text}";

    static string? BuildWidgetContext(Widget? widget, bool buildWidget, string request)
    {
        if (!buildWidget && widget is null) return null;
        return System.Text.Json.JsonSerializer.Serialize(new
        {
            operation = buildWidget ? "build" : string.IsNullOrWhiteSpace(request) ? "use" : "refine",
            widgetId = widget?.Id,
            name = widget?.Name,
            canonicalPrompt = widget?.Prompt,
            html = widget?.Html,
            request
        });
    }

    static string DispatchFailure(string code) => code.ToLowerInvariant() switch
    {
        "offline" or "target-offline" or "target_offline" => "The assigned device is offline.",
        "not-connected" or "not_connected" or "unreachable" => "Could not reach the assigned device.",
        "busy" or "queued" => "This turn could not be queued.",
        _ => "The assigned device rejected this turn."
    };

    private static readonly Dictionary<string, string> AttachmentMimes = new(StringComparer.OrdinalIgnoreCase)
    {
        [".png"] = "image/png", [".jpg"] = "image/jpeg", [".jpeg"] = "image/jpeg",
        [".gif"] = "image/gif", [".webp"] = "image/webp", [".bmp"] = "image/bmp",
        [".pdf"] = "application/pdf", [".txt"] = "text/plain", [".md"] = "text/markdown",
        [".json"] = "application/json", [".csv"] = "text/csv", [".xml"] = "application/xml"
    };

    static async Task<List<ChatAttachment>> LoadAttachmentsAsync(List<StagedFile> files, CancellationToken ct)
    {
        var result = new List<ChatAttachment>();
        foreach (var file in files)
        {
            if (file.Size > PickedFileStager.MaxAttachmentBytes) throw new InvalidOperationException($"{file.Name} is larger than the 20 MB attachment limit.");
            var mime = AttachmentMimes.GetValueOrDefault(System.IO.Path.GetExtension(file.Path), "application/octet-stream");
            var bytes = await System.IO.File.ReadAllBytesAsync(file.Path, ct);
            result.Add(new ChatAttachment(file.Name, mime, bytes));
        }
        return result;
    }

    // A short title from the first message of a new chat.
    static string Titleize(string text)
    {
        var clean = text.Replace("\r", " ").Replace("\n", " ").Trim();
        if (clean.Length == 0) return "New chat";
        return clean.Length > 40 ? clean[..40].TrimEnd() + "…" : clean;
    }

    void PinWidget(string html, ChatLine line)
    {
        pinHtml = html;
        pinName = "";
        pinPrompt = line.WidgetPrompt;
        pinError = null;
    }

    void OnPinKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(pinName)) ConfirmPin();
    }

    void ConfirmPin()
    {
        if (pinHtml is null || string.IsNullOrWhiteSpace(pinName)) return;
        var name = pinName.Trim();
        if (State.Profile.Widgets.Any(w => string.Equals(w.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            pinError = $"A widget named \"{name}\" already exists. Choose a different name.";
            return;
        }
        State.Mutate(p => p.Widgets.Add(new Widget
        {
            Name = name,
            Html = pinHtml!,
            Prompt = pinPrompt ?? "Pinned from conversation",
            Visibility = "private",
            ModifiedAt = DateTimeOffset.UtcNow,
        }));
        pinHtml = null;
        pinName = "";
        pinPrompt = null;
        pinError = null;
    }

    public void Dispose()
    {
        State.Changed -= Refresh;
        Mesh.DeviceSyncStateChanged -= Refresh;
        selfRef?.Dispose();
    }
}
