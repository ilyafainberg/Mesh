@page "/"
@inject AppState State
@inject AppShutdownCoordinator Shutdown
@inject AgentService Agent
@inject ITopicExecutionRouter TopicRouter
@inject MeshClient Mesh
@inject LocalFileRegistry LocalFiles
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject NotificationViewState NotificationViews
@implements IDisposable

<MobileOverlayScope Active="@(createMenuOpen || moveMenuOpen)" />

<div class="split">
    <div class="conv-list">
        <div class="new-conv create-topic-row">
            <h2><i class="bi bi-person-badge"></i> Me</h2>
            <div class="split-create">
                <button class="primary new-chat-primary" @onclick="NewLocalThread" disabled="@(eligibleDevices.Count == 0)"
                        aria-label="Start new assistant chat"
                        title="@(eligibleDevices.Count > 0 ? "New assistant chat" : "Bring an agent device online")">
                    <i class="bi bi-plus-lg"></i> New chat
                </button>
                <button class="primary new-chat-chevron" @ref="createMenuButton" @onclick="ToggleCreateMenu"
                        aria-label="Choose device for new chat" aria-haspopup="menu"
                        aria-expanded="@createMenuOpen" aria-controls="new-chat-device-menu">
                    <i class="bi bi-chevron-down"></i>
                </button>
                @if (createMenuOpen)
                {
                    <MobileOverlayScope />
                    <button class="menu-scrim" tabindex="-1" aria-hidden="true" @onclick="CloseCreateMenu"></button>
                    <div id="new-chat-device-menu" class="device-menu" role="menu" aria-label="Choose device for new chat" @onkeydown="OnCreateMenuKey">
                        <div class="device-menu-title">Start a topic</div>
                        @if (loadingDevices)
                        {
                            <div class="device-menu-state"><i class="bi bi-hourglass-split"></i> Loading devices...</div>
                        }
                        else
                        {
                            @foreach (var device in eligibleDevices)
                            {
                                <button class="device-menu-item" role="menuitem"
                                        @onclick="() => CreateThreadOn(ToAgentExecutionHost(device))">
                                    <i class="bi @PlatformIcon(device.Platform)"></i>
                                    <span><b>@(device.DeviceId == Mesh.MyDeviceId ? "This device" : DeviceName(device))</b><small>@PlatformLabel(device.Platform)</small></span>
                                    <span class="device-state online">online · agent ready</span>
                                </button>
                            }
                            @if (eligibleDevices.Count == 0)
                            {
                                <div class="device-menu-state">Bring an agent device online to start a chat.</div>
                            }
                        }
                        @if (deviceError is not null)
                        {
                            <div class="device-menu-error" role="alert">@deviceError</div>
                        }
                    </div>
                }
            </div>
            <span class="muted topic-list-subtitle">your private topic chats</span>
        </div>
        <div class="topic-list-scroll">
            <div class="thread-groups">
                @if (PinnedThreads.Count > 0)
                {
                    <div class="thread-group-label"><i class="bi bi-pin-angle-fill"></i> Pinned</div>
                    @foreach (var t in PinnedThreads)
                    {
                        <div class="topic-row @(t.Id == activeThread ? "active" : "")" @key="ThreadRenderKey(t)">
                            <button class="topic-open" aria-label="Open @(ThreadTitle(t))"
                                    @onclick="() => Select(t.Id)" @onkeydown="e => OnThreadKey(e, t.Id)">
                                <span class="topic-title-line">
                                    <span class="conv-name">@(string.IsNullOrWhiteSpace(t.Title) ? "New chat" : t.Title)</span>
                                    @if (IsRemoteBound(t))
                                    {
                                        <span class="topic-device-pill @(!IsDeviceOnline(t.AgentExecutionHostDeviceId) ? "offline" : "")"
                                              title="@DeviceStatusText(t)">
                                            <i class="bi @PlatformIcon(t.AgentExecutionHostDevicePlatform)"></i>
                                            <span class="topic-device-name">@ThreadDeviceName(t)</span>
                                        </span>
                                    }
                                </span>
                                @if (IsTopicBusy(t))
                                {
                                    <span class="topic-busy-indicator" title="Agent is working" aria-label="Agent is working">
                                        <i class="bi bi-arrow-repeat spin" aria-hidden="true"></i>
                                    </span>
                                }
                                else if (State.IsThreadCompleted(t.Id))
                                {
                                    <span class="topic-unread" title="Agent finished" aria-label="Agent finished"></span>
                                }
                            </button>
                            <button class="thread-pin" title="Unpin topic" aria-label="Unpin @(ThreadTitle(t))" @onclick:stopPropagation="true" @onclick="() => TogglePin(t)">
                                <i class="bi bi-pin-angle-fill"></i>
                            </button>
                        </div>
                    }
                }
                @if (RecentThreads.Count > 0)
                {
                    <div class="thread-group-label"><i class="bi bi-clock-history"></i> Recent</div>
                    @foreach (var t in RecentThreads)
                    {
                        <div class="topic-row @(t.Id == activeThread ? "active" : "")" @key="ThreadRenderKey(t)">
                            <button class="topic-open" aria-label="Open @(ThreadTitle(t))"
                                    @onclick="() => Select(t.Id)" @onkeydown="e => OnThreadKey(e, t.Id)">
                                <span class="topic-title-line">
                                    <span class="conv-name">@(string.IsNullOrWhiteSpace(t.Title) ? "New chat" : t.Title)</span>
                                    @if (IsRemoteBound(t))
                                    {
                                        <span class="topic-device-pill @(!IsDeviceOnline(t.AgentExecutionHostDeviceId) ? "offline" : "")"
                                              title="@DeviceStatusText(t)">
                                            <i class="bi @PlatformIcon(t.AgentExecutionHostDevicePlatform)"></i>
                                            <span class="topic-device-name">@ThreadDeviceName(t)</span>
                                        </span>
                                    }
                                </span>
                                @if (IsTopicBusy(t))
                                {
                                    <span class="topic-busy-indicator" title="Agent is working" aria-label="Agent is working">
                                        <i class="bi bi-arrow-repeat spin" aria-hidden="true"></i>
                                    </span>
                                }
                                else if (State.IsThreadCompleted(t.Id))
                                {
                                    <span class="topic-unread" title="Agent finished" aria-label="Agent finished"></span>
                                }
                            </button>
                            <button class="thread-pin unpinned" title="Pin topic" aria-label="Pin @(ThreadTitle(t))" @onclick:stopPropagation="true" @onclick="() => TogglePin(t)">
                                <i class="bi bi-pin-angle"></i>
                            </button>
                        </div>
                    }
                }
            </div>
            @if (State.Profile.OwnThreads.Count == 0)
            {
                <div class="empty conv-empty">No chats yet. Start one with the + above, or just type below.</div>
            }
        </div>
    </div>

    <div class="thread">
        <header class="pane-head">
            @if (renaming && Active is not null)
            {
                <input class="rename-input" @bind="renameText" @bind:event="oninput" @onkeydown="OnRenameKey" aria-label="Chat title" />
                <button class="icon-btn" title="Save" @onclick="SaveRename" aria-label="Save title"><i class="bi bi-check-lg"></i></button>
                <button class="icon-btn" title="Cancel" @onclick="() => renaming = false" aria-label="Cancel rename"><i class="bi bi-x-lg"></i></button>
            }
            else
            {
                <h2>@(Active is null ? "Me" : (string.IsNullOrWhiteSpace(Active.Title) ? "New chat" : Active.Title))</h2>
                @if (Active is not null && IsRemoteBound(Active))
                {
                    <span class="topic-header-device @(!ActiveDeviceOnline ? "offline" : "")" title="@ActiveDeviceStatus">
                        <i class="bi @PlatformIcon(Active.AgentExecutionHostDevicePlatform ?? CurrentDevice.Platform)"></i>
                        AI host: @ActiveDeviceStatus
                    </span>
                }
            }
            <span style="margin-left:auto; display:flex; align-items:center; gap:6px;">
                <TokenMeter Compact="true" />
                @if (Active is not null && !renaming)
                {
                    <div class="header-device-actions">
                        <button class="ghost move-topic-button" title="Move topic to another agent device" aria-label="Move topic to"
                                aria-haspopup="menu" aria-expanded="@moveMenuOpen" aria-controls="move-topic-device-menu"
                                @ref="moveMenuButton" @onclick="ToggleMoveMenu"><i class="bi bi-cpu"></i> Move topic to</button>
                        @if (moveMenuOpen)
                        {
                            <MobileOverlayScope />
                            <button class="menu-scrim" tabindex="-1" aria-hidden="true" @onclick="CloseMoveMenu"></button>
                            <div id="move-topic-device-menu" class="device-menu header-device-menu" role="menu" aria-label="Move topic to" @onkeydown="OnMoveMenuKey">
                                <div class="device-menu-title">Choose execution host</div>
                                @if (loadingDevices)
                                {
                                    <div class="device-menu-state">Loading devices...</div>
                                }
                                else
                                {
                                    @foreach (var device in eligibleDevices)
                                    {
                                        var selected = Active.AgentExecutionHostDeviceId == device.DeviceId
                                            || Active.AgentExecutionHostDeviceId is null && device.DeviceId == Mesh.MyDeviceId;
                                        <button class="device-menu-item" role="menuitem" disabled="@selected"
                                                aria-label="@($"Move topic to {DeviceName(device)}")"
                                                @onclick="() => RequestMove(ToAgentExecutionHost(device))">
                                            <i class="bi @PlatformIcon(device.Platform)"></i>
                                            <span><b>@(device.DeviceId == Mesh.MyDeviceId ? "This device" : DeviceName(device))</b><small>@(selected ? "assigned" : PlatformLabel(device.Platform))</small></span>
                                            <span class="device-state @(device.Online ? "online" : "offline")">@DeviceAvailability(device)</span>
                                        </button>
                                    }
                                }
                                @if (deviceError is not null)
                                {
                                    <div class="device-menu-error" role="alert">@deviceError</div>
                                }
                            </div>
                        }
                    </div>
                    <button class="ghost icon-btn" title="@(Active.IsPinned ? "Unpin topic" : "Pin topic")"
                            aria-label="@(Active.IsPinned ? "Unpin topic" : "Pin topic")" @onclick="() => TogglePin(Active)">
                        <i class="bi @(Active.IsPinned ? "bi-pin-angle-fill" : "bi-pin-angle")"></i>
                    </button>
                    <button class="ghost icon-btn" title="Rename chat" aria-label="Rename chat" @onclick="BeginRename"><i class="bi bi-pencil"></i></button>
                    @if (confirmDelete)
                    {
                        <button class="ghost icon-btn" title="Clear messages, keep the chat" @onclick="ClearActive">Clear</button>
                        <button class="danger" title="Delete this chat and its history" @onclick="DeleteActive">Delete</button>
                        <button class="ghost icon-btn" title="Cancel" @onclick="() => confirmDelete = false" aria-label="Cancel"><i class="bi bi-x-lg"></i></button>
                    }
                    else
                    {
                        <button class="ghost icon-btn" title="Report AI content" aria-label="Report AI content" @onclick="OpenReport"><i class="bi bi-flag"></i></button>
                        <button class="ghost icon-btn" title="Delete chat" aria-label="Delete chat" @onclick="() => confirmDelete = true"><i class="bi bi-trash"></i></button>
                    }
                }
            </span>
        </header>
        @if (pendingMove is not null)
        {
            <div class="move-confirm" role="alertdialog" aria-label="Confirm moving active topic">
                <span>@pendingMove.TopicTitle has an active run. Stop it and move the topic to @DeviceName(pendingMove.Target)? History stays with the topic.</span>
                <button class="primary" @onclick="ConfirmActiveMove">Stop and move</button>
                <button class="ghost" @onclick="() => pendingMove = null">Cancel</button>
            </div>
        }

        <div class="messages-frame">
            <div class="messages" @ref="scrollEl">
                <div class="messages-wrap">
                @{
                    var allVisibleLines = OrderedVisibleLines;
                    var renderedLines = MessageRenderWindow.Latest(allVisibleLines, messageRenderCount);
                    var hiddenMessageCount = MessageRenderWindow.HiddenCount(allVisibleLines.Count, messageRenderCount);
                    var transcriptItems = TopicTranscriptPresentation.Compose(
                        renderedLines, IsQueued, ActiveBusy ? Active?.Id : null);
                }
                @if (hiddenMessageCount > 0)
                {
                    <div class="message-history-more">
                        <button type="button" class="ghost" @onclick="ShowEarlierMessages">
                            <i class="bi bi-clock-history"></i> Show @MessageRenderWindow.NextPageSize(allVisibleLines.Count, messageRenderCount) earlier messages
                        </button>
                    </div>
                }
                @if (Active is null || Active.Lines.Count == 0)
                {
                    <div class="empty">
                        This is your private assistant. It knows everything in your Knowledge and Skills,
                        and helps you manage what your public agent shares with others. Ask it anything.
                    </div>
                }
                @if (Active is not null)
                {
                    @foreach (var item in transcriptItems)
                    {
                        if (item.Line is { } line)
                        {
                            var queued = IsQueued(line);
                            <div class="bubble @TopicTranscriptPresentation.BubbleRole(line)" @key="item.Key">
                                @if (!queued)
                                {
                                    <ModelAttribution ModelId="@line.ModelId" />
                                    @if (!string.IsNullOrEmpty(line.Reasoning))
                                    {
                                        <button class="reasoning-toggle" @onclick="() => ToggleReasoning(line)" aria-label="Show reasoning">
                                            <i class="bi bi-lightbulb"></i>
                                            <span>Reasoning</span>
                                            <i class="bi @(expandedReasoning.Contains(line) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        </button>
                                        @if (expandedReasoning.Contains(line))
                                        {
                                            <div class="reasoning-body">@((MarkupString)Markdown.ToHtml(line.Reasoning!))</div>
                                        }
                                    }
                                }
                                <MessageActions Markdown="@line.Text" IsMobile="false" IsInternal="@line.Internal">
                                    <MessageContent Text="@line.Text" Attachments="@line.Attachments"
                                                    OnPin="html => PinWidget(html, line)" />
                                </MessageActions>
                                @if (queued)
                                {
                                    <div class="msg-tag queue-tag">
                                        <i class="bi @QueueIcon(line)"></i>
                                        <span>@QueueLabel(line)</span>
                                        <button type="button" class="queue-cancel" title="Cancel queued turn"
                                                aria-label="Cancel queued turn" @onclick="() => CancelQueued(line)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bubble assistant" @key="item.Key">
                                @{
                                    var remote = Active is null ? null : RemoteRunPresentation.VisibleProjection(
                                        State.GetRemoteRunProjection(Active.Id),
                                        State.IsThreadBusy(Active.Id));
                                }
                                @if (remote is not null)
                                {
                                    @if (!string.IsNullOrWhiteSpace(remote.Plan))
                                    {
                                        <div class="text md">@((MarkupString)Markdown.ToHtml(remote.Plan))</div>
                                    }
                                    @if (remote.Subtasks is { Count: > 0 })
                                    {
                                        <div class="agent-steps">
                                            @foreach (var task in remote.Subtasks)
                                            {
                                                <div class="agent-step @RunItemClass(task.State)">
                                                    <i class="bi @RunItemIcon(task.State)"></i><span>@task.Title</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="planning-row">
                                        <i class="bi bi-arrow-repeat spin"></i>
                                        @RemoteRunPresentation.StatusLabel(remote)
                                    </div>
                                    @if (remote.Steps is { Count: > 0 })
                                    {
                                        <div class="agent-steps">
                                            @foreach (var step in remote.Steps)
                                            {
                                                <div class="agent-step-item">
                                                    <div class="agent-step @RunItemClass(step.State)">
                                                        <i class="bi @RunItemIcon(step.State)"></i><span>@step.Label</span>
                                                    </div>
                                                    @if (showStepDetails && (!string.IsNullOrEmpty(step.Arguments) || !string.IsNullOrEmpty(step.Result)))
                                                    {
                                                        <div class="agent-step-detail">
                                                            @if (!string.IsNullOrEmpty(step.Arguments))
                                                            {
                                                                <ToolStepDetail Tool="@(step.ToolName ?? step.Tool)"
                                                                                Content="@step.Arguments" />
                                                            }
                                                            @if (!string.IsNullOrEmpty(step.Result))
                                                            {
                                                                <ToolStepDetail Tool="@(step.ToolName ?? step.Tool)"
                                                                                Content="@step.Result" IsOutput="true" />
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <button class="step-details-toggle" @onclick="() => showStepDetails = !showStepDetails">
                                            <i class="bi @(showStepDetails ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                            @(showStepDetails ? "Hide details" : "Show details")
                                        </button>
                                    }
                                    @if (remote.Queued > 0)
                                    {
                                        <div class="msg-tag"><i class="bi bi-hourglass-split"></i> queued @remote.Queued</div>
                                    }
                                }
                                @{ var run = remote is null && Active is not null ? State.AgentRunFor(Active.Id) : null; }
                                @if (run is not null)
                                {
                                    @if (run.Phase == AgentRunPhase.Planning)
                                    {
                                        <div class="planning-row"><i class="bi bi-diagram-3"></i> Planning</div>
                                    }
                                    else
                                    {
                                        <div class="text md">@((MarkupString)Markdown.ToHtml(run.Plan))</div>
                                        <div class="msg-tag"><i class="bi bi-diagram-3"></i> @run.Phase.ToString().ToLowerInvariant()</div>
                                    }
                                }
                                @{ var steps = Active is null ? null : State.AgentStepsFor(Active.Id); }
                                @if (steps is { Count: > 0 })
                                {
                                    <div class="agent-steps">
                                        @foreach (var s in steps)
                                        {
                                            <div class="agent-step-item">
                                                <div class="agent-step @s.State.ToString().ToLowerInvariant()">
                                                    <i class="bi @StepIcon(s.State)"></i>
                                                    <span>@s.Label</span>
                                                </div>
                                                @if (showStepDetails && (!string.IsNullOrEmpty(s.Arguments) || !string.IsNullOrEmpty(s.Result)))
                                                {
                                                    <div class="agent-step-detail">
                                                        @if (!string.IsNullOrEmpty(s.Arguments))
                                                        {
                                                            <ToolStepDetail Tool="@(s.ToolName ?? s.Tool)"
                                                                            Content="@s.Arguments" />
                                                        }
                                                        @if (!string.IsNullOrEmpty(s.Result))
                                                        {
                                                            <ToolStepDetail Tool="@(s.ToolName ?? s.Tool)"
                                                                            Content="@s.Result" IsOutput="true" />
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <button class="step-details-toggle" @onclick="() => showStepDetails = !showStepDetails">
                                        <i class="bi @(showStepDetails ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        @(showStepDetails ? "Hide details" : "Show details")
                                    </button>
                                }
                                @{ var draft = Active is null ? null : State.AssistantDraftFor(Active.Id); }
                                @if (draft is { HasReasoning: true })
                                {
                                    <button class="reasoning-toggle" @onclick="ToggleDraftReasoning" aria-label="Show reasoning">
                                        <i class="bi bi-lightbulb"></i>
                                        <span>Reasoning</span>
                                        <i class="bi @(draftReasoningExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    </button>
                                    @if (draftReasoningExpanded)
                                    {
                                        <div class="reasoning-body">@((MarkupString)Markdown.ToHtml(draft.Reasoning))</div>
                                    }
                                }
                                @if (draft is { HasAnswer: true })
                                {
                                    <div class="text md">@((MarkupString)Markdown.ToHtml(draft.Answer))</div>
                                }
                                @if (remote is null && run?.Phase != AgentRunPhase.Planning
                                     && (draft is null or { HasReasoning: false, HasAnswer: false }))
                                {
                                    <div class="text muted">@(ActiveBuilding ? "…building widget" : "…thinking")</div>
                                }
                            </div>
                        }
                    }
                }
                @if (Active is not null)
                {
                    @foreach (var bubble in State.AskUserPromptsFor(Active.Id))
                    {
                        <AskUserBubble Bubble="@bubble"
                                       IsResolving="@askResolving.Contains(bubble.PromptId)"
                                       IsFocused="@(bubble.PromptId == State.FocusedAskUserPromptId)"
                                       OnSelect="optionId => ResolveAskAsync(bubble.PromptId, optionId)" />
                    }
                }
                </div>
            </div>
            <button type="button" class="scroll-to-latest" @ref="scrollToLatestEl" hidden aria-hidden="true"
                    title="Jump to latest message" aria-label="Jump to latest message" @onclick="ScrollToLatest">
                <i class="bi bi-arrow-down"></i>
            </button>
        </div>

        <div class="composer-area">
            <div class="composer-inner">
                @if (pinHtml is not null)
                {
                    <div class="pin-bar">
                        <i class="bi bi-pin-angle"></i>
                        <input @bind="pinName" placeholder="Name this widget…" @onkeydown="OnPinKey" aria-label="Name this widget" />
                        <button class="primary" @onclick="ConfirmPin" disabled="@string.IsNullOrWhiteSpace(pinName)">Pin</button>
                        <button class="ghost icon-btn" @onclick="() => { pinHtml = null; pinError = null; }" title="Cancel" aria-label="Cancel"><i class="bi bi-x-lg"></i></button>
                    </div>
                    @if (pinError is not null) { <p class="err-text" role="alert">@pinError</p> }
                }
                @if (widgetMode)
                {
                    <div class="mode-chip">
                        <i class="bi bi-window-stack"></i> widget
                        <button class="chip-x" @onclick="ClearWidgetMode" title="Cancel widget" aria-label="Cancel widget"><i class="bi bi-x"></i></button>
                        <span class="mode-hint">describe the mini-app you want</span>
                    </div>
                }
                else if (selectedWidget is not null)
                {
                    <div class="mode-chip selected-widget-chip">
                        <i class="bi bi-window-stack"></i>
                        <span class="widget-chip-name">@selectedWidget.Name</span>
                        <button class="chip-x" @onclick="ClearWidgetMode" title="Remove widget" aria-label="Remove selected widget"><i class="bi bi-x"></i></button>
                        @if (widgetLoading)
                        {
                            <span class="mode-hint">loading widget…</span>
                        }
                        else if (widgetLoadError is not null)
                        {
                            <span class="mode-hint err-text" role="alert">@widgetLoadError</span>
                        }
                        else
                        {
                            <span class="mode-hint">send to use, or describe changes</span>
                        }
                    </div>
                }
                @if (attachments.Count > 0)
                {
                    <div class="attach-bar">
                        @foreach (var a in attachments)
                        {
                            <span class="attach-chip">
                                <i class="bi bi-paperclip"></i>
                                <span class="attach-name">@a.Name</span>
                                <span class="attach-size">@a.SizeLabel</span>
                                <button class="chip-x" @onclick="() => attachments.Remove(a)" title="Remove" aria-label="Remove attachment"><i class="bi bi-x"></i></button>
                            </span>
                        }
                    </div>
                }
                <div class="composer">
                    <div class="widget-picker-anchor">
                        <button class="ghost icon-btn plus-btn @(widgetMode || selectedWidget is not null || widgetPickerOpen ? "on" : "")"
                                @onclick="ToggleWidgetPicker" disabled="@ActiveBusy" title="Create or choose a widget"
                                aria-label="Create or choose a widget" aria-haspopup="menu" aria-expanded="@widgetPickerOpen"
                                aria-controls="home-widget-picker">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        @if (widgetPickerOpen)
                        {
                            <div id="home-widget-picker" class="widget-picker" role="menu" aria-label="Choose a widget">
                                <button class="widget-picker-item widget-picker-create" role="menuitem" @onclick="CreateNewWidget">
                                    <i class="bi bi-magic"></i>
                                    <span>Create new widget</span>
                                </button>
                                <div class="widget-picker-separator" role="separator"></div>
                                @if (State.Profile.Widgets.Count == 0)
                                {
                                    <div class="widget-picker-empty">No saved widgets yet</div>
                                }
                                else
                                {
                                    <div class="widget-picker-list">
                                        @foreach (var widget in State.Profile.Widgets)
                                        {
                                            <button class="widget-picker-item" role="menuitem" @onclick="() => SelectWidget(widget)" @key="widget.Id">
                                                <i class="bi bi-window-stack"></i>
                                                <span>@widget.Name</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <button class="ghost icon-btn plus-btn" @onclick="PickFile" disabled="@ActiveBusy" title="Attach an image or document" aria-label="Attach an image or document">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    <textarea @ref="composerEl" @bind="input" @bind:event="oninput" rows="1" class="composer-input"
                              placeholder="@ComposerPlaceholder" aria-label="@ComposerAriaLabel"></textarea>
                    <button class="primary send-btn" @onclick="PrimaryComposerAction" disabled="@SendDisabled"
                            title="@PrimaryActionTitle" aria-label="@PrimaryActionLabel">
                        <i class="bi bi-send"></i>
                    </button>
                    @if (ShowStopAction)
                    {
                        <button class="primary send-btn stop-btn" @onclick="StopActive" title="Stop current run" aria-label="Stop current run">
                            <i class="bi bi-stop-fill"></i>
                        </button>
                    }
                </div>
                @if (attachError is not null) { <p class="err-text">@attachError</p> }
                @if (VisibleDispatchError is not null)
                {
                    <p class="err-text" role="alert">
                        @VisibleDispatchError
                        @if (pendingAiRetry is not null)
                        {
                            <button class="link-btn" @onclick="RetryPendingAiResponse">Retry AI response</button>
                            <button class="link-btn" @onclick="ToggleMoveMenu">Change AI host</button>
                        }
                    </p>
                }
                @if (DraftError is not null)
                {
                    <p class="err-text" role="alert">
                        @DraftError <button class="link-btn" @onclick="RetryDraft">Retry save</button>
                    </p>
                }
                @if (Active is not null && !ActiveExecutionEligible)
                {
                    <div class="warn-banner"><i class="bi bi-exclamation-triangle"></i> Bring an agent device online or move this topic to an online agent-ready Desktop.</div>
                }
                @if (ActiveUsesCurrentDevice && !Agent.IsModelReady)
                {
                    <div class="warn-banner"><i class="bi bi-exclamation-triangle"></i> No model configured. Go to <a href="settings">Settings</a>.</div>
                }
                else if (ActiveUsesCurrentDevice && QuotaExhausted)
                {
                    <div class="warn-banner">
                        <i class="bi bi-hourglass-bottom"></i>
                        Today's free-model limit is reached. <a href="settings">Add your own model key</a> for unlimited use, or switch to an on-device model.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<ReportDialog @ref="reportDialog" />

@code {
