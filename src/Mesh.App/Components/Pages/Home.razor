    ExecutionDevice CurrentDevice => new(Mesh.MyDeviceId, State.Profile.DeviceName, PlatformCaps.DevicePlatform);
    IReadOnlyList<global::Mesh.Shared.DeviceInfo> OtherEligibleDevices => eligibleDevices
        .Where(d => d.CanHostRemoteTurn && d.DeviceId != Mesh.MyDeviceId)
