    {
        public string SizeLabel => Human(Size);
    }

    IReadOnlyList<OwnThread> Threads => State.OrderedOwnThreads;
    IReadOnlyList<OwnThread> PinnedThreads => Threads.Where(t => t.IsPinned).ToList();
    IReadOnlyList<OwnThread> RecentThreads => Threads.Where(t => !t.IsPinned).ToList();
    OwnThread? Active => activeThread is null ? null : State.Profile.OwnThreads.FirstOrDefault(t => t.Id == activeThread);
    AgentExecutionHost CurrentDevice => CurrentRosterDevice is { } current
        ? ToAgentExecutionHost(current)
        : new(Mesh.MyDeviceId, State.Profile.DeviceName, PlatformCaps.DevicePlatform);
    bool ActiveDeviceOnline => Active is null || Active.AgentExecutionHostDeviceId is null
        || IsDeviceOnline(Active.AgentExecutionHostDeviceId);
    bool ActiveUsesCurrentDevice => Active is null || Active.AgentExecutionHostDeviceId is null
        || Active.AgentExecutionHostDeviceId == Mesh.MyDeviceId;
    string ActiveDeviceStatus => Active is null ? "" : Active.AgentExecutionHostDeviceId is null
        ? $"This device ({DeviceAvailability(CurrentRosterDevice)})"
        : DeviceStatusText(Active);

    // The free model returns a friendly limit message when the daily token budget is spent.
    bool QuotaExhausted
    {
        get
        {
            if (State.Profile.Model.Provider != global::Mesh.App.Domain.ModelProvider.MeshHosted) return false;
            var last = Active?.Lines.LastOrDefault(l => l.Role == "assistant");
            return last is not null && last.Text.StartsWith("You've reached today's free-model limit", StringComparison.Ordinal);
        }
    }

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        Mesh.ReplicationStateChanged += Refresh;
        EnsureRosterScope();
        rosterRefreshLoop = RefreshRosterWhileMountedAsync();
        // Deep links take precedence, then local desktop history, then the existing recent-topic fallback.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var wanted = ParseQueryValue(uri.Query, "thread");
        var remembered = State.GetLastDesktopTopicId();
        if (!string.IsNullOrWhiteSpace(wanted) && State.Profile.OwnThreads.Any(t => t.Id == wanted))
            activeThread = wanted;
        else if (!string.IsNullOrWhiteSpace(remembered)
                 && State.Profile.OwnThreads.Any(t => t.Id == remembered))
            activeThread = remembered;
        else if (activeThread is null && State.Profile.OwnThreads.Count > 0)
            activeThread = State.Profile.OwnThreads[^1].Id;
        else if (!string.IsNullOrWhiteSpace(remembered))
            State.SetLastDesktopTopicId(null);

        if (activeThread is not null) State.MarkThreadSeen(activeThread);
        RestorePendingAiRequest();
    }

    protected override async Task OnInitializedAsync()
    {
        Agent.EnsureAskUserResumeRegistered();
        await State.RecoverPendingAskUserPromptsAsync();
        await LoadDevicesAsync();
    }

    readonly HashSet<string> askResolving = new(StringComparer.Ordinal);

    async Task ResolveAskAsync(string promptId, string optionId)
    {
        if (!askResolving.Add(promptId)) return; // one click wins; ignore re-entrancy
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:ask:{promptId}");
        try
        {
            await State.ResolveAskUserPromptAsync(promptId, optionId);
        }
        finally
        {
            await InvokeAsync(() =>
            {
                State.TryCompleteScopedAsyncOperation(operationScope, () =>
                {
                    askResolving.Remove(promptId);
                    StateHasChanged();
                });
            });
        }
    }

    static string? ParseQueryValue(string queryString, string key)
    {
        if (string.IsNullOrEmpty(queryString)) return null;
        foreach (var pair in queryString.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0) continue;
            if (Uri.UnescapeDataString(pair[..eq]) == key) return Uri.UnescapeDataString(pair[(eq + 1)..]);
        }
        return null;
    }

    void Refresh()
    {
        if (disposed || Shutdown.IsStopping) return;
        Shutdown.Track(InvokeAsync(() =>
        {
            if (!disposed && !Shutdown.IsStopping)
            {
                var priorGeneration = rosterGeneration;
                EnsureRosterScope();
                if (priorGeneration != rosterGeneration)
                    Shutdown.Track(LoadDevicesAsync(), "home roster account refresh");
                RestorePendingAiRequest();
                StateHasChanged();
            }
        }), "home refresh");
    }

    void EnsureRosterScope()
    {
        var accountId = State.ActiveAccountId;
        AgentRuntimeScopeToken? runtimeScope = null;
        if (accountId is not null
            && State.TryCaptureAgentRuntimeScope(out var capturedScope))
            runtimeScope = capturedScope;
        if (string.Equals(rosterAccountId, accountId, StringComparison.Ordinal)
            && rosterRuntimeScope == runtimeScope) return;
        rosterAccountId = accountId;
        rosterRuntimeScope = runtimeScope;
        Interlocked.Increment(ref rosterGeneration);
        rosterDevices.Clear();
        eligibleDevices.Clear();
        pendingAiRetry = null;
        aiRetryRunning = false;
    }

    void RestorePendingAiRequest()
    {
        var request = Active is null ? null : State.GetPendingAssistantAiRequest(Active.Id);
        if (request?.State == AssistantAiRequestState.DispatchPending
            && !inFlightAssistantDispatches.Contains(request.RunId)
            && State.TryCaptureAssistantAiRequestMutationScope(request, out var requestScope))
        {
            var transition = State.RecordAssistantAiDispatch(
                requestScope!,
                TopicDispatchResult.Reject(
                    "dispatch_interrupted",
                    request.RunId,
                    "Dispatch was interrupted. Retry on an online agent device."));
            request = transition.Request ?? request;
        }
        ApplyAssistantProjection(request);
    }

    void ApplyAssistantProjection(AssistantAiRequest? request)
    {
        var projection = AssistantAiRequestReducer.Project(request);
        pendingAiRetry = projection.RetryVisible && request is not null
            ? new PendingAiRetry(request.ThreadId, request.RunId, request.TriggerLineId)
            : null;
        assistantProjectionError = projection.Error;
    }

    async Task RefreshRosterWhileMountedAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
            while (await timer.WaitForNextTickAsync(rosterLifetime.Token))
                await LoadDevicesAsync();
        }
        catch (OperationCanceledException) when (rosterLifetime.IsCancellationRequested)
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var renderedThread = activeThread;
        if (!State.TryCaptureScopedAsyncOperation(
            "ui:desktop-home:render",
            out var renderScope,
            renderedThread))
            return;
        bool TryApplyRender(Action mutation)
        {
            var applied = false;
            State.TryApplyScopedAsyncOperation(renderScope!, () =>
            {
                if (disposed
                    || !string.Equals(activeThread, renderedThread, StringComparison.Ordinal))
                    return;
                mutation();
                applied = true;
            });
            return applied;
        }

        if (firstRender)
            selfRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);

        // Wire each helper when its element actually exists. On mobile the list and composer are
        // mutually exclusive, so firstRender alone cannot initialize both.
        if (selfRef is not null)
        {
            if (!composerWired)
            {
                try
                {
                    await JS.InvokeVoidAsync("meshUI.composer", composerEl, selfRef, 5);
                    if (!TryApplyRender(() => { })) return;
                    await JS.InvokeVoidAsync("meshPaste.attach", composerEl, selfRef);
                    if (!TryApplyRender(() => composerWired = true)) return;
                }
                catch { }
            }
        }

        try { await JS.InvokeVoidAsync("meshUI.autoScroll", scrollEl, scrollToLatestEl); } catch { }
        if (!TryApplyRender(() => { })) return;

        var scrollToLatest = false;
        var stopForHistory = false;
        if (!TryApplyRender(() =>
            {
                scrollToLatest = scrollToLatestRequested;
                scrollToLatestRequested = false;
                if (!preserveHistoryScroll) return;
                preserveHistoryScroll = false;
                stopForHistory = !scrollToLatest;
            })) return;
        if (stopForHistory) return;

        // Scroll on first paint, when a line is added, AND when the active thread's turn finishes
        // (busy true->false): the reply is added while the thread is still busy, so tracking that
        // transition guarantees the final answer scrolls into view even if its line count collides
        // with an earlier render.
        var count = Active?.Lines.Count ?? 0;
        var activeChanged = activeThread != lastScrolledThread;
        if (activeChanged)
        {
            try { await JS.InvokeVoidAsync("meshUI.resizeComposer", composerEl, 5); } catch { }
            if (!TryApplyRender(() => { })) return;
        }
        if (scrollToLatest || firstRender || activeChanged || count != lastCount || ActiveBusy != lastBusy || ActiveBusy)
        {
            if (!TryApplyRender(() =>
                {
                    lastCount = count;
                    lastBusy = ActiveBusy;
                    lastScrolledThread = renderedThread;
                })) return;
            var method = scrollToLatest || firstRender || activeChanged
                ? "meshUI.scrollToBottom"
                : "meshUI.scrollToBottomIfPinned";
            try { await JS.InvokeVoidAsync(method, scrollEl); } catch { }
            TryApplyRender(() => { });
        }
    }

    async Task ScrollToLatest()
    {
        try { await JS.InvokeVoidAsync("meshUI.scrollToBottom", scrollEl); } catch { }
    }

    /// <summary>Invoked from JS when the user presses Enter (without Shift) in the composer.</summary>
    [Microsoft.JSInterop.JSInvokable]
    public Task SendFromComposer() => PrimaryComposerAction();

    Task PrimaryComposerAction() => RequestAiResponse();

    /// <summary>
    /// Invoked from paste.js when a file is pasted into the composer. Writes the pasted bytes to a temp
    /// file and stages it so it sends by path (the same flow as the attach button), then re-renders.
    /// </summary>
    [Microsoft.JSInterop.JSInvokable]
    public Task OnPasteFile(string name, string mime, string base64)
    {
        attachError = null;
        var staged = PasteFiles.SaveTemp(name, mime, base64);
        if (staged is { } s)
        {
            LocalFiles.Allow(s.Path);
            attachments.Add(new StagedFile(s.Name, s.Path, s.Size));
        }
        else
        {
            attachError = "Could not read the pasted file.";
        }
        return InvokeAsync(StateHasChanged);
    }

    void ShowEarlierMessages()
    {
        messageRenderCount = MessageRenderWindow.NextCount(OrderedVisibleLines.Count, messageRenderCount);
        preserveHistoryScroll = true;
    }

    void Select(string id)
    {
        activeThread = id;
        confirmDelete = false;
        renaming = false;
        State.MarkThreadSeen(id);
        RestorePendingAiRequest();
    }

    void OnThreadKey(KeyboardEventArgs e, string id)
    {
        if (e.Key is "Enter" or " ") Select(id);
    }

    void OpenReport()
    {
        if (Active is null) return;
        reportDialog?.Show($"Me topic: {Active.Title}", Active.Lines,
            l => l.Role == "assistant" ? "agent" : "me", State.CurrentModelKey());
    }

    async Task NewLocalThread()
    {
        var host = eligibleDevices.FirstOrDefault(device =>
                       string.Equals(device.DeviceId, Mesh.MyDeviceId, StringComparison.Ordinal))
                   ?? eligibleDevices.FirstOrDefault();
        if (host is null)
        {
            deviceError = "Bring an agent device online to start a chat.";
            return;
        }
        await CreateThreadOn(ToAgentExecutionHost(host));
    }

    async Task CreateThreadOn(AgentExecutionHost host)
    {
        if (!eligibleDevices.Any(item =>
                string.Equals(item.DeviceId, host.DeviceId, StringComparison.Ordinal))) return;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:new-thread");
        OwnThread t;
        try
        {
            t = await State.NewOwnThreadAsync("New chat", host);
        }
        catch
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
                deviceError = "Could not create the assistant chat. Try again.");
            return;
        }
        State.TryCompleteScopedAsyncOperation(operationScope, () =>
        {
            activeThread = t.Id;
            confirmDelete = false;
            renaming = false;
            input = "";
            createMenuOpen = false;
        });
    }

    async Task LoadDevicesAsync()
    {
        EnsureRosterScope();
        var requestedAccountId = rosterAccountId;
        var requestedGeneration = rosterGeneration;
        if (!State.TryCaptureScopedAsyncOperation(
                $"{asyncScopeOwner}:roster",
                out var operationScope)
            || !State.TryApplyScopedAsyncOperation(operationScope!, () =>
            {
                loadingDevices = true;
                deviceError = null;
            }))
            return;
        try
        {
            var devices = await TopicRouter.ListDevicesAsync(rosterLifetime.Token);
            State.TryApplyScopedAsyncOperation(operationScope!, () =>
            {
                EnsureRosterScope();
                if (requestedGeneration != rosterGeneration
                    || !string.Equals(
                        requestedAccountId,
                        rosterAccountId,
                        StringComparison.Ordinal)) return;
                rosterDevices.Clear();
                eligibleDevices.Clear();
                rosterDevices.AddRange(devices);
                eligibleDevices.AddRange(
                    global::Mesh.Shared.DeviceExecutionEligibility.EligibleHosts(devices));
            });
        }
        catch (OperationCanceledException) when (rosterLifetime.IsCancellationRequested) { }
        catch
        {
            State.TryApplyScopedAsyncOperation(
            operationScope!,
                () => deviceError =
                    "Could not load linked devices. Check your connection and try again.");
        }
        finally
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope!,
                () => loadingDevices = false);
        }
    }

    async Task ToggleCreateMenu()
    {
        createMenuOpen = !createMenuOpen;
        moveMenuOpen = false;
        if (createMenuOpen) await LoadDevicesAsync();
    }

    async Task ToggleMoveMenu()
    {
        moveMenuOpen = !moveMenuOpen;
        createMenuOpen = false;
        if (moveMenuOpen) await LoadDevicesAsync();
    }

    async Task CloseCreateMenu()
    {
        createMenuOpen = false;
        await createMenuButton.FocusAsync();
    }

    async Task CloseMoveMenu()
    {
        moveMenuOpen = false;
        await moveMenuButton.FocusAsync();
    }

    async Task OnCreateMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseCreateMenu();
    }

    async Task OnMoveMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseMoveMenu();
    }

    void RequestMove(AgentExecutionHost target)
        => _ = RequestMoveAsync(target);

    async Task RequestMoveAsync(AgentExecutionHost target)
    {
        moveMenuOpen = false;
        if (Active is null) return;
        var scope = State.CaptureActiveThreadMutationScope(Active.Id);
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:execution-move:{Active.Id}",
            Active.Id);
        var requestScope = State.GetPendingAssistantAiRequest(Active.Id) is { } request
            ? State.CaptureAssistantAiRequestMutationScope(request)
            : null;
        await LoadDevicesAsync();
        if (!State.IsCurrentScopedAsyncOperation(operationScope)
            || !State.IsCurrentActiveThreadMutationScope(scope)) return;
        var eligibleTarget = rosterDevices.FirstOrDefault(device =>
            device.DeviceId == target.DeviceId
            && global::Mesh.Shared.DeviceExecutionEligibility.IsEligible(device));
        if (eligibleTarget is null)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => dispatchError =
                    $"{DeviceName(target)} is no longer available for execution.");
            return;
        }
        target = ToAgentExecutionHost(eligibleTarget);
        if (ActiveBusy)
        {
            var runId = CurrentRunId(Active);
            if (string.IsNullOrWhiteSpace(runId))
            {
                State.TryCompleteScopedAsyncOperation(
                    operationScope,
                    () => dispatchError =
                        "The active run could not be identified. Wait for it to finish before moving this topic.");
                return;
            }
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
                pendingMove = new PendingTopicMove(
                    Active.Id,
                    ThreadTitle(Active),
                    runId,
                    target,
                    scope,
                    requestScope));
            return;
        }
        await MoveActiveTo(target, scope, requestScope, operationScope);
    }

    async Task ConfirmActiveMove()
    {
        var target = pendingMove;
        pendingMove = null;
        if (target is null) return;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:confirm-move:{target.ThreadId}",
            target.ThreadId,
            requestId: target.RequestScope?.OperationId,
            runId: target.RunId);
        await LoadDevicesAsync();
        if (!State.IsCurrentActiveThreadMutationScope(target.Scope)) return;
        var eligibleTarget = rosterDevices.FirstOrDefault(device =>
            device.DeviceId == target.Target.DeviceId
            && global::Mesh.Shared.DeviceExecutionEligibility.IsEligible(device));
        if (eligibleTarget is null)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => dispatchError =
                    $"{DeviceName(target.Target)} is no longer available for execution.");
            return;
        }
        if (!await TopicRouter.StopAsync(operationScope, CancellationToken.None))
        {
            if (!State.IsCurrentActiveThreadMutationScope(target.Scope)) return;
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => dispatchError =
                    $"Could not stop {target.TopicTitle}. It was not moved.");
            return;
        }
        if (!State.IsCurrentActiveThreadMutationScope(target.Scope)) return;
        var host = ToAgentExecutionHost(eligibleTarget);
        State.TryCompleteScopedAsyncOperation(operationScope, () =>
            State.MoveOwnThreadAgentExecutionHost(
                target.Scope,
                host,
                target.RequestScope,
                operationScope: operationScope));
    }

    async Task MoveActiveTo(
        AgentExecutionHost target,
        ActiveThreadMutationScope? capturedScope = null,
        AssistantAiRequestMutationScope? capturedRequestScope = null,
        ScopedAsyncOperation? capturedOperationScope = null)
    {
        if (Active is null) return;
        var scope = capturedScope ?? State.CaptureActiveThreadMutationScope(Active.Id);
        var requestScope = capturedRequestScope
            ?? (State.GetPendingAssistantAiRequest(scope.ThreadId) is { } request
                ? State.CaptureAssistantAiRequestMutationScope(request)
                : null);
        var operationScope = capturedOperationScope
            ?? State.CaptureScopedAsyncOperation(
                $"{asyncScopeOwner}:execution-move:{scope.ThreadId}",
                scope.ThreadId);
        await LoadDevicesAsync();
        if (!State.IsCurrentActiveThreadMutationScope(scope)) return;
        var eligibleTarget = rosterDevices.FirstOrDefault(device =>
            device.DeviceId == target.DeviceId
            && global::Mesh.Shared.DeviceExecutionEligibility.IsEligible(device));
        if (eligibleTarget is null)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => dispatchError =
                    $"{DeviceName(target)} is no longer available for execution.");
            return;
        }
        var host = ToAgentExecutionHost(eligibleTarget);
        State.TryCompleteScopedAsyncOperation(operationScope, () =>
            State.MoveOwnThreadAgentExecutionHost(
                scope,
                host,
                requestScope,
                operationScope: operationScope));
    }

