@page "/skills"
@inject AppState State
@inject SkillMarketplaceService Marketplace
@inject ISkillCatalogService Catalog
@implements IDisposable

<MobileOverlayScope Active="@(openMarketId is not null)" />

<div class="pane-scroll">
    <div class="pane-narrow">
    <SectionHeader Title="Skills"
                   Description="Expose capabilities your agent can perform - keep them private, share them with selected circles, or allow every approved contact." />

    <div class="card-panel">
        <div class="field">
            <label>Skill name</label>
            <input class="full" @bind="name" placeholder="e.g. Book a 30-min intro call" />
        </div>
        <div class="field">
            <label>Description</label>
            <input class="full" @bind="description" placeholder="Short description of what it does" />
        </div>
        <div class="field">
            <label>Instructions <span class="muted">(how the agent performs it)</span></label>
            <textarea class="full" rows="3" @bind="instructions" placeholder="e.g. Offer two time slots and confirm the attendee's email…"></textarea>
        </div>
        <div class="field">
            <label>Who can use it</label>
            <AudiencePicker @bind-Value="visibility"
                            Circles="@State.Profile.Circles"
                            Class="full"
                            AriaLabel="Who can use this skill" />
        </div>
        <button class="primary" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(name)">
            <i class="bi bi-plus-lg"></i> Add skill
        </button>
    </div>

    <div class="card-panel skill-catalog">
        <div class="mp-title">
            <h3><i class="bi bi-stars"></i> Find skills</h3>
            <span class="field-hint">
                Search the built-in catalog. Mesh checks operating system, desktop/mobile support,
                required CLI tools, and package files before installing.
            </span>
        </div>
        <div class="mp-add-row">
            <input class="full"
                   placeholder="Search by capability, tool, or task"
                   @bind="catalogQuery"
                   @bind:event="oninput"
                   @onkeydown="OnCatalogKeyDown"
                   disabled="@catalogSearching"
                   aria-label="Search the skill catalog" />
            <button class="primary"
                    @onclick="SearchCatalogAsync"
                    disabled="@(catalogSearching || string.IsNullOrWhiteSpace(catalogQuery))">
                @if (catalogSearching)
                {
                    <i class="bi bi-arrow-repeat spin"></i> <span>Searching</span>
                }
                else
                {
                    <i class="bi bi-search"></i> <span>Search</span>
                }
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(catalogStatus))
        {
            <div class="@(catalogError ? "err-text" : "muted small")" role="status">@catalogStatus</div>
        }
        @if (catalogResults.Count > 0)
        {
            <div class="skill-catalog-results">
                @foreach (var result in catalogResults)
                {
                    var verdict = CatalogVerdict(result);
                    var installed = IsCatalogSkillInstalled(result);
                    var busy = installingCatalogKey == CatalogKey(result);
                    <article class="skill-catalog-result">
                        <div class="skill-catalog-head">
                            <div>
                                <b>@result.Name</b>
                                <div class="muted small">
                                    @result.Source
                                    @if (!string.IsNullOrWhiteSpace(result.Stars))
                                    {
                                        <span> · <i class="bi bi-star-fill"></i> @result.Stars</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(result.Category))
                                    {
                                        <span> · @result.Category</span>
                                    }
                                </div>
                            </div>
                            <span class="chip @CompatibilityClass(verdict.Level)">
                                @CompatibilityLabel(verdict)
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(result.Description))
                        {
                            <p class="small">@result.Description</p>
                        }
                        <div class="skill-catalog-meta">
                            <span><i class="bi bi-pc-display"></i> @OsLabel(result.Advisory)</span>
                            <span><i class="bi bi-phone"></i> @DeviceClassLabel(result.Advisory)</span>
                            <span><i class="bi bi-terminal"></i> @CliLabel(result.Advisory)</span>
                        </div>
                        @if (verdict.Reasons.Count > 0)
                        {
                            <div class="muted small">@string.Join(" ", verdict.Reasons)</div>
                        }
                        <div class="skill-catalog-actions">
                            <button class="primary"
                                    @onclick="() => InstallCatalogSkillAsync(result)"
                                    disabled="@(busy || installed || !verdict.CanInstall)">
                                @if (busy)
                                {
                                    <i class="bi bi-arrow-repeat spin"></i> <span>Checking package</span>
                                }
                                else if (installed)
                                {
                                    <i class="bi bi-check-lg"></i> <span>Installed</span>
                                }
                                else
                                {
                                    <i class="bi bi-download"></i> <span>Install</span>
                                }
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="card-panel">
        <div class="mp-title">
            <h3><i class="bi bi-shop"></i> Skill marketplaces</h3>
            <span class="field-hint">Connect a marketplace by URL, browse its skills, and import the ones you want. Add a bespoke skills.json, or a GitHub repo like owner/repo. Imported skills auto-update on startup.</span>
        </div>

        <div class="mp-add-row">
            <input class="full" placeholder="owner/repo or https://example.com/skills.json"
                   @bind="marketUrl" @bind:event="oninput" @onkeydown="OnMarketKeyDown" disabled="@addingMarket" />
            <button class="primary" @onclick="AddMarketplace" disabled="@(addingMarket || string.IsNullOrWhiteSpace(marketUrl))">
                @if (addingMarket)
                {
                    <i class="bi bi-arrow-repeat spin"></i> <span>Adding</span>
                }
                else
                {
                    <i class="bi bi-plus-lg"></i> <span>Add</span>
                }
            </button>
        </div>
        @if (!string.IsNullOrEmpty(marketError)) { <div class="err-text">@marketError</div> }

        @if (State.Profile.SkillMarketplaces.Count == 0)
        {
            <div class="muted small">No marketplaces yet. Add one to browse importable skills.</div>
        }
        else
        {
            <div class="mp-list">
                @foreach (var m in State.Profile.SkillMarketplaces)
                {
                    <div class="mp-row">
                        <div class="mp-info">
                            <b>@m.Name</b>
                            <span class="muted small">@HostOf(m.Url)</span>
                            @if (m.LastSyncedAt is not null)
                            {
                                <span class="muted small">Last synced @m.LastSyncedAt.Value.LocalDateTime.ToString("g")</span>
                            }
                        </div>
                        <div class="mp-actions">
                            <button class="ghost" @onclick="() => Browse(m)" disabled="@(browsingId == m.Id)">
                                @if (browsingId == m.Id)
                                {
                                    <i class="bi bi-arrow-repeat spin"></i> <span>Loading</span>
                                }
                                else
                                {
                                    <i class="bi bi-search"></i> <span>Browse</span>
                                }
                            </button>
                            <button class="ghost" @onclick="() => SyncNow(m)" disabled="@(syncingId == m.Id)">
                                @if (syncingId == m.Id)
                                {
                                    <i class="bi bi-arrow-repeat spin"></i> <span>Syncing</span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-repeat"></i> <span>Sync now</span>
                                }
                            </button>
                            <button class="icon-btn" title="Remove marketplace" @onclick="() => RemoveMarketplace(m)"><i class="bi bi-trash"></i></button>
                        </div>

                        @if (openMarketId == m.Id)
                        {
                            <MobileOverlayScope />
                            <div class="sk-modal-backdrop" @onclick="CloseBrowse">
                            <div class="sk-modal" @onclick:stopPropagation="true">
                            <div class="sk-modal-head">
                                <b><i class="bi bi-shop"></i> @m.Name</b>
                                <button class="icon-btn" title="Close" @onclick="CloseBrowse"><i class="bi bi-x-lg"></i></button>
                            </div>
                            <div class="sk-modal-body">
                                @if (browseError is not null)
                                {
                                    <div class="err-text">@browseError</div>
                                }
                                else if (browseIndex is null)
                                {
                                    <div class="muted small">Loading skills…</div>
                                }
                                else if (browseIndex.Skills.Count == 0)
                                {
                                    <div class="muted small">This marketplace offers no skills right now.</div>
                                }
                                else
                                {
                                    RenderFragment<SkillMarketplaceService.MarketplaceSkill> skillRow = ms =>
                                        @<label class="mp-skill @(IsImported(m.Id, ms.Id) ? "is-imported" : "")">
                                            <input type="checkbox" disabled="@IsImported(m.Id, ms.Id)"
                                                   checked="@selected.Contains(ms.Id)"
                                                   @onchange="e => ToggleSelected(ms.Id, e)" />
                                            <div class="mp-skill-body">
                                                <div class="mp-skill-head">
                                                    <b>@ms.Name</b>
                                                    @if (IsImported(m.Id, ms.Id)) { <span class="chip">Imported</span> }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(ms.Description)) { <div class="muted small">@ms.Description</div> }
                                            </div>
                                        </label>;

                                    if (browseIndex.Plugins.Count > 0)
                                    {
                                        <div class="mp-plugin-list">
                                            @foreach (var pl in browseIndex.Plugins)
                                            {
                                                <div class="mp-plugin">
                                                    <div class="mp-plugin-head">
                                                        <i class="bi bi-box-seam"></i>
                                                        <b>@pl.Name</b>
                                                        <span class="muted small">@pl.Skills.Count skill@(pl.Skills.Count == 1 ? "" : "s")</span>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(pl.Description)) { <div class="muted small mp-plugin-desc">@pl.Description</div> }
                                                    <div class="mp-skill-list">
                                                        @foreach (var ms in pl.Skills) { @skillRow(ms) }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mp-skill-list">
                                            @foreach (var ms in browseIndex.Skills) { @skillRow(ms) }
                                        </div>
                                    }
                                }
                            </div>
                            @if (browseError is null && browseIndex is not null && browseIndex.Skills.Count > 0)
                            {
                                <div class="sk-modal-foot">
                                    <button class="ghost" @onclick="CloseBrowse"><i class="bi bi-x-lg"></i> Close</button>
                                    <button class="primary" @onclick="() => ImportSelected(m)" disabled="@(selected.Count == 0)">
                                        <i class="bi bi-download"></i> Import selected (@selected.Count)
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="sk-modal-foot">
                                    <button class="ghost" @onclick="CloseBrowse"><i class="bi bi-x-lg"></i> Close</button>
                                </div>
                            }
                            </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="kn-list">
        @if (State.Profile.Skills.Count == 0 && !skillHintDismissed)
        {
            <div class="kn-hint" role="note" aria-label="Getting started tip">
                <span class="kn-hint-text">Try "Book a 30-min intro call" - name a skill, describe it, write how your agent should handle it, then choose who may use it.</span>
                <button class="kn-hint-close" @onclick="() => skillHintDismissed = true" aria-label="Dismiss tip"><i class="bi bi-x-lg"></i></button>
            </div>
        }
        @foreach (var s in AssetPagePolicy.Take(State.Profile.Skills, visibleCount))
        {
            <div class="kn-card">
                @if (editingId == s.Id)
                {
                    @if (editLoading)
                    {
                        <div class="muted small" role="status" aria-live="polite"><i class="bi bi-arrow-repeat spin"></i> Loading skill…</div>
                    }
                    else if (editError is not null)
                    {
                        <div class="err-text" role="alert">@editError</div>
                        <div class="kn-row">
                            <button class="ghost" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> Close</button>
                        </div>
                    }
                    <div class="field">
                        <label>Name</label>
                        <input class="full" @bind="editName" disabled="@(!editLoaded)" />
                    </div>
                    <div class="field">
                        <label>Description</label>
                        <input class="full" @bind="editDescription" disabled="@(!editLoaded)" />
                    </div>
                    <div class="field">
                        <label>Instructions <span class="muted">(how the agent performs it)</span></label>
                        <textarea class="full" rows="6" @bind="editInstructions" disabled="@(!editLoaded)"></textarea>
                    </div>
                    <div class="kn-row">
                        <AudiencePicker @bind-Value="editVisibility"
                                        Circles="@State.Profile.Circles"
                                        Class="grow"
                                        AriaLabel="Who can use this skill" />
                        <button class="primary" @onclick="() => SaveEdit(s)" disabled="@(!editLoaded)"><i class="bi bi-check-lg"></i> Save</button>
                        <button class="ghost" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> Cancel</button>
                    </div>
                }
                else
                {
                    <div class="kn-head">
                        <label class="switch" title="Enabled">
                            <input type="checkbox" checked="@s.Enabled" @onchange="e => Toggle(s, e)" />
                        </label>
                        <b>@s.Name</b>
                        <span class="vis @VisClass(s.Visibility)">@AudiencePolicy.DisplayLabel(s.Visibility)</span>
                        @if (s.SourceMarketplaceId is not null)
                        {
                            <span class="mp-badge"><i class="bi bi-shop"></i> from @MarketNameFor(s.SourceMarketplaceId)</span>
                        }
                        <span class="spacer"></span>
                        <button class="icon-btn" title="Edit" @onclick="() => BeginEdit(s)"><i class="bi bi-pencil"></i></button>
                        <button class="icon-btn" title="Delete" @onclick="() => Remove(s)"><i class="bi bi-trash"></i></button>
                    </div>
                    <div class="kn-body">
                        @s.Description
                        @if (!string.IsNullOrWhiteSpace(s.Instructions)) { <div class="muted small">How: @s.Instructions</div> }
                    </div>
                }
            </div>
        }
        @if (AssetPagePolicy.HasMore(State.Profile.Skills.Count, visibleCount))
        {
            <button class="ghost load-more" @onclick="LoadMore" aria-label="Load more skills">
                <i class="bi bi-chevron-down"></i> Load more (@AssetPagePolicy.Remaining(State.Profile.Skills.Count, visibleCount) more)
            </button>
        }
        @if (State.Profile.Skills.Count == 0)
        {
            <EmptyState Icon="bi-lightning-charge"
                        Title="No skills yet"
                        Description="Add a skill and choose which contacts may request it." />
        }
    </div>
    </div>
</div>

@code {
    string name = "", description = "", instructions = "", visibility = "private";
    string? editingId;
    string editName = "", editDescription = "", editInstructions = "", editVisibility = "private";
    bool skillHintDismissed;

    // Mesh 1.17 bounded paging over summary metadata: never render the whole corpus at once.
    int visibleCount = AssetPagePolicy.PageSize;

    string catalogQuery = "";
    string? catalogStatus;
    bool catalogError;
    bool catalogSearching;
    string? installingCatalogKey;
    IReadOnlyList<SkillCatalogResult> catalogResults = Array.Empty<SkillCatalogResult>();
    CancellationTokenSource? catalogCts;

    // Lazy-body edit state: a summary carries blank Instructions, so the full skill is loaded on demand.
    bool editLoading;
    bool editLoaded;
    string? editError;
    CancellationTokenSource? editCts;

    protected override void OnInitialized() => State.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);

    void LoadMore() => visibleCount = AssetPagePolicy.NextVisible(visibleCount, State.Profile.Skills.Count);

    async Task OnCatalogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchCatalogAsync();
    }

    async Task SearchCatalogAsync()
    {
        if (catalogSearching || string.IsNullOrWhiteSpace(catalogQuery)) return;
        catalogCts?.Cancel();
        catalogCts?.Dispose();
        catalogCts = new CancellationTokenSource();
        catalogSearching = true;
        catalogError = false;
        catalogStatus = null;
        try
        {
            catalogResults = await Catalog.SearchAsync(
                catalogQuery.Trim(),
                maxResults: 20,
                forCurrentDevice: false,
                catalogCts.Token);
            catalogStatus = catalogResults.Count == 0
                ? "No matching skills found."
                : $"{catalogResults.Count} skill{(catalogResults.Count == 1 ? "" : "s")} found.";
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            catalogError = true;
            catalogStatus = "Could not search the skill catalog: " + ex.Message;
            catalogResults = Array.Empty<SkillCatalogResult>();
        }
        finally
        {
            catalogSearching = false;
        }
    }

    async Task InstallCatalogSkillAsync(SkillCatalogResult result)
    {
        var key = CatalogKey(result);
        if (installingCatalogKey is not null || IsCatalogSkillInstalled(result)) return;
        installingCatalogKey = key;
        catalogError = false;
        catalogStatus = $"Checking {result.Name} for this device...";
        try
        {
            var package = await Catalog.DownloadPackageAsync(result);
            var install = await State.InstallSkillPackageAsync(
                package,
                result.Name,
                result.Description,
                visibility: "private",
                sourceMarketplaceId: "catalog:" + result.Source,
                sourceSkillId: result.Id);
            if (!install.Success)
            {
                catalogError = true;
                catalogStatus = install.Error ?? "This skill cannot be installed on this device.";
                return;
            }

            catalogStatus = install.Compatibility.CanRun
                ? $"{result.Name} was installed."
                : $"{result.Name} was installed but disabled. {string.Join(" ", install.Compatibility.Reasons)}";
        }
        catch (Exception ex)
        {
            catalogError = true;
            catalogStatus = $"Could not install {result.Name}: {ex.Message}";
        }
        finally
        {
            installingCatalogKey = null;
        }
    }

    SkillCompatibilityResult CatalogVerdict(SkillCatalogResult result)
        => State.CheckSkillCompatibility(new Skill { Compatibility = result.Advisory });

    bool IsCatalogSkillInstalled(SkillCatalogResult result)
        => State.Profile.Skills.Any(skill =>
            string.Equals(skill.SourceMarketplaceId, "catalog:" + result.Source, StringComparison.Ordinal)
            && string.Equals(skill.SourceSkillId, result.Id, StringComparison.Ordinal));

    static string CatalogKey(SkillCatalogResult result) => result.Source + "\u001f" + result.Id;

    static string CompatibilityLabel(SkillCompatibilityResult verdict) => verdict.Level switch
    {
        SkillCompatibilityLevel.Compatible => "Compatible",
        SkillCompatibilityLevel.Warning => "Needs tools",
        _ => "Not supported"
    };

    static string CompatibilityClass(SkillCompatibilityLevel level) => level switch
    {
        SkillCompatibilityLevel.Compatible => "skill-compatible",
        SkillCompatibilityLevel.Warning => "skill-warning",
        _ => "skill-incompatible"
    };

    static string OsLabel(SkillCompatibility? compatibility)
        => compatibility is null || compatibility.OperatingSystems == SkillOperatingSystems.None
            ? "OS checked on install"
            : compatibility.OperatingSystems.ToString().Replace("IOS", "iOS");

    static string DeviceClassLabel(SkillCompatibility? compatibility)
        => compatibility?.DeviceClass.ToString() ?? "Device type checked on install";

    static string CliLabel(SkillCompatibility? compatibility)
        => compatibility is null
            ? "Tools checked on install"
            : compatibility.RequiredCliTools.Count == 0
                ? "No CLI required"
                : string.Join(", ", compatibility.RequiredCliTools);

    void Add()
    {
        if (string.IsNullOrWhiteSpace(name)) return;
        var skill = new Skill
        {
            Name = name.Trim(), Description = description.Trim(), Instructions = instructions.Trim(), Visibility = visibility
        };
        AssetMutations.Apply(State, AssetEdit.Create, AssetKind.Skill, skill.Id, p => p.Skills.Add(skill));
        name = ""; description = ""; instructions = ""; visibility = "private";
    }

    async Task BeginEdit(Skill s)
    {
        editCts?.Cancel();
        editCts?.Dispose();
        var cts = new CancellationTokenSource();
        editCts = cts;

        editingId = s.Id;
        editName = s.Name; editDescription = s.Description; editVisibility = s.Visibility;
        editInstructions = "";
        editLoaded = false; editError = null; editLoading = true;

        try
        {
            // Only the selected asset's full body is loaded; never overwrite the stored body with blank.
            var full = await State.LoadFullSkillAsync(s.Id, cts.Token);
            if (cts.IsCancellationRequested || editingId != s.Id) return;
            if (full is null)
            {
                editError = "This skill could not be loaded - it may have been deleted.";
            }
            else
            {
                editName = full.Name; editDescription = full.Description;
                editInstructions = full.Instructions; editVisibility = full.Visibility;
                editLoaded = true;
            }
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            if (editingId == s.Id) editError = "Could not load this skill: " + ex.Message;
        }
        finally
        {
            if (editCts == cts) { editLoading = false; StateHasChanged(); }
        }
    }

    void SaveEdit(Skill s)
    {
        // Guard: persist the body only once the full asset has actually loaded.
        if (!AssetPagePolicy.CanPersistBody(editLoaded)) return;
        AssetMutations.Apply(State, AssetEdit.EditBody, AssetKind.Skill, s.Id, _ =>
        {
            s.Name = editName.Trim(); s.Description = editDescription.Trim();
            s.Instructions = editInstructions.Trim(); s.Visibility = editVisibility;
        });
        CancelEdit();
    }

    void CancelEdit()
    {
        editCts?.Cancel();
        editCts?.Dispose();
        editCts = null;
        editingId = null;
        editLoading = false; editLoaded = false; editError = null;
    }

    void Toggle(Skill s, ChangeEventArgs e)
        => AssetMutations.Apply(State, AssetEdit.ToggleEnabled, AssetKind.Skill, s.Id, _ => s.Enabled = (bool)(e.Value ?? false));

    void Remove(Skill s)
        => AssetMutations.Apply(State, AssetEdit.Delete, AssetKind.Skill, s.Id, p => p.Skills.Remove(s));

    static string VisClass(string visibility) => AudiencePolicy.CssClass(visibility);

    // ---- Skill marketplaces ----
    string marketUrl = "";
    string? marketError;
    bool addingMarket;

    string? browsingId;                 // marketplace currently being fetched
    string? openMarketId;               // marketplace whose browse panel is open
    string? syncingId;                  // marketplace currently syncing
    SkillMarketplaceService.MarketplaceIndex? browseIndex;
    string? browseError;
    readonly HashSet<string> selected = new();

    async Task AddMarketplace()
    {
        if (addingMarket || string.IsNullOrWhiteSpace(marketUrl)) return;
        addingMarket = true;
        marketError = null;
        try
        {
            var (added, error) = await Marketplace.AddMarketplaceAsync(marketUrl);
            if (added is null) { marketError = error; }
            else { marketUrl = ""; }
        }
        finally { addingMarket = false; }
    }

    async Task OnMarketKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddMarketplace();
    }

    async Task Browse(SkillMarketplace m)
    {
        if (openMarketId == m.Id) { CloseBrowse(); return; }
        browsingId = m.Id;
        browseError = null;
        browseIndex = null;
        selected.Clear();
        openMarketId = m.Id;
        try
        {
            var (index, error) = await Marketplace.FetchAsync(m.Url);
            browseIndex = index;
            browseError = error;
        }
        finally { browsingId = null; }
    }

    void CloseBrowse()
    {
        openMarketId = null;
        browseIndex = null;
        browseError = null;
        selected.Clear();
    }

    void ToggleSelected(string skillId, ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false)) selected.Add(skillId);
        else selected.Remove(skillId);
    }

    void ImportSelected(SkillMarketplace m)
    {
        if (browseIndex is null || selected.Count == 0) return;
        Marketplace.ImportSkills(m.Id, browseIndex, selected.ToList());
        selected.Clear();
    }

    async Task SyncNow(SkillMarketplace m)
    {
        if (syncingId is not null) return;
        syncingId = m.Id;
        marketError = null;
        try
        {
            await Marketplace.SyncAllAsync();
        }
        finally { syncingId = null; }
    }

    void RemoveMarketplace(SkillMarketplace m)
    {
        if (openMarketId == m.Id) CloseBrowse();
        Marketplace.RemoveMarketplace(m.Id);
    }

    bool IsImported(string marketplaceId, string skillId)
        => State.Profile.Skills.Any(s => s.SourceMarketplaceId == marketplaceId && s.SourceSkillId == skillId);

    string MarketNameFor(string? marketplaceId)
    {
        var m = State.Profile.SkillMarketplaces.FirstOrDefault(x => x.Id == marketplaceId);
        return m?.Name ?? "marketplace";
    }

    static string HostOf(string url)
        => Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host : url;

    public void Dispose()
    {
        State.Changed -= Refresh;
        editCts?.Cancel();
        editCts?.Dispose();
        catalogCts?.Cancel();
        catalogCts?.Dispose();
    }
}
