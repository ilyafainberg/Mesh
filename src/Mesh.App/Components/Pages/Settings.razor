@page "/settings"
@inject AppState State
@inject MeshClient Mesh
@inject MsalAuthService Msal
@inject FoundryLocalService Foundry
@inject CopilotAcpHost Copilot
@inject ModelSetupService Setup
@inject IHttpClientFactory HttpFactory
@inject UpdateService Updater
@inject IAppControl AppControl
@inject IAccountInstanceCoordinator AccountInstances
@inject RuntimeDiagnostics Diagnostics
@inject IJSRuntime JS
@implements IDisposable

<div class="pane-scroll">
    <div class="pane-narrow">
        <div class="pane-head" style="padding-left:0;padding-right:0;">
            <h2><i class="bi bi-gear"></i> Settings</h2>
        </div>

        <div class="card-panel">
            <h3>Identity</h3>
            <div class="field-row">
                <div><div class="field-label">Handle</div><div class="field-sub">how others add you</div></div>
                <b>@State.Profile.Handle</b>
            </div>
            <div class="field">
                <label>Display name</label>
                <input class="full" value="@display" @onchange="OnDisplayChanged" />
                <div class="field-hint">Shown to your contacts instead of your handle. Saved automatically.</div>
            </div>
            <h3>Link a device</h3>
            <div class="field-hint" style="margin-bottom:12px;">
                Add your phone or another computer to the same handle. On the other device, choose
                <b>Link an existing device</b> and enter this code. Single-use, expires in 5&nbsp;minutes.
            </div>
            @if (linkCode is null)
            {
                <button class="ghost" disabled="@linkWorking" @onclick="CreateInvite">
                    @(linkWorking ? "Generating..." : "Generate link code")
                </button>
                @if (linkError is not null) { <p class="err">@linkError</p> }
            }
            else
            {
                <div class="link-invite">
                    @if (qrDataUri is not null)
                    {
                        <img class="link-qr" src="@qrDataUri" alt="Link QR code" />
                    }
                    <div class="link-code-box">
                        <code class="link-code">@linkCode</code>
                        <div class="field-sub">Expires in @remaining s</div>
                    </div>
                </div>
                <button class="ghost" @onclick="ClearInvite">Done</button>
            }
            <h3>Linked devices</h3>
            <div class="field-hint" style="margin-bottom:12px;">
                Revoke a device you no longer control. Its relay queue is purged and it cannot reconnect with its old key.
            </div>
            <div style="display:flex;justify-content:flex-end;margin-bottom:8px;">
                <button class="ghost icon-btn" title="Refresh linked devices" aria-label="Refresh linked devices"
                        disabled="@loadingLinkedDevices" @onclick="LoadLinkedDevicesAsync">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            @if (loadingLinkedDevices)
            {
                <div class="field-hint">Loading linked devices...</div>
            }
            else if (linkedDeviceError is not null)
            {
                <p class="err">@linkedDeviceError</p>
            }
            else if (linkedDevices.Count == 0)
            {
                <div class="field-hint">No linked devices were returned by the relay.</div>
            }
            else
            {
                <div class="account-list">
                    @foreach (var device in linkedDevices.OrderBy(DeviceDisplayName, StringComparer.OrdinalIgnoreCase))
                    {
                        var isCurrentDevice = device.DeviceId == Mesh.MyDeviceId;
                        <div class="account-row @(isCurrentDevice ? "active" : "")">
                            <div class="account-info">
                                <i class="bi @DeviceIcon(device.Platform)"></i>
                                <div class="account-text">
                                    <b>@DeviceDisplayName(device)</b>
                                    <small class="muted">@DevicePlatform(device.Platform) - @(device.Online ? "online" : "offline") - protocol @device.ProtocolVersion</small>
                                    @if (revokeDeviceId == device.DeviceId)
                                    {
                                        <small class="muted">Device ID: <code>@device.DeviceId</code></small>
                                        <label class="field-hint">Enter <b>@RevokeSuffix(device.DeviceId)</b> to confirm this exact device.</label>
                                        <input value="@revokeConfirmation" @oninput="OnRevokeConfirmationChanged" autocomplete="off" />
                                        @if (revokeError is not null) { <small class="err">@revokeError</small> }
                                    }
                                </div>
                            </div>
                            <div class="account-actions">
                                @if (isCurrentDevice)
                                {
                                    <span class="vis shared">this device</span>
                                }
                                else if (revokeDeviceId == device.DeviceId)
                                {
                                    <button class="danger" disabled="@(!CanConfirmRevoke(device) || revokingDevice)"
                                            @onclick="() => ConfirmRevokeDeviceAsync(device)">
                                        @(revokingDevice ? "Revoking..." : "Revoke device")
                                    </button>
                                    <button class="ghost" disabled="@revokingDevice" @onclick="CancelRevokeDevice">Cancel</button>
                                }
                                else
                                {
                                    <button class="danger" disabled="@(!Mesh.SupportsDeviceRevocation || revokingDevice)"
                                            @onclick="() => BeginRevokeDevice(device)">Revoke</button>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (!Mesh.SupportsDeviceRevocation)
                {
                    <div class="field-hint">This relay does not support linked-device revocation yet.</div>
                }
            }
            <h3>Identities on this device</h3>
            <div class="field-hint" style="margin-bottom:12px;">
                Keep several handles on this device and switch between them without signing out of any.
            </div>
            <div class="account-list">
                @foreach (var a in State.Accounts)
                {
                    var isActive = a.Id == State.ActiveAccountId;
                    <div class="account-row @(isActive ? "active" : "")">
                        <div class="account-info">
                            <i class="bi bi-person-circle"></i>
                            <div class="account-text">
                                <b>@("@")@a.Handle</b>
                                @if (!string.IsNullOrWhiteSpace(a.DisplayName) && a.DisplayName != a.Handle)
                                {
                                    <small class="muted">@a.DisplayName</small>
                                }
                            </div>
                        </div>
                        <div class="account-actions">
                            @if (isActive)
                            {
                                <span class="vis shared">current</span>
                            }
                            else
                            {
                                <button class="ghost" disabled="@switching" @onclick="() => Switch(a)">Switch</button>
                            }
                            <button class="icon-btn" title="Copy a shareable link to this handle" aria-label="Copy share link" @onclick="() => ShareHandle(a)"><i class="bi bi-share"></i></button>
                            @if (copiedHandle == a.Handle)
                            {
                                <span class="vis shared" title="Link copied to clipboard">copied</span>
                            }
                            @if (deleteId == a.Id)
                            {
                                <button class="danger" @onclick="() => DeleteAccount(a)">Delete</button>
                                <button class="ghost icon-btn" @onclick="() => deleteId = null" title="Cancel" aria-label="Cancel"><i class="bi bi-x-lg"></i></button>
                            }
                            else
                            {
                                <button class="icon-btn" title="Remove from this device" @onclick="() => deleteId = a.Id" aria-label="Remove from this device"><i class="bi bi-trash"></i></button>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (switchError is not null)
            {
                <div class="err-text" role="alert">@switchError</div>
            }
            <h3>Sign out</h3>
            <div class="field-hint" style="margin-bottom:12px;">
                Sign out of <b>@("@")@State.Profile.Handle</b> and return to the account picker. Your identity
                stays saved on this device, you can switch back anytime, or add / link another handle.
                Nothing is deleted.
            </div>
            @if (!confirmSignOut)
            {
                <button class="ghost" @onclick="() => confirmSignOut = true">
                    <i class="bi bi-box-arrow-right"></i> Sign out / switch identity
                </button>
            }
            else
            {
                <div class="confirm-row">
                    <span class="muted">Sign out of @("@")@State.Profile.Handle? It stays saved on this device.</span>
                    <button class="primary" disabled="@signingOut" @onclick="SignOut">
                        @(signingOut ? "Signing out…" : "Sign out")
                    </button>
                    <button class="ghost" disabled="@signingOut" @onclick="() => confirmSignOut = false">Cancel</button>
                </div>
            }
        </div>

        <div class="card-panel">
            <h3>Model</h3>
            <div class="field">
                <label>Provider</label>
                <select class="full" value="@provider" @onchange="OnProviderChange">
                    <option value="MeshHosted">Mesh free model (no key)</option>
                    <option value="Anthropic">Anthropic (Claude)</option>
                    <option value="OpenAI">OpenAI</option>
                    <option value="Gemini">Google Gemini</option>
                    <option value="Grok">Grok (xAI)</option>
                    <option value="Groq">Groq (fast inference)</option>
                    <option value="OpenRouter">OpenRouter</option>
                    <option value="AzureOpenAI">Azure OpenAI</option>
                    @if (!PlatformCaps.IsMobile)
                    {
                        <option value="FoundryLocal">On Device</option>
                        @if (OperatingSystem.IsWindows())
                        {
                            <option value="Browser">Browser model (scripted)</option>
                        }
                        <option value="GitHubCopilot">GitHub Copilot CLI (ACP)</option>
                    }
                </select>
            </div>

            @if (provider == "MeshHosted")
            {
                <div class="field">
                    <div class="connector-note">
                        <i class="bi bi-gift"></i>
                        <span>The Mesh free model runs on a shared Mesh-hosted model, no API key needed. There is a daily token budget, so it can pause once that budget is used up for the day. Switch to your own key@(PlatformCaps.IsMobile ? "" : " or an on-device model") for unlimited use.</span>
                    </div>
                </div>
            }
            else if (provider == "GitHubCopilot")
            {
                <div class="field">
                    <div class="connector-note">
                        <i class="bi bi-github"></i>
                        <span>Desktop only. Uses your installed and signed-in GitHub Copilot CLI through ACP. Mesh does not store a GitHub token. Copilot native tools stay disabled; enabled Mesh tools remain available with their Mesh approval settings.</span>
                    </div>
                </div>
                <div class="field">
                    <label>Copilot command</label>
                    <input class="full" @bind="copilotExecutable" placeholder="copilot" autocomplete="off" />
                    <div class="field-hint">Use <code>copilot</code> when it is on PATH, or enter the full path to the executable or command file. Run <code>copilot login</code> in a terminal first.</div>
                </div>
                <div class="field">
                    <label>Model</label>
                    <div class="model-row">
                        <select class="full" value="@CopilotModelSelectValue" @onchange="OnCopilotModelSelect">
                            @if (copilotModels.Count == 0)
                            {
                                <option value="auto">Automatic (Copilot chooses)</option>
                            }
                            @foreach (var option in copilotModels)
                            {
                                <option value="@option.Id" disabled="@(!option.Enabled)">@CopilotModelLabel(option)</option>
                            }
                            <option value="__custom__">Custom model ID...</option>
                        </select>
                        <button class="ghost icon-btn" title="Refresh Copilot model list"
                                @onclick="() => LoadCopilotModelsAsync(force: true)"
                                disabled="@loadingCopilotModels"
                                aria-label="Refresh Copilot model list">
                            <i class="bi @(loadingCopilotModels ? "bi-hourglass-split" : "bi-arrow-repeat")"></i>
                        </button>
                    </div>
                    @if (copilotModelIsCustom)
                    {
                        <input class="full" style="margin-top:8px;" @bind="model" placeholder="Model ID, for example gpt-5.4" />
                    }
                    <div class="field-hint">
                        The list comes from the installed CLI and reflects models enabled for your Copilot account.
                        Automatic lets Copilot choose. Up to 3 Copilot topics run at the same time; additional Copilot
                        topics wait in a queue.
                    </div>
                    @if (!string.IsNullOrWhiteSpace(copilotModelsError))
                    {
                        <div class="err-text" role="alert">@copilotModelsError</div>
                    }
                </div>
                <div class="field">
                    <label>Reasoning effort</label>
                    <select class="full" @bind="copilotEffort">
                        <option value="Auto">Auto (Copilot default)</option>
                        <option value="None">None</option>
                        <option value="Minimal">Minimal</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="XHigh">Extra high</option>
                        <option value="Max">Maximum</option>
                    </select>
                    <div class="field-hint">Changing the model or effort restarts the local ACP process for the next response.</div>
                </div>
            }
            else if (provider == "FoundryLocal")
            {
                    <div class="field">
                        <label>Model</label>
                        <div class="model-row">
                            <select class="full" @bind="model">
                                @if (!string.IsNullOrWhiteSpace(model) && !foundryModels.Any(m => m.Id == model))
                                {
                                    <option value="@model">@model (current)</option>
                                }
                                @foreach (var m in foundryModels)
                                {
                                    <option value="@m.Id">@m.Label</option>
                                }
                            </select>
                            <button class="ghost icon-btn" title="Refresh model list" @onclick="RefreshModels" disabled="@loadingModels" aria-label="Refresh model list">
                                <i class="bi @(loadingModels ? "bi-hourglass-split" : "bi-arrow-repeat")"></i>
                            </button>
                        </div>
                    <div class="field-hint">
                        Runs on this device, no key, no cost. Only tool-capable models are listed.
                        Your pick is downloaded and started automatically when you Save (first time can take a while).
                    </div>
                    <div class="field-hint star-note">
                        <span class="stars">★★★★★</span> = most capable. More stars mean a bigger, smarter model that needs better hardware (more RAM/CPU); fewer stars run faster on modest machines.
                    </div>
                    @if (loadingModels)
                    {
                        <div class="field-hint"><i class="bi bi-hourglass-split"></i> Finding on-device models…</div>
                    }
                    else if (foundryModels.Count == 0)
                    {
                        <div class="connector-note">
                            <i class="bi bi-cpu"></i>
                            <span>Couldn't list on-device models yet. Foundry Local will be installed and started when you Save; smaller models load fastest.</span>
                        </div>
                    }
                </div>
            }
            else if (provider == "Browser")
            {
                <div class="field">
                    <div class="connector-note">
                        <i class="bi bi-window"></i>
                        <span>Windows only. Mesh opens a dedicated persistent browser on first use in every Mesh session. Sign in, return to Mesh, and select OK. Scripts run inside the provider page and can read anything rendered there.</span>
                    </div>
                </div>
                <div class="field">
                    <label>Browser</label>
                    <select class="full" @bind="browserEngine">
                        <option value="Firefox">Firefox (recommended)</option>
                        <option value="Chrome">Chrome</option>
                        <option value="Edge">Edge</option>
                    </select>
                    <div class="field-hint">Firefox uses Playwright Firefox. Chrome and Edge use their installed Playwright channels.</div>
                </div>
                <div class="field">
                    <label>Preset file</label>
                    <InputFile OnChange="LoadBrowserPreset" accept=".json,application/json" />
                    <div class="field-hint">Load a .json browser-provider preset. Review its scripts before saving because presets contain executable JavaScript.</div>
                    @if (!string.IsNullOrWhiteSpace(browserPresetStatus))
                    {
                        <div class="field-hint">@browserPresetStatus</div>
                    }
                </div>
                <div class="field">
                    <label>Start URL</label>
                    <input class="full" @bind="browserUrl" placeholder="https://example.com/chat" />
                </div>
                <div class="field">
                    <label>Context sent to website</label>
                    <select class="full" @bind="browserContextMode">
                        <option value="CurrentTurn">Current user message only</option>
                        <option value="FullPrompt">Full Mesh prompt and history</option>
                    </select>
                    <div class="field-hint">Current turn keeps context separately in Mesh and in the website conversation. Use one website conversation per Mesh thread to avoid mixing contexts.</div>
                </div>
                <div class="field">
                    <label>Execute prompt</label>
                    <textarea class="full" rows="7" @bind="browserExecuteScript" spellcheck="false"></textarea>
                    <div class="field-hint">Async JavaScript function accepting request: prompt, systemPrompt, messages, skills, tools, metadata.</div>
                </div>
                <div class="field">
                    <label>Poll for response</label>
                    <textarea class="full" rows="6" @bind="browserPollScript" spellcheck="false"></textarea>
                    <div class="field-hint">Runs every 5 seconds by default. Return true/false or status: pending, complete, authentication-required, error.</div>
                </div>
                <div class="field">
                    <label>Get result</label>
                    <textarea class="full" rows="6" @bind="browserResultScript" spellcheck="false"></textarea>
                    <div class="field-hint">Return a string or an object such as { text: "reply" }.</div>
                </div>
                <div class="field-row">
                    <div class="field"><label>Poll seconds</label><input type="number" min="1" max="60" @bind="browserPollSeconds" /></div>
                    <div class="field"><label>Timeout minutes</label><input type="number" min="1" max="120" @bind="browserTimeoutMinutes" /></div>
                </div>
            }
            else if (provider == "OpenRouter")
            {
                <div class="field">
                    <div class="connector-note">
                        <i class="bi bi-shuffle"></i>
                        <span>OpenRouter picks the model and provider based on your OpenRouter account settings. Mesh shows the provider-reported model on each new Topic reply. A model's own answer about its identity may be wrong.</span>
                    </div>
                </div>
                <div class="field">
                    <label>API key</label>
                    <input class="full" type="password" @bind="apiKey" placeholder="(unchanged)" />
                </div>
            }
            else
            {
                @if (CatalogOptions.Count > 0)
                {
                    <div class="field">
                        <label>Model</label>
                        <select class="full" value="@ModelSelectValue" @onchange="OnModelSelect">
                            @foreach (var opt in CatalogOptions)
                            {
                                <option value="@opt.Id">@opt.Label</option>
                            }
                            <option value="__custom__">Custom...</option>
                        </select>
                        @if (modelIsCustom)
                        {
                            <input class="full" style="margin-top:8px;" @bind="model" placeholder="@ModelPlaceholder" />
                        }
                    </div>
                }
                else
                {
                    <div class="field">
                        <label>@(provider == "AzureOpenAI" ? "Deployment name" : "Model")</label>
                        <input class="full" @bind="model" placeholder="@ModelPlaceholder" />
                    </div>
                }
                @if (provider == "OpenAI")
                {
                    <div class="field">
                        <label>Endpoint <span class="muted">(optional)</span></label>
                        <input class="full" @bind="endpoint" placeholder="https://api.openai.com" />
                    </div>
                }
                @if (provider == "AzureOpenAI")
                {
                    <div class="field">
                        <label>Endpoint</label>
                        <input class="full" @bind="endpoint" placeholder="https://your-resource.openai.azure.com" />
                        <div class="field-hint">Your Azure OpenAI resource URL. The Deployment name above is your model deployment, not the base model name.</div>
                    </div>
                    <div class="field">
                        <label>API version <span class="muted">(optional)</span></label>
                        <input class="full" @bind="apiVersion" placeholder="leave blank for the current API" />
                        <div class="field-hint">Leave blank to use Azure OpenAI's current API (recommended). Only set a dated version (e.g. 2024-10-21) if your resource requires the older deployment API.</div>
                    </div>
                }
                <div class="field">
                    <label>API key</label>
                    <input class="full" type="password" @bind="apiKey" placeholder="(unchanged)" />
                </div>
            }

            @if (provider is not "MeshHosted" and not "Browser" and not "FoundryLocal" and not "GitHubCopilot")
            {
                <div class="field">
                    <label>Reasoning effort</label>
                    <select class="full" @bind="reasoningEffort">
                        <option value="Auto">Auto (model default)</option>
                        <option value="Low">Low (faster)</option>
                        <option value="Medium">Medium (balanced)</option>
                        <option value="High">High (deeper reasoning)</option>
                    </select>
                    <div class="field-hint">Controls reasoning intensity separately from the response length. The selected model must support this setting.</div>
                </div>
            }

            <div class="field token-optimization-field">
                <div class="token-optimization-heading">
                    <label for="token-optimization">Token Optimization</label>
                    <span class="token-optimization-value">@TokenOptimizationLabel</span>
                </div>
                <div class="token-optimization-control" style="--token-opt-progress: @TokenOptimizationProgress;">
                    <input id="token-optimization" class="token-optimization-slider" type="range"
                           min="0" max="3" step="1" value="@tokenOptimizationIndex"
                           @oninput="OnTokenOptimizationInput"
                           aria-valuetext="@TokenOptimizationLabel"
                           aria-describedby="token-optimization-hint" />
                    <div class="token-optimization-options">
                        <button type="button" class="token-optimization-option @(tokenOptimizationIndex == 0 ? "active" : "")"
                                @onclick="() => tokenOptimizationIndex = 0">Disabled</button>
                        <button type="button" class="token-optimization-option @(tokenOptimizationIndex == 1 ? "active" : "")"
                                @onclick="() => tokenOptimizationIndex = 1">Max Accuracy</button>
                        <button type="button" class="token-optimization-option @(tokenOptimizationIndex == 2 ? "active" : "")"
                                @onclick="() => tokenOptimizationIndex = 2">
                            <span>Balanced</span>
                            <small>Recommended</small>
                        </button>
                        <button type="button" class="token-optimization-option @(tokenOptimizationIndex == 3 ? "active" : "")"
                                @onclick="() => tokenOptimizationIndex = 3">Max Savings</button>
                    </div>
                </div>
                <div id="token-optimization-hint" class="field-hint">
                    @TokenOptimizationDescription Mesh only shortens the temporary copy sent to the AI. Your encrypted chats and saved data are not changed.
                </div>
            </div>

            <div class="field" style="margin-top:8px;">
                <button class="primary" @onclick="ChangeModel" disabled="@Setup.Running">
                    <i class="bi bi-check-lg"></i> @(Setup.Running ? "Working…" : "Change model")
                </button>
                @if (Setup.Running)
                {
                    <div class="setup-status running" style="margin-top:12px;">
                        <span class="spinner"></span>
                        <span>@(Setup.Status ?? "Working…")</span>
                    </div>
                }
                else if (Setup.Success is not null)
                {
                    <div class="setup-status @(Setup.Success == true ? "ok" : "err")" style="margin-top:12px;">
                        <i class="bi @(Setup.Success == true ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
                        <span>@Setup.Status</span>
                    </div>
                }
            </div>
        </div>

        <div class="card-panel">
            <h3>Usage report</h3>
            <div class="field" style="margin-top:4px;">
                <label>Token usage</label>
                <TokenMeter />
                <div class="tm-actions" style="margin-top:8px;">
                    <button class="ghost" @onclick="ResetCounter"><i class="bi bi-arrow-counterclockwise"></i> Reset counter</button>
                </div>
                <div class="field-hint">
                    Counts reset automatically when you switch models. The free hosted model has a daily
                    token budget, so it can pause once that budget is used up for the day.
                </div>
            </div>

            <div class="field-row">
                <div>
                    <div class="field-label">Estimated spend</div>
                    <div class="field-sub">Approximate cost of your usage, based on the model's published prices. Actual billing comes from your provider.</div>
                </div>
                <span>@SpendLabel</span>
            </div>
        </div>

        <div class="card-panel">
            <h3>Agent responses</h3>
            <div class="field">
                <label>Approval before replying</label>
                <select class="full" value="@approvalMode" @onchange="OnApprovalChanged">
                    <option value="Off">Auto-reply (no approval)</option>
                    <option value="PerCircle">Approve per circle (uses circle settings)</option>
                    <option value="All">Approve every reply</option>
                </select>
                <div class="field-hint">When on, your agent drafts a reply and waits for you on the Messages page before sending.</div>
            </div>
            <div class="field">
                <label>Primary agent response device</label>
                @if (!Mesh.SupportsAgentHost)
                {
                    <div class="field-hint">This relay does not support single-device agent responses. Update the relay to configure this setting.</div>
                }
                else
                {
                    <div class="model-row">
                        <select class="full" value="@primaryAgentDeviceId" @onchange="OnPrimaryAgentDeviceChanged"
                                disabled="@(loadingAgentRouting || savingAgentRouting || AgentRoutingDevices.Count == 0)">
                            @if (AgentRoutingDevices.Count == 0)
                            {
                                <option value="">No compatible desktop device</option>
                            }
                            @foreach (var device in AgentRoutingDevices)
                            {
                                <option value="@device.DeviceId">@AgentDeviceLabel(device)</option>
                            }
                        </select>
                        <button class="ghost icon-btn" title="Refresh devices" aria-label="Refresh agent response devices"
                                disabled="@(loadingAgentRouting || savingAgentRouting)" @onclick="LoadAgentRoutingAsync">
                            <i class="bi @(loadingAgentRouting ? "bi-hourglass-split" : "bi-arrow-repeat")"></i>
                        </button>
                    </div>
                    <div class="field-hint">
                        The first compatible desktop is selected automatically. Only this device runs and answers each agent question.
                    </div>
                }
            </div>
            @if (Mesh.SupportsAgentHost)
            {
                <div class="field">
                    <label>Failover response device</label>
                    <select class="full" value="@failoverAgentDeviceId" @onchange="OnFailoverAgentDeviceChanged"
                            disabled="@(loadingAgentRouting || savingAgentRouting || string.IsNullOrWhiteSpace(primaryAgentDeviceId))">
                        <option value="">None</option>
                        @foreach (var device in AgentRoutingDevices.Where(device => device.DeviceId != primaryAgentDeviceId))
                        {
                            <option value="@device.DeviceId">@AgentDeviceLabel(device)</option>
                        }
                    </select>
                    <div class="field-hint">Used only when the primary is offline or cannot run its configured model. Choose None to keep questions queued for the primary.</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(agentRoutingError))
                {
                    <div class="err-text" role="alert">@agentRoutingError</div>
                }
            }
            <div class="field-row">
                <div>
                    <div class="field-label">Plan before acting</div>
                    <div class="field-sub">Generate and show a concise action plan before each standard topic turn in Me. Uses an extra model request, so responses may take longer and use more MTokens or Copilot premium requests.</div>
                </div>
                <label class="switch">
                    <input type="checkbox"
                           checked="@State.Profile.PlanBeforeActing"
                           @onchange="e => Toggle(p => p.PlanBeforeActing = (bool)(e.Value ?? false))"
                           aria-label="Plan before acting in Me topics" />
                </label>
            </div>
            <div class="field-row">
                <div>
                    <div class="field-label">Interactive apps</div>
                    <div class="field-sub">Let agents send interactive mini-apps in messages. They run sandboxed and never auto-run.</div>
                </div>
                <label class="switch"><input type="checkbox" checked="@allowApps" @onchange="OnAllowAppsChanged" aria-label="Interactive apps" /></label>
            </div>
            <div class="field-row">
                <div>
                    <div class="field-label">Do not disturb</div>
                    <div class="field-sub">Suppress all popup notifications. In-app badges still update.</div>
                </div>
                <label class="switch"><input type="checkbox" checked="@State.Profile.DoNotDisturb" @onchange="OnDoNotDisturbChanged" aria-label="Do not disturb" /></label>
            </div>
            <div class="field-row">
                <div>
                    <div class="field-label">Notification sound</div>
                    <div class="field-sub">Play the operating system notification sound for Mesh activity.</div>
                </div>
                <label class="switch"><input type="checkbox" checked="@State.Profile.NotificationSound" @onchange="e => Toggle(p => p.NotificationSound = (bool)(e.Value ?? false))" aria-label="Notification sound" /></label>
            </div>
            <div class="field">
                <label>This device's name</label>
                <input class="full" value="@State.Profile.DeviceName" @onchange="OnDeviceNameChanged" />
                <div class="field-hint">Linked devices use this name in the Topic device chooser.</div>
            </div>
            @if (registrationError is not null)
            {
                <div class="err-text" role="alert">@registrationError</div>
            }
        </div>

        <div class="card-panel">
            <h3>Agent budget</h3>
            <div class="field">
                <label>Automatic replies per day</label>
                <input class="full" type="number" min="0" value="@replyBudget" @onchange="OnBudgetChanged" />
                <div class="field-hint">
                    Cap how many automatic agent replies run per day. Each reply calls your model, so this protects
                    your usage and cost. Set to 0 for unlimited.
                </div>
            </div>
            <div class="field-row">
                <div class="field-label">Used today</div>
                <span>@BudgetUsageLabel</span>
            </div>
        </div>

        <div class="card-panel">
            <h3>Relay</h3>
            <div class="field">
                <label>Relay URL</label>
                <div class="model-row">
                    <input class="full" value="@relay" @onchange="OnRelayChanged" aria-label="Relay URL" />
                    <button class="ghost" @onclick="TestRelay" disabled="@testingRelay" title="Check this relay is reachable">
                        @(testingRelay ? "Testing…" : "Test")
                    </button>
                </div>
                @if (relayTestMsg is not null) { <div class="field-hint @(relayTestOk ? "" : "err-text")">@relayTestMsg</div> }
                <div class="field-hint">
                    The default relay is run by Mesh. You can run your own, or use anyone's:
                    the relay is open source (see the About page). A handle is registered per relay,
                    so switching relays re-registers your handle there. Changes apply automatically.
                </div>
            </div>
            <div class="field-row">
                <div class="field-label">Status</div>
                <span class="@(Mesh.Connected ? "on" : "off")">
                    <i class="bi @(Mesh.Connected ? "bi-check-circle-fill" : "bi-circle")"></i>
                    @(Mesh.Connected ? "connected" : "offline")
                </span>
            </div>
        </div>

        @if (Updater.IsSupported)
        {
        <div class="card-panel">
            <h3>Updates</h3>
            <div class="field-row">
                <div class="field-label">Current version</div>
                <span>@Updater.CurrentVersion.ToString(3)</span>
            </div>

            @if (Updater.Available is { } availableUpdate)
            {
                @if (Updater.Phase == UpdatePhase.Downloading || Updater.Phase == UpdatePhase.Extracting
                     || Updater.Phase == UpdatePhase.Preparing || Updater.Phase == UpdatePhase.Applying)
                {
                    <div class="field">
                        <div class="update-progress-head">
                            <span>@(Updater.Status ?? "Preparing update.")</span>
                            @if (Updater.Percent >= 0) { <span>@Updater.Percent%</span> }
                        </div>
                        <div class="progress-track" role="progressbar"
                             aria-valuenow="@(Updater.Percent < 0 ? 0 : Updater.Percent)" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-fill @(Updater.Percent < 0 ? "indeterminate" : "")"
                                 style="@(Updater.Percent >= 0 ? $"width:{Updater.Percent}%" : "")"></div>
                        </div>
                        @if (Updater.TotalBytes > 0)
                        {
                            <div class="field-hint">@FormatMb(Updater.BytesReceived) of @FormatMb(Updater.TotalBytes) MB</div>
                        }
                    </div>
                }

                <div class="field">
                    <div class="update-avail">
                        <i class="bi bi-arrow-up-circle-fill"></i>
                        Version @availableUpdate.Version.ToString(3) is available.
                    </div>
                    @if (!string.IsNullOrWhiteSpace(availableUpdate.ReleaseNotes))
                    {
                        <details class="update-notes">
                            <summary>What's new</summary>
                            <div class="notes-md">@((MarkupString)global::Mesh.App.Services.Markdown.ToHtml(availableUpdate.ReleaseNotes))</div>
                        </details>
                    }
                    @if (Updater.Phase == UpdatePhase.ReadyToApply)
                    {
                        <div class="field-hint">The setup file is ready. Update closes Mesh, installs silently, and reopens it.</div>
                    }
                    else if (Updater.Phase == UpdatePhase.Failed)
                    {
                        <div class="field-hint err-text">@Updater.Error</div>
                    }
                    else if (Updater.IsLaunchRequested)
                    {
                        <div class="field-hint">Mesh will start the updater as soon as the setup file is ready.</div>
                    }
                    else if (Updater.Phase == UpdatePhase.Downloading || Updater.Phase == UpdatePhase.Extracting
                             || Updater.Phase == UpdatePhase.Preparing)
                    {
                        <div class="field-hint">Mesh is preparing this update in the background.</div>
                    }
                    <div class="model-row">
                        <button class="primary" @onclick="StartUpdate" disabled="@Updater.IsLaunchRequested">@Updater.ActionText</button>
                        @if (availableUpdate.HtmlUrl is not null)
                        {
                            <button class="ghost" @onclick="() => OpenUrl(availableUpdate.HtmlUrl)">View release</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="field">
                    <div class="model-row">
                        <button class="ghost" @onclick="CheckUpdate" disabled="@checkingUpdate">
                            @(checkingUpdate ? "Checking..." : "Check for updates")
                        </button>
                    </div>
                    @if (updateStatus is not null)
                    {
                        <div class="field-hint @(updateFailed ? "err-text" : "")">@updateStatus</div>
                    }
                </div>
            }
        </div>
        }
        @if (AppControl.IsLaunchAtStartupEnabled() || OperatingSystem.IsWindows())
        {
        <div class="card-panel">
            <h3>Application</h3>
            <div class="field-row">
                <div>
                    <div class="field-label">Launch at startup</div>
                    <div class="field-sub">Start Mesh automatically when you sign in to Windows. It opens minimized to the system tray.</div>
                </div>
                <label class="switch"><input type="checkbox" checked="@launchAtStartup" @onchange="OnToggleStartup" aria-label="Launch at startup" /></label>
            </div>
        </div>
        }
        <div class="card-panel">
            <h3>Diagnostics</h3>
            <div class="field-hint" style="margin-bottom:12px;">
                Mesh keeps a small technical UI, lifecycle, and crash log on this device. It does not intentionally add
                message text, prompts, keys, or tool arguments.
                @if (OperatingSystem.IsIOS())
                {
                    <span> Apple crash and hang diagnostics can arrive after the next launch.</span>
                }
            </div>
            @if (Diagnostics.PreviousSessionEndedUnexpectedly)
            {
                <div class="field-hint err-text" style="margin-bottom:12px;">
                    The previous session ended unexpectedly while the app was @Diagnostics.PreviousSessionPhase.
                    Copy diagnostics and include them with the crash report.
                </div>
            }
            <div class="model-row" style="flex-wrap:wrap;">
                <button class="ghost" @onclick="CopyDiagnostics">
                    <i class="bi bi-clipboard"></i> Copy diagnostics
                </button>
                <button class="ghost" @onclick="RunWidgetSelfTest" disabled="@widgetSelfTestRunning">
                    <i class="bi bi-window"></i> @(widgetSelfTestRunning ? "Testing widget..." : "Run widget self-test")
                </button>
                <button class="ghost" @onclick="CopyWidgetDiagnostics">
                    <i class="bi bi-clipboard-check"></i> Copy widget diagnostics
                </button>
                <button class="ghost" @onclick="ClearDiagnostics">
                    Clear
                </button>
            </div>
            @if (widgetSelfTestVisible)
            {
                <div class="app-frame" style="height:190px;min-height:190px;resize:none;margin-top:12px;">
                    <iframe @ref="widgetSelfTestFrame"
                            sandbox="allow-scripts"
                            referrerpolicy="no-referrer"
                            title="Widget renderer self-test"></iframe>
                    <div class="widget-render-status" hidden aria-live="polite"></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(widgetSelfTestStatus))
                {
                    <div class="field-hint" role="status">@widgetSelfTestStatus</div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(diagnosticsStatus))
            {
                <div class="field-hint">@diagnosticsStatus</div>
            }
        </div>


    </div>
</div>

@code {
    string display = "";
    string relay = "";
    string provider = "Anthropic";
    string model = "";
    string endpoint = "";
    string apiKey = "";
    string apiVersion = "";
    string reasoningEffort = "Auto";
    int tokenOptimizationIndex = (int)TokenOptimizationLevel.Balanced;
    string copilotExecutable = "copilot";
    string copilotEffort = "Auto";
    string browserEngine = "Firefox";
    string browserContextMode = "FullPrompt";
    string browserPresetStatus = "";
    string browserUrl = "";
    string browserExecuteScript = "async request => {\n  // Enter request.prompt and submit it.\n  throw new Error('Configure Execute prompt');\n}";
    string browserPollScript = "async state => {\n  // Return true when generation is complete.\n  return false;\n}";
    string browserResultScript = "async state => {\n  // Return the final response text.\n  return { text: '' };\n}";
    int browserPollSeconds = 5;
    int browserTimeoutMinutes = 10;
    string approvalMode = "PerCircle";
    bool allowApps = true;
    int replyBudget = 100;
    List<Mesh.Shared.DeviceInfo> agentDevices = new();
    List<Mesh.Shared.DeviceInfo> linkedDevices = new();
    bool loadingLinkedDevices;
    bool linkedDevicesAttempted;
    bool revokingDevice;
    string? linkedDeviceError;
    string? revokeDeviceId;
    string? revokeError;
    string revokeConfirmation = "";
    string primaryAgentDeviceId = "";
    string failoverAgentDeviceId = "";
    bool loadingAgentRouting;
    bool savingAgentRouting;
    bool agentRoutingAttempted;
    string? agentRoutingError;
    string? diagnosticsStatus;
    ElementReference widgetSelfTestFrame;
    bool widgetSelfTestVisible;
    bool widgetSelfTestPending;
    bool widgetSelfTestRunning;
    string? widgetSelfTestStatus;

    private const string WidgetSelfTestHtml =
        "<!doctype html><html><head><meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<style>html,body{margin:0;min-height:100%;font:16px system-ui,sans-serif}" +
        "body{display:grid;place-items:center;background:#fff4ce;color:#5c4813;text-align:center}" +
        "body[data-mesh-self-test='script-ok']{background:#dff6dd;color:#14532d}" +
        ".card{padding:24px;border:1px solid currentColor;border-radius:12px;max-width:320px}" +
        "strong{display:block;font-size:18px;margin-bottom:6px}</style></head>" +
        "<body data-mesh-self-test='pending'><main class='card'><strong id='result'>Renderer loaded</strong>" +
        "<span>Checking script execution and first paint...</span></main>" +
        "<script>document.body.dataset.meshSelfTest='script-ok';" +
        "document.getElementById('result').textContent='Widget rendering works';</script></body></html>";

    IReadOnlyList<Mesh.Shared.DeviceInfo> AgentRoutingDevices => agentDevices
        .Where(device => device.IsDesktop && device.AgentHostEnabled)
        .ToList();

    string BudgetUsageLabel => replyBudget <= 0
        ? "Unlimited"
        : $"{State.Profile.AgentRepliesUsedToday} of {replyBudget}";

    List<FoundryModel> foundryModels = new();
    bool loadingModels;
    List<CopilotModelOption> copilotModels = new();
    bool loadingCopilotModels;
    bool copilotModelIsCustom;
    string? copilotModelsError;

    string? linkCode;
    string? qrDataUri;
    string? linkError;
    bool linkWorking;
    int remaining;
    System.Threading.Timer? linkTimer;

    bool confirmSignOut;
    bool signingOut;
    bool switching;
    string? deleteId;
    string? switchError;

    // ---- local tools ----
    // Moved to /tools page (Tools.razor). Methods below removed.

    async Task SignOut()
    {
        signingOut = true;
        try
        {
            await Mesh.UnregisterPushAsync();
            await Mesh.DisconnectAsync();
            State.SignOut(); // keeps the identity saved; returns app to the picker
        }
        finally { signingOut = false; }
    }

    async Task Switch(AccountRef a)
    {
        if (a.Id == State.ActiveAccountId || switching) return;
        switchError = null;
        switching = true;
        try
        {
            using var reservation = AccountInstances.Reserve(a);
            if (!reservation.Acquired)
            {
                switchError = reservation.Error
                    ?? "This identity is already running in another Mesh instance.";
                return;
            }
            await Mesh.DisconnectAsync();
            if (reservation.Commit(() => State.SwitchAccount(a.Id)))
            {
                SyncFields();
                await Mesh.RegisterAsync();
                await Mesh.ConnectAsync();
                linkedDevicesAttempted = false;
                await LoadLinkedDevicesAsync();
                await LoadAgentRoutingAsync();
            }
            else
                switchError = "That identity could not be loaded.";
        }
        catch (Exception ex) { switchError = ex.Message; }
        finally { switching = false; }
    }

    // Copies a public, shareable web link to this handle to the clipboard (works for anyone: the
    // meshrelay.net landing page bounces to the mesh:// deep link or offers install).
    string? copiedHandle;
    async Task ShareHandle(AccountRef a)
    {
        try
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(UniversalLink.ForHandle(a.Handle));
            copiedHandle = a.Handle;
            StateHasChanged();
            await Task.Delay(2000);
            if (copiedHandle == a.Handle) { copiedHandle = null; StateHasChanged(); }
        }
        catch { /* clipboard is best-effort */ }
    }

    void RunWidgetSelfTest()
    {
        if (widgetSelfTestRunning) return;
        widgetSelfTestVisible = true;
        widgetSelfTestPending = true;
        widgetSelfTestRunning = true;
        widgetSelfTestStatus = "Starting the secure widget renderer...";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!widgetSelfTestPending) return;
        widgetSelfTestPending = false;
        try
        {
            var result = await JS.InvokeAsync<string>(
                "sandboxFrame.runSelfTest",
                widgetSelfTestFrame,
                WidgetSelfTestHtml,
                PlatformCaps.DevicePlatform) ?? "failed:no-result";
            if (result.StartsWith("passed:", StringComparison.Ordinal))
            {
                var mode = result["passed:".Length..];
                widgetSelfTestStatus = $"Widget self-test passed using the {mode} renderer.";
            }
            else
            {
                var reason = result.StartsWith("failed:", StringComparison.Ordinal)
                    ? result["failed:".Length..].Replace('-', ' ')
                    : "unknown result";
                widgetSelfTestStatus = $"Widget self-test failed: {reason}. Copy widget diagnostics and include them with the report.";
            }
        }
        catch (Exception ex)
        {
            Diagnostics.RecordException("widget-self-test", ex);
            widgetSelfTestStatus = "Widget self-test could not run: " + ex.Message;
        }
        finally
        {
            widgetSelfTestRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task CopyDiagnostics()
    {
        try
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(
                Diagnostics.CreateReport());
            diagnosticsStatus = "Diagnostics copied. Paste them into the crash report.";
        }
        catch (Exception ex)
        {
            Diagnostics.RecordException("diagnostics-copy", ex);
            diagnosticsStatus = "Could not copy diagnostics: " + ex.Message;
        }
    }

    async Task CopyWidgetDiagnostics()
    {
        try
        {
            var rendererReport = await JS.InvokeAsync<string>("sandboxFrame.getDiagnostics")
                ?? "Mesh widget diagnostics were unavailable.";
            var report = rendererReport + Environment.NewLine + Environment.NewLine + Diagnostics.CreateReport();
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(report);
            diagnosticsStatus = "Widget diagnostics copied. Paste them into the widget report.";
        }
        catch (Exception ex)
        {
            Diagnostics.RecordException("widget-diagnostics-copy", ex);
            diagnosticsStatus = "Could not copy widget diagnostics: " + ex.Message;
        }
    }

    async Task ClearDiagnostics()
    {
        try
        {
            Diagnostics.Clear();
            await JS.InvokeVoidAsync("sandboxFrame.clearDiagnostics");
            diagnosticsStatus = "Diagnostics cleared.";
        }
        catch (Exception ex)
        {
            Diagnostics.RecordException("diagnostics-clear", ex);
            diagnosticsStatus = "Could not clear diagnostics: " + ex.Message;
        }
    }

    async Task DeleteAccount(AccountRef a)
    {
        deleteId = null;
        var wasActive = a.Id == State.ActiveAccountId;

        // Release the handle on the relay first, so the name is freed and can be re-created. Signed
        // with this identity's own key: the relay only honors it if this device's key is the one
        // registered under the handle (a stranded duplicate simply won't be authorized, which is
        // correct, it never owned the name). Best-effort: a relay error still deletes locally.
        var keys = State.PeekIdentityKeys(a.Id);
        if (keys is { } k && !string.IsNullOrWhiteSpace(k.handle))
            await Mesh.DeleteHandleAsync(k.handle, k.privateKey, k.publicKey);

        if (wasActive) await Mesh.DisconnectAsync();
        State.DeleteAccount(a.Id);
        if (wasActive) SyncFields(); // active cleared → app shows the picker
    }

    // On mobile, Foundry Local (On Device) cannot run, so a persisted FoundryLocal profile is coerced
    // to the safe hosted default for the UI. Saving keeps that coerced value.
    string EffectiveProvider(ModelProvider pv)
        => PlatformCaps.IsMobile && pv is ModelProvider.FoundryLocal or ModelProvider.GitHubCopilot
            ? nameof(ModelProvider.MeshHosted)
            : pv.ToString();

    void SyncFields()
    {
        var p = State.Profile;
        display = p.DisplayName;
        relay = p.RelayUrl;
        provider = EffectiveProvider(p.Model.Provider);
        model = p.Model.Model;
        endpoint = p.Model.Endpoint ?? "";
        apiVersion = p.Model.ApiVersion ?? "";
        reasoningEffort = p.Model.ReasoningEffort.ToString();
        tokenOptimizationIndex = (int)TokenOptimizer.Normalize(p.Model.TokenOptimization);
        copilotExecutable = string.IsNullOrWhiteSpace(p.Model.CopilotExecutable) ? "copilot" : p.Model.CopilotExecutable;
        copilotEffort = p.Model.CopilotEffort.ToString();
        browserEngine = string.IsNullOrWhiteSpace(p.Model.BrowserEngine) ? "Firefox" : p.Model.BrowserEngine;
        browserContextMode = string.Equals(p.Model.BrowserContextMode, "CurrentTurn", StringComparison.OrdinalIgnoreCase) ? "CurrentTurn" : "FullPrompt";
        browserUrl = p.Model.BrowserUrl ?? "";
        browserExecuteScript = p.Model.BrowserExecuteScript ?? browserExecuteScript;
        browserPollScript = p.Model.BrowserPollScript ?? browserPollScript;
        browserResultScript = p.Model.BrowserResultScript ?? browserResultScript;
        browserPollSeconds = p.Model.BrowserPollSeconds;
        browserTimeoutMinutes = p.Model.BrowserTimeoutMinutes;
        approvalMode = p.ApprovalMode.ToString();
        allowApps = p.AllowInteractiveApps;
        replyBudget = p.AgentDailyReplyBudget;
        primaryAgentDeviceId = p.AgentPrimaryDeviceId ?? "";
        failoverAgentDeviceId = p.AgentFailoverDeviceId ?? "";
        SyncModelCustomFlag();
    }

    TokenOptimizationLevel SelectedTokenOptimization =>
        TokenOptimizer.Normalize((TokenOptimizationLevel)Math.Clamp(tokenOptimizationIndex, 0, 3));

    string TokenOptimizationLabel => SelectedTokenOptimization switch
    {
        TokenOptimizationLevel.Disabled => "Disabled",
        TokenOptimizationLevel.MaxAccuracy => "Max Accuracy",
        TokenOptimizationLevel.Balanced => "Balanced",
        _ => "Max Savings"
    };

    string TokenOptimizationProgress => SelectedTokenOptimization switch
    {
        TokenOptimizationLevel.Disabled => "0%",
        TokenOptimizationLevel.MaxAccuracy => "33.333%",
        TokenOptimizationLevel.Balanced => "66.667%",
        _ => "100%"
    };

    string TokenOptimizationDescription => SelectedTokenOptimization switch
    {
        TokenOptimizationLevel.Disabled => "Uses the normal context window without extra compaction.",
        TokenOptimizationLevel.MaxAccuracy => "Keeps the most context and only removes obvious machine-generated repetition.",
        TokenOptimizationLevel.Balanced => "Keeps recent and relevant context while trimming repetition and oversized results.",
        _ => "Uses the smallest relevant context and the strongest result compaction."
    };

    void OnTokenOptimizationInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
            tokenOptimizationIndex = Math.Clamp(value, 0, 3);
    }

    string ModelPlaceholder=> provider switch
    {
        "Anthropic" => "claude-sonnet-4-6",
        "Gemini" => "gemini-1.5-flash",
        "Grok" => "grok-2-latest",
        "Groq" => "llama-3.3-70b-versatile",
        "AzureOpenAI" => "my-gpt-4o-mini (deployment name)",
        "GitHubCopilot" => "auto",
        _ => "gpt-4o-mini"
    };

    // ---- model dropdown (curated catalog per provider) ----
    bool modelIsCustom;

    IReadOnlyList<ModelCatalog.ModelOption> CatalogOptions =>
        Enum.TryParse<ModelProvider>(provider, out var pv) ? ModelCatalog.For(pv) : Array.Empty<ModelCatalog.ModelOption>();

    // The <select> value: the current model id when it is in the catalog, else the Custom sentinel.
    string ModelSelectValue =>
        (!modelIsCustom && CatalogOptions.Any(o => o.Id == model)) ? model : "__custom__";

    void OnModelSelect(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        if (v == "__custom__") { modelIsCustom = true; }
        else { modelIsCustom = false; model = v; }
    }

    // Keep the custom flag in sync when a provider/model is loaded or changed.
    void SyncModelCustomFlag()
    {
        modelIsCustom = CatalogOptions.Count > 0 && !string.IsNullOrWhiteSpace(model) && !CatalogOptions.Any(o => o.Id == model);
        copilotModelIsCustom = provider == "GitHubCopilot"
            && !string.IsNullOrWhiteSpace(model)
            && !copilotModels.Any(option => option.Id.Equals(model, StringComparison.OrdinalIgnoreCase));
    }

    static bool IsFoundryId(string id) =>
        id.Contains("generic-cpu", StringComparison.OrdinalIgnoreCase) || id.Contains("-instruct-", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        Mesh.StateChanged += Refresh;
        Setup.Changed += Refresh;
        Foundry.ModelsChanged += Refresh;
        var p = State.Profile;
        display = p.DisplayName;
        relay = p.RelayUrl;
        provider = EffectiveProvider(p.Model.Provider);
        model = p.Model.Model;
        endpoint = p.Model.Endpoint ?? "";
        apiVersion = p.Model.ApiVersion ?? "";
        reasoningEffort = p.Model.ReasoningEffort.ToString();
        tokenOptimizationIndex = (int)TokenOptimizer.Normalize(p.Model.TokenOptimization);
        copilotExecutable = string.IsNullOrWhiteSpace(p.Model.CopilotExecutable) ? "copilot" : p.Model.CopilotExecutable;
        copilotEffort = p.Model.CopilotEffort.ToString();
        browserEngine = string.IsNullOrWhiteSpace(p.Model.BrowserEngine) ? "Firefox" : p.Model.BrowserEngine;
        browserUrl = p.Model.BrowserUrl ?? "";
        browserExecuteScript = p.Model.BrowserExecuteScript ?? browserExecuteScript;
        browserPollScript = p.Model.BrowserPollScript ?? browserPollScript;
        browserResultScript = p.Model.BrowserResultScript ?? browserResultScript;
        browserPollSeconds = p.Model.BrowserPollSeconds;
        browserTimeoutMinutes = p.Model.BrowserTimeoutMinutes;
        approvalMode = p.ApprovalMode.ToString();
        allowApps = p.AllowInteractiveApps;
        replyBudget = p.AgentDailyReplyBudget;
        primaryAgentDeviceId = p.AgentPrimaryDeviceId ?? "";
        failoverAgentDeviceId = p.AgentFailoverDeviceId ?? "";
        // Use the list cached at app startup, do NOT reload here (that would reset the selection).
        foundryModels = Foundry.CachedModels.ToList();
        SyncModelCustomFlag();

        Updater.Changed += Refresh;
        launchAtStartup = AppControl.IsLaunchAtStartupEnabled();
    }

    string? registrationError;

    protected override async Task OnInitializedAsync()
    {
        if (provider == "GitHubCopilot")
            await LoadCopilotModelsAsync();
        await LoadLinkedDevicesAsync();
        await LoadAgentRoutingAsync();
    }

    async Task OnDeviceNameChanged(ChangeEventArgs e)
    {
        Toggle(p => p.DeviceName = (e.Value?.ToString() ?? string.Empty).Trim());
        await RefreshRegistrationAsync();
    }

    async Task RefreshRegistrationAsync()
    {
        registrationError = null;
        try
        {
            if (!await Mesh.RegisterAsync())
                registrationError = "Could not update this device on the relay. Check your connection and try again.";
            else
            {
                await LoadLinkedDevicesAsync();
                await LoadAgentRoutingAsync();
            }
        }
        catch { registrationError = "Could not update this device on the relay. Check your connection and try again."; }
    }

    bool launchAtStartup;

    void OnToggleStartup(ChangeEventArgs e)
    {
        launchAtStartup = (bool)(e.Value ?? false);
        AppControl.SetLaunchAtStartup(launchAtStartup);
    }
    void Refresh()
    {
        if (Mesh.Connected && !linkedDevicesAttempted && !loadingLinkedDevices)
            _ = LoadLinkedDevicesAsync();
        if (Mesh.SupportsAgentHost && !agentRoutingAttempted && !loadingAgentRouting)
            _ = LoadAgentRoutingAsync();
        // Keep the dropdown in sync if the startup preload finishes while Settings is open.
        if (foundryModels.Count == 0 && Foundry.CachedModels.Count > 0)
            foundryModels = Foundry.CachedModels.ToList();
        InvokeAsync(StateHasChanged);
    }

    void OnProviderChange(ChangeEventArgs e)
    {
        provider = e.Value?.ToString() ?? "Anthropic";
        if (provider == "MeshHosted")
        {
            model = ""; // the free model's id is chosen server-side
        }
        else if (provider == "Browser")
        {
            model = "browser";
        }
        else if (provider == "OpenRouter")
        {
            model = "openrouter/auto"; // OpenRouter routes by the user's account settings; client never pins a model
        }
        else if (provider == "GitHubCopilot")
        {
            model = "auto";
            copilotExecutable = string.IsNullOrWhiteSpace(copilotExecutable) ? "copilot" : copilotExecutable;
            copilotEffort = "Auto";
            copilotModelIsCustom = false;
            _ = LoadCopilotModelsAsync();
        }
        else if (provider == "FoundryLocal")
        {
            foundryModels = Foundry.CachedModels.ToList();
            // Only pick a default when the current selection isn't an on-device model.
            if (!IsFoundryId(model))
                model = foundryModels.FirstOrDefault(m => m.Id == FoundryLocalService.DefaultModel)?.Id
                        ?? foundryModels.FirstOrDefault()?.Id
                        ?? FoundryLocalService.DefaultModel;
        }
        else if (IsFoundryId(model) || string.Equals(model, "auto", StringComparison.OrdinalIgnoreCase))
        {
            model = ""; // let the provider's placeholder show
        }

        // For providers with a curated catalog, default to the top model when the current id is not
        // in the new provider's list, so the dropdown never lands on a stale/foreign model id.
        if (ModelCatalog.HasCatalog(Enum.Parse<ModelProvider>(provider)))
        {
            var opts = CatalogOptions;
            if (!opts.Any(o => o.Id == model)) model = opts[0].Id;
        }
        SyncModelCustomFlag();
    }

    string CopilotModelSelectValue
        => !copilotModelIsCustom && copilotModels.Any(option => option.Id.Equals(model, StringComparison.OrdinalIgnoreCase))
            ? copilotModels.First(option => option.Id.Equals(model, StringComparison.OrdinalIgnoreCase)).Id
            : string.Equals(model, "auto", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(model)
                ? "auto"
                : "__custom__";

    static string CopilotModelLabel(CopilotModelOption option)
    {
        var suffix = string.IsNullOrWhiteSpace(option.Usage) ? "" : $" ({option.Usage})";
        return option.Name + suffix + (option.Enabled ? "" : " - unavailable");
    }

    void OnCopilotModelSelect(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "auto";
        copilotModelIsCustom = value == "__custom__";
        model = copilotModelIsCustom ? "" : value;
    }

    async Task LoadCopilotModelsAsync(bool force = false)
    {
        if (loadingCopilotModels || provider != "GitHubCopilot") return;
        loadingCopilotModels = true;
        copilotModelsError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            copilotModels = (await Copilot.GetModelsAsync(
                string.IsNullOrWhiteSpace(copilotExecutable) ? "copilot" : copilotExecutable.Trim(),
                force)).ToList();
            if (!copilotModels.Any(option => option.Id.Equals("auto", StringComparison.OrdinalIgnoreCase)))
                copilotModels.Insert(0, new CopilotModelOption("auto", "Automatic", "Let Copilot choose", null, null, true));
            SyncModelCustomFlag();
        }
        catch (Exception ex)
        {
            copilotModelsError = ex.Message;
            copilotModels = new() { new CopilotModelOption("auto", "Automatic", "Let Copilot choose", null, null, true) };
            SyncModelCustomFlag();
        }
        finally
        {
            loadingCopilotModels = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Manual refresh, the only place that re-queries the on-device catalog after startup.</summary>
    async Task RefreshModels()
    {
        loadingModels = true;
        await InvokeAsync(StateHasChanged);
        try { await Foundry.PreloadModelsAsync(force: true); foundryModels = Foundry.CachedModels.ToList(); }
        catch { /* leave existing list */ }
        finally { loadingModels = false; await InvokeAsync(StateHasChanged); }
    }

    async Task LoadBrowserPreset(InputFileChangeEventArgs e)
    {
        browserPresetStatus = "";
        try
        {
            await using var stream = e.File.OpenReadStream(2 * 1024 * 1024);
            using var document = await System.Text.Json.JsonDocument.ParseAsync(stream);
            var root = document.RootElement;
            if (root.ValueKind != System.Text.Json.JsonValueKind.Object)
                throw new InvalidOperationException("Preset root must be a JSON object.");

            static string? Text(System.Text.Json.JsonElement root, string name)
                => root.TryGetProperty(name, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.String
                    ? value.GetString() : null;
            static int? Number(System.Text.Json.JsonElement root, string name)
                => root.TryGetProperty(name, out var value) && value.TryGetInt32(out var number) ? number : null;

            var url = Text(root, "startUrl") ?? Text(root, "url");
            var execute = Text(root, "executePrompt");
            var poll = Text(root, "pollForResponse");
            var result = Text(root, "getResult");
            if (string.IsNullOrWhiteSpace(url) || string.IsNullOrWhiteSpace(execute)
                || string.IsNullOrWhiteSpace(poll) || string.IsNullOrWhiteSpace(result))
                throw new InvalidOperationException("Preset requires startUrl, executePrompt, pollForResponse, and getResult.");

            browserUrl = url;
            browserExecuteScript = execute;
            browserPollScript = poll;
            browserResultScript = result;
            var engine = Text(root, "browser");
            if (engine is not null && new[] { "Chrome", "Edge", "Firefox" }.Contains(engine, StringComparer.OrdinalIgnoreCase))
                browserEngine = char.ToUpperInvariant(engine[0]) + engine[1..].ToLowerInvariant();
            var contextMode = Text(root, "contextMode");
            if (string.Equals(contextMode, "CurrentTurn", StringComparison.OrdinalIgnoreCase))
                browserContextMode = "CurrentTurn";
            else if (string.Equals(contextMode, "FullPrompt", StringComparison.OrdinalIgnoreCase))
                browserContextMode = "FullPrompt";
            browserPollSeconds = Math.Clamp(Number(root, "pollSeconds") ?? browserPollSeconds, 1, 60);
            browserTimeoutMinutes = Math.Clamp(Number(root, "timeoutMinutes") ?? browserTimeoutMinutes, 1, 120);
            browserPresetStatus = $"Loaded {e.File.Name}. Review the scripts, then select Change model.";
        }
        catch (Exception ex)
        {
            browserPresetStatus = "Could not load preset: " + ex.Message;
        }
    }

    async Task ChangeModel()
    {
        if (!RelayTransportPolicy.TryValidateBaseUrl(
                relay, RelayTransportPolicy.LocalHttpEnabled, out var policyError))
        {
            relayTestOk = false;
            relayTestMsg = policyError;
            return;
        }
        var apiKeyToSet = apiKey;
        var tokenOptimizationToSet = SelectedTokenOptimization;
        apiKey = "";

        // The save + model test runs in a background singleton, so it keeps going
        // (and stays observable) even if the user navigates away from Settings. The non-model
        // fields (display name, relay, approval, budget) auto-save on change; they are set here too
        // so a single "Change model" also captures anything the user just edited.
        Setup.SaveAndTest(p =>
        {
            p.DisplayName = display.Trim();
            p.RelayUrl = relay.Trim();
            p.Model.Provider = Enum.Parse<ModelProvider>(provider);
            p.Model.Model = model.Trim();
            p.Model.Endpoint = string.IsNullOrWhiteSpace(endpoint) ? null : endpoint.Trim();
            p.Model.ApiVersion = string.IsNullOrWhiteSpace(apiVersion) ? null : apiVersion.Trim();
            p.Model.ReasoningEffort = Enum.TryParse<ReasoningEffort>(reasoningEffort, out var effort) ? effort : ReasoningEffort.Auto;
            p.Model.TokenOptimization = tokenOptimizationToSet;
            p.Model.CopilotExecutable = string.IsNullOrWhiteSpace(copilotExecutable) ? "copilot" : copilotExecutable.Trim();
            p.Model.CopilotEffort = Enum.TryParse<CopilotEffort>(copilotEffort, out var cliEffort) ? cliEffort : CopilotEffort.Auto;
            p.Model.BrowserEngine = browserEngine;
            p.Model.BrowserContextMode = browserContextMode;
            p.Model.BrowserUrl = string.IsNullOrWhiteSpace(browserUrl) ? null : browserUrl.Trim();
            p.Model.BrowserExecuteScript = browserExecuteScript;
            p.Model.BrowserPollScript = browserPollScript;
            p.Model.BrowserResultScript = browserResultScript;
            p.Model.BrowserPollSeconds = Math.Clamp(browserPollSeconds, 1, 60);
            p.Model.BrowserTimeoutMinutes = Math.Clamp(browserTimeoutMinutes, 1, 120);
            if (!string.IsNullOrWhiteSpace(apiKeyToSet)) p.Model.ApiKey = apiKeyToSet.Trim();
            p.ApprovalMode = Enum.Parse<ApprovalMode>(approvalMode);
            p.AllowInteractiveApps = allowApps;
            p.AgentDailyReplyBudget = replyBudget < 0 ? 0 : replyBudget;
        });

        // Model may have changed; start the live counter fresh for the newly selected model.
        State.ResetTokenCounter();

        await Mesh.RegisterAsync();
        await LoadAgentRoutingAsync();
    }

    async Task LoadLinkedDevicesAsync()
    {
        if (loadingLinkedDevices) return;
        linkedDevicesAttempted = true;
        loadingLinkedDevices = true;
        linkedDeviceError = null;
