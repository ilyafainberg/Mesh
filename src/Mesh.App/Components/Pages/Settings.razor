    void BeginRevokeDevice(Mesh.Shared.DeviceInfo device)
    {
        revokeDeviceId = device.DeviceId;
        revokeConfirmation = "";
        revokeError = null;
    }

    void CancelRevokeDevice()
    {
        revokeDeviceId = null;
        revokeConfirmation = "";
        revokeError = null;
    }

    void OnRevokeConfirmationChanged(ChangeEventArgs e)
        => revokeConfirmation = e.Value?.ToString()?.Trim() ?? "";

    bool CanConfirmRevoke(Mesh.Shared.DeviceInfo device)
        => string.Equals(
            revokeConfirmation,
            RevokeSuffix(device.DeviceId),
            StringComparison.OrdinalIgnoreCase);

    async Task ConfirmRevokeDeviceAsync(Mesh.Shared.DeviceInfo device)
    {
        if (!CanConfirmRevoke(device) || revokingDevice) return;
        revokingDevice = true;
        revokeError = null;
        try
        {
            var result = await Mesh.RevokeDeviceAsync(device.DeviceId);
            if (result?.Revoked != true)
            {
                revokeError = "The relay did not revoke this device.";
                return;
            }
            linkedDevices.RemoveAll(item => item.DeviceId == device.DeviceId);
            agentDevices.RemoveAll(item => item.DeviceId == device.DeviceId);
            if (primaryAgentDeviceId == device.DeviceId) primaryAgentDeviceId = "";
            if (failoverAgentDeviceId == device.DeviceId) failoverAgentDeviceId = "";
            CancelRevokeDevice();
        }
        catch (Exception ex)
        {
            revokeError = "Could not revoke this device: " + ex.Message;
        }
        finally
        {
            revokingDevice = false;
        }
    }

    static string RevokeSuffix(string deviceId)
        => deviceId.Length <= 6 ? deviceId : deviceId[^6..];

    static string DeviceDisplayName(global::Mesh.Shared.DeviceInfo device)
        => string.IsNullOrWhiteSpace(device.Name) ? "Linked device" : device.Name;

    static string DevicePlatform(string? platform) => platform?.ToLowerInvariant() switch
    {
        global::Mesh.Shared.DevicePlatforms.Windows => "Windows",
        global::Mesh.Shared.DevicePlatforms.MacOS => "Mac",
        global::Mesh.Shared.DevicePlatforms.Android => "Android",
        global::Mesh.Shared.DevicePlatforms.IOS => "iPhone or iPad",
        _ => "Device"
    };

    static string DeviceIcon(string? platform) => platform?.ToLowerInvariant() switch
    {
        global::Mesh.Shared.DevicePlatforms.Windows => "bi-windows",
        global::Mesh.Shared.DevicePlatforms.MacOS => "bi-apple",
        global::Mesh.Shared.DevicePlatforms.Android => "bi-android2",
        global::Mesh.Shared.DevicePlatforms.IOS => "bi-phone",
        _ => "bi-device-ssd"
    };

    async Task LoadAgentRoutingAsync()
    {
        if (!Mesh.SupportsAgentHost || loadingAgentRouting) return;
        agentRoutingAttempted = true;
        loadingAgentRouting = true;
        agentRoutingError = null;
        try
        {
            var devicesTask = Mesh.ListMyDevicesAsync();
            var routingTask = Mesh.GetAgentRoutingAsync();
            await Task.WhenAll(devicesTask, routingTask);
            agentDevices = (await devicesTask).ToList();
            linkedDevices = agentDevices.ToList();
            linkedDevicesAttempted = true;
            var routing = await routingTask;
            if (routing is null)
            {
                agentRoutingError = "Could not load agent response devices from the relay.";
                return;
            }
            primaryAgentDeviceId = routing.PrimaryDeviceId ?? "";
            failoverAgentDeviceId = routing.FailoverDeviceId ?? "";
        }
        catch (Exception ex)
        {
            linkedDevicesAttempted = true;
            linkedDeviceError = "Could not load linked devices: " + ex.Message;
            agentRoutingError = "Could not load agent response devices: " + ex.Message;
        }
        finally
        {
            loadingAgentRouting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task OnPrimaryAgentDeviceChanged(ChangeEventArgs e)
    {
        var primary = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(primary)) return;
        var failover = string.Equals(primary, failoverAgentDeviceId, StringComparison.Ordinal)
            ? null
            : NullIfBlank(failoverAgentDeviceId);
        await SaveAgentRoutingAsync(primary, failover);
    }

    async Task OnFailoverAgentDeviceChanged(ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(primaryAgentDeviceId)) return;
        await SaveAgentRoutingAsync(
            primaryAgentDeviceId,
            NullIfBlank(e.Value?.ToString()));
    }

    async Task SaveAgentRoutingAsync(string primary, string? failover)
    {
        if (savingAgentRouting) return;
        savingAgentRouting = true;
        agentRoutingError = null;
        try
        {
            var result = await Mesh.SetAgentRoutingAsync(primary, failover);
            if (!result.Success || result.Routing is null)
            {
                agentRoutingError = result.Error ?? "Could not save the agent response devices.";
                primaryAgentDeviceId = State.Profile.AgentPrimaryDeviceId ?? primaryAgentDeviceId;
                failoverAgentDeviceId = State.Profile.AgentFailoverDeviceId ?? "";
                return;
            }
            primaryAgentDeviceId = result.Routing.PrimaryDeviceId ?? "";
            failoverAgentDeviceId = result.Routing.FailoverDeviceId ?? "";
        }
        finally
        {
            savingAgentRouting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    string AgentDeviceLabel(Mesh.Shared.DeviceInfo device)
    {
        var name = string.IsNullOrWhiteSpace(device.Name) ? "Desktop device" : device.Name;
        var mine = string.Equals(device.DeviceId, Mesh.MyDeviceId, StringComparison.Ordinal)
            ? ", this device"
            : "";
        var status = !device.RemoteAgentEnabled
            ? "agent unavailable"
            : device.Online ? "ready" : "offline";
        return $"{name} ({status}{mine})";
    }

    static string? NullIfBlank(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value;

