    // ---- model dropdown (curated catalog per provider) ----
    bool modelIsCustom;

    IReadOnlyList<ModelCatalog.ModelOption> CatalogOptions =>
        Enum.TryParse<ModelProvider>(provider, out var pv) ? ModelCatalog.For(pv) : Array.Empty<ModelCatalog.ModelOption>();

    // The <select> value: the current model id when it is in the catalog, else the Custom sentinel.
    string ModelSelectValue =>
        (!modelIsCustom && CatalogOptions.Any(o => o.Id == model)) ? model : "__custom__";

    void OnModelSelect(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        if (v == "__custom__") { modelIsCustom = true; }
        else { modelIsCustom = false; model = v; }
    }

    // Keep the custom flag in sync when a provider/model is loaded or changed.
    void SyncModelCustomFlag()
        => modelIsCustom = CatalogOptions.Count > 0 && !string.IsNullOrWhiteSpace(model) && !CatalogOptions.Any(o => o.Id == model);

    static bool IsFoundryId(string id) =>
        id.Contains("generic-cpu", StringComparison.OrdinalIgnoreCase) || id.Contains("-instruct-", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        Mesh.StateChanged += Refresh;
        Setup.Changed += Refresh;
        Foundry.ModelsChanged += Refresh;
        var p = State.Profile;
        display = p.DisplayName;
        relay = p.RelayUrl;
        provider = p.Model.Provider.ToString();
        model = p.Model.Model;
        endpoint = p.Model.Endpoint ?? "";
        apiVersion = p.Model.ApiVersion ?? "";
        approvalMode = p.ApprovalMode.ToString();
        allowApps = p.AllowInteractiveApps;
        replyBudget = p.AgentDailyReplyBudget;
        // Use the list cached at app startup, do NOT reload here (that would reset the selection).
        foundryModels = Foundry.CachedModels.ToList();
        SyncModelCustomFlag();
    }
    void Refresh()
    {
        // Keep the dropdown in sync if the startup preload finishes while Settings is open.
        if (foundryModels.Count == 0 && Foundry.CachedModels.Count > 0)
            foundryModels = Foundry.CachedModels.ToList();
        InvokeAsync(StateHasChanged);
    }

    void OnProviderChange(ChangeEventArgs e)
    {
        provider = e.Value?.ToString() ?? "Anthropic";
        if (provider == "MeshHosted")
        {
            model = ""; // the free model's id is chosen server-side
        }
        else if (provider == "FoundryLocal")
        {
            foundryModels = Foundry.CachedModels.ToList();
            // Only pick a default when the current selection isn't an on-device model.
            if (!IsFoundryId(model))
                model = foundryModels.FirstOrDefault(m => m.Id == FoundryLocalService.DefaultModel)?.Id
                        ?? foundryModels.FirstOrDefault()?.Id
                        ?? FoundryLocalService.DefaultModel;
        }
        else if (IsFoundryId(model))
        {
            model = ""; // let the provider's placeholder show
        }

        // For providers with a curated catalog, default to the top model when the current id is not
        // in the new provider's list, so the dropdown never lands on a stale/foreign model id.
        if (ModelCatalog.HasCatalog(Enum.Parse<ModelProvider>(provider)))
        {
            var opts = CatalogOptions;
            if (!opts.Any(o => o.Id == model)) model = opts[0].Id;
        }
        SyncModelCustomFlag();
    }

    /// <summary>Manual refresh, the only place that re-queries the on-device catalog after startup.</summary>
    async Task RefreshModels()
    {
        loadingModels = true;
        await InvokeAsync(StateHasChanged);
        try { await Foundry.PreloadModelsAsync(force: true); foundryModels = Foundry.CachedModels.ToList(); }
        catch { /* leave existing list */ }
        finally { loadingModels = false; await InvokeAsync(StateHasChanged); }
    }

    async Task SaveAll()
    {
        var apiKeyToSet = apiKey;
        apiKey = "";

        // The save + model test runs in a background singleton, so it keeps going
        // (and stays observable) even if the user navigates away from Settings.
        Setup.SaveAndTest(p =>
        {
            p.DisplayName = display.Trim();
            p.RelayUrl = relay.Trim();
            p.Model.Provider = Enum.Parse<ModelProvider>(provider);
            p.Model.Model = model.Trim();
            p.Model.Endpoint = string.IsNullOrWhiteSpace(endpoint) ? null : endpoint.Trim();
            p.Model.ApiVersion = string.IsNullOrWhiteSpace(apiVersion) ? null : apiVersion.Trim();
            if (!string.IsNullOrWhiteSpace(apiKeyToSet)) p.Model.ApiKey = apiKeyToSet.Trim();
            p.ApprovalMode = Enum.Parse<ApprovalMode>(approvalMode);
            p.AllowInteractiveApps = allowApps;
            p.AgentDailyReplyBudget = replyBudget < 0 ? 0 : replyBudget;
        });

        // Model may have changed; start the live counter fresh for the newly selected model.
        State.ResetTokenCounter();

        await Mesh.RegisterAsync();
    }

    void ResetCounter() => State.ResetTokenCounter();

    // ---- relay test ----
    bool testingRelay;
    bool relayTestOk;
    string? relayTestMsg;

    async Task TestRelay()
    {
        relayTestMsg = null;
        var url = relay?.Trim();
        if (string.IsNullOrWhiteSpace(url)) { relayTestOk = false; relayTestMsg = "Enter a relay URL first."; return; }
        testingRelay = true;
        try
        {
            var http = HttpFactory.CreateClient("relay");
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var resp = await http.GetAsync($"{url.TrimEnd('/')}/health", cts.Token);
            if (resp.IsSuccessStatusCode)
            {
                relayTestOk = true;
                relayTestMsg = "Relay is reachable. Save to switch to it.";
            }
            else
            {
                relayTestOk = false;
                relayTestMsg = $"Relay responded with {(int)resp.StatusCode}. Check the URL.";
            }
        }
        catch (Exception ex)
        {
            relayTestOk = false;
            relayTestMsg = $"Could not reach that relay: {ex.Message}";
        }
        finally { testingRelay = false; }
    }

    // ---- self-update ----
    bool checkingUpdate;
    bool updateAvailable;
    bool updateFailed;
    string? updateStatus;
    UpdateInfo? updateInfo;
    UpdatePhase updatePhase = UpdatePhase.Idle;
    int updatePercent = -1;
    long updateBytesReceived;
    long updateBytesTotal;

    static string FormatMb(long bytes) => (bytes / 1024.0 / 1024.0).ToString("N0");

    async Task CheckUpdate()
    {
        checkingUpdate = true;
        updateFailed = false;
        updateStatus = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var result = await Updater.CheckAsync(cts.Token);
            if (result.Available && result.Info is not null)
            {
                updateAvailable = true;
                updateInfo = result.Info;
                updatePhase = UpdatePhase.Idle;
            }
            else if (result.Error is not null)
            {
                updateFailed = true;
                updateStatus = result.Error;
            }
            else
            {
                updateStatus = $"You're on the latest version ({Updater.CurrentVersion.ToString(3)}).";
            }
        }
        catch (Exception ex)
        {
            updateFailed = true;
            updateStatus = $"Update check failed: {ex.Message}";
        }
        finally { checkingUpdate = false; }
    }

    async Task DownloadUpdate()
    {
        if (updateInfo is null) return;
        updateFailed = false;
        updatePhase = UpdatePhase.Downloading;
        updateBytesReceived = 0;
        updateBytesTotal = updateInfo.Size;
        updatePercent = updateInfo.Size > 0 ? 0 : -1;

        var progress = new Progress<UpdateProgress>(p =>
        {
            updatePhase = p.Phase;
            updateBytesReceived = p.BytesReceived;
            updateBytesTotal = p.TotalBytes;
            updatePercent = p.Percent;
            updateStatus = p.Phase switch
            {
                UpdatePhase.Downloading => "Downloading update…",
                UpdatePhase.Extracting => "Extracting…",
                UpdatePhase.Preparing => "Preparing…",
                UpdatePhase.ReadyToApply => "Ready to install",
                _ => updateStatus
            };
            InvokeAsync(StateHasChanged);
        });

        try
        {
            preparedUpdaterPath = await Updater.DownloadAndPrepareAsync(updateInfo, progress);
            updatePhase = UpdatePhase.ReadyToApply;
        }
        catch (Exception ex)
        {
            updateFailed = true;
            updatePhase = UpdatePhase.Idle;
            updateStatus = $"Update download failed: {ex.Message}";
        }
    }

    void ApplyUpdate()
    {
        if (preparedUpdaterPath is null) return;
        updatePhase = UpdatePhase.Applying;
        updateStatus = "Restarting to install…";
        Updater.ApplyAndExit(preparedUpdaterPath);
    }

    void DismissUpdate()
    {
        updatePhase = UpdatePhase.Idle;
        updateAvailable = false;
        updateInfo = null;
        preparedUpdaterPath = null;
        updateStatus = null;
    }

