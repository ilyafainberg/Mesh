    // ---- custom MCP servers ----
    bool addingMcp;
    string newMcpName = "";
    string newMcpCommand = "";
    string newMcpArgs = "";

    void AddCustom()
    {
        if (string.IsNullOrWhiteSpace(newMcpCommand)) return;
        var args = (newMcpArgs ?? "")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(a => a.Trim())
            .Where(a => a.Length > 0)
            .ToList();
        State.Mutate(p => p.CustomMcpServers.Add(new CustomMcpServer
        {
            Name = newMcpName.Trim(),
            Command = newMcpCommand.Trim(),
            Arguments = args,
            Enabled = true
        }));
        newMcpName = ""; newMcpCommand = ""; newMcpArgs = ""; addingMcp = false;
    }

    void RemoveCustom(CustomMcpServer c) => State.Mutate(p => p.CustomMcpServers.RemoveAll(x => x.Id == c.Id));

    void SetCustomEnabled(CustomMcpServer c, bool enabled) => State.Mutate(_ => c.Enabled = enabled);

    void SetCustomVisibility(CustomMcpServer c, string? visibility)
        => State.Mutate(_ => c.Visibility = string.IsNullOrWhiteSpace(visibility) ? "private" : visibility!);

    async Task SignOut()
    {
        signingOut = true;
        try
        {
            await Mesh.DisconnectAsync();
            State.SignOut(); // keeps the identity saved; returns app to the picker
        }
        finally { signingOut = false; }
    }

    async Task Switch(AccountRef a)
    {
        if (a.Id == State.ActiveAccountId || switching) return;
        switching = true;
        try
        {
            await Mesh.DisconnectAsync();
            if (State.SwitchAccount(a.Id))
            {
                SyncFields();
                await Mesh.RegisterAsync();
                await Mesh.ConnectAsync();
            }
        }
        finally { switching = false; }
    }

    async Task DeleteAccount(AccountRef a)
    {
        deleteId = null;
        var wasActive = a.Id == State.ActiveAccountId;
        if (wasActive) await Mesh.DisconnectAsync();
        State.DeleteAccount(a.Id);
        if (wasActive) SyncFields(); // active cleared → app shows the picker
    }

