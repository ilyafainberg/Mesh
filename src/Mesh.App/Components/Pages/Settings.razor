    // ---- relay test ----
    bool testingRelay;
    bool relayTestOk;
    string? relayTestMsg;

    async Task TestRelay()
    {
        relayTestMsg = null;
        var url = relay?.Trim();
        if (string.IsNullOrWhiteSpace(url)) { relayTestOk = false; relayTestMsg = "Enter a relay URL first."; return; }
        testingRelay = true;
        try
        {
            if (!RelayTransportPolicy.TryValidateBaseUrl(
                    url, RelayTransportPolicy.LocalHttpEnabled, out var policyError))
            {
                relayTestOk = false;
                relayTestMsg = policyError;
                return;
            }
            var http = HttpFactory.CreateClient("relay");
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var resp = await http.GetAsync($"{url.TrimEnd('/')}/health", cts.Token);
            if (resp.IsSuccessStatusCode)
            {
                relayTestOk = true;
                relayTestMsg = "Relay is reachable.";
            }
            else
            {
                relayTestOk = false;
                relayTestMsg = $"Relay responded with {(int)resp.StatusCode}. Check the URL.";
            }
        }
        catch (Exception ex)
        {
            relayTestOk = false;
            relayTestMsg = $"Could not reach that relay: {ex.Message}";
        }
        finally { testingRelay = false; }
    }

    // ---- self-update ----
    bool checkingUpdate;
    bool updateFailed;
    string? updateStatus;

    static string FormatMb(long bytes) => (bytes / 1024.0 / 1024.0).ToString("N0");

    async Task CheckUpdate()
    {
        checkingUpdate = true;
        updateFailed = false;
        updateStatus = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var result = await Updater.CheckNowAsync(cts.Token);
            if (result.Available)
            {
                updateStatus = null;
            }
            else if (result.Error is not null)
            {
                updateFailed = true;
                updateStatus = result.Error;
            }
            else
            {
                updateStatus = $"You're on the latest version ({Updater.CurrentVersion.ToString(3)}).";
            }
        }
        catch (OperationCanceledException)
        {
            updateFailed = true;
            updateStatus = "The update check timed out. Try again.";
        }
        finally
        {
            checkingUpdate = false;
        }
    }

    async Task StartUpdate()
    {
        updateFailed = false;
        updateStatus = null;
        var started = await Updater.StartUpdateAsync();
        if (!started && !Updater.IsLaunchRequested)
        {
            updateFailed = true;
            updateStatus = Updater.Error ?? "The Mesh updater could not be started.";
        }
    }

    async Task OpenUrl(string url)
    {
        try { await Microsoft.Maui.ApplicationModel.Launcher.OpenAsync(new Uri(url)); }
        catch (Exception ex) when (ex is UriFormatException or InvalidOperationException or NotSupportedException)
        {
            updateFailed = true;
            updateStatus = $"Could not open the release page: {ex.Message}";
        }
    }
