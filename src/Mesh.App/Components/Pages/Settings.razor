    async Task OnRelayChanged(ChangeEventArgs e)
    {
        relay = e.Value?.ToString() ?? "";
        var url = relay.Trim();
        if (string.IsNullOrWhiteSpace(url)) return;
        if (!RelayTransportPolicy.TryValidateBaseUrl(
                url, RelayTransportPolicy.LocalHttpEnabled, out var policyError))
        {
            relayTestOk = false;
            relayTestMsg = policyError;
            relay = State.Profile.RelayUrl;
            return;
        }
        Toggle(p => p.RelayUrl = url);
        // A handle is registered per relay, so switching relays re-registers there and reconnects.
        try { await Mesh.RegisterAsync(); await Mesh.ConnectAsync(); await LoadAgentRoutingAsync(); } catch { }
    }

