    static string Human(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }

    Task StopActive()
    {
        var thread = Active;
        var runId = RemoteRun?.RunId ?? thread?.ExecutionRunId ?? State.AgentRunFor(thread?.Id ?? "")?.RunId;
        if (thread is null || string.IsNullOrWhiteSpace(runId)) return Task.CompletedTask;

        var threadId = thread.Id;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:stop:{threadId}",
            threadId,
            runId: runId);
        attachError = null;
        UiOperations.TryRun(
            StopKey(threadId, runId),
            "ui.topic.stop",
            async ct =>
            {
                var stopped = await TopicRouter.StopAsync(operationScope, ct).ConfigureAwait(false);
                if (stopped) return true;

                var remote = State.GetRemoteRunProjection(threadId);
                var runIsStillExpected =
                    string.Equals(thread.ExecutionRunId, runId, StringComparison.Ordinal)
                    || string.Equals(remote?.RunId, runId, StringComparison.Ordinal);
                if (!runIsStillExpected) return true;

                // A persisted run without a live projection is stranded. Reconcile it off-dispatcher;
                // never claim cancellation if the durable state cannot be cleared.
                if (remote is null && thread.AgentExecutionHostDeviceId is not null)
                {
                    ct.ThrowIfCancellationRequested();
                    var cleared = false;
                    State.TryApplyScopedAsyncOperation(operationScope, () =>
                    {
                        State.ClearRemoteRunProjection(threadId, runId);
                        cleared = thread.ExecutionRunId is null;
                    });
                    return cleared;
                }
                return false;
            },
            outcome => ApplyCancellationOutcomeAsync(
                outcome,
                queued: false,
                operationScope),
            callbackLifetime.Token);
        return Task.CompletedTask;
    }

    Task ApplyCancellationOutcomeAsync(
        UiOperationOutcome<bool> outcome,
        bool queued,
        ScopedAsyncOperation operationScope)
        => InvokeAsync(() =>
        {
            if (disposed) return;
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                attachError = outcome.Kind switch
                {
                    UiOperationOutcomeKind.TimedOut => queued
                        ? "Queued cancellation timed out; the turn remains queued until delivery is confirmed."
                        : "Cancellation timed out; the run remains active until delivery is confirmed.",
                    UiOperationOutcomeKind.Failed => queued
                        ? "The queued turn could not be cancelled yet."
                        : "Could not request cancellation for this run.",
                    UiOperationOutcomeKind.Succeeded when outcome.Result != true => queued
                        ? "The queued turn could not be cancelled yet."
                        : "The run is still active; cancellation was not acknowledged.",
                    UiOperationOutcomeKind.Cancelled => queued
                        ? "Queued cancellation was interrupted; the turn remains queued."
                        : "Cancellation was interrupted; the run remains active.",
                    _ => null
                };
                StateHasChanged();
            });
        });

    static string StopKey(string threadId, string runId)
        => $"topic.stop:{threadId}:{runId}";

    async Task Send()
    {
        if (!CanSend || Active is not { } thread) return;
        var runtimeScope = State.CaptureAgentRuntimeScope();
        using var runtimeContext = State.EnterAgentRuntimeScope(runtimeScope);
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:ordinary-send:{thread.Id}",
            thread.Id);
        attachError = null;
        var text = inputValue;
        var chosenWidget = selectedWidget;
        var creatingWidget = widgetMode;
        IReadOnlyList<ChatAttachment> loadedAttachments;
        try
        {
            loadedAttachments = await LoadAttachmentsAsync(
                attachments.ToList(),
                callbackLifetime.Token);
        }
        catch (Exception exception)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError = exception.Message);
            return;
        }

        var message = BuildTurnPrompt(text, chosenWidget, creatingWidget);
        var line = new ChatLine
        {
            Id = Guid.NewGuid().ToString("n"),
            Role = "user",
            Text = message,
            Via = "person",
            AddressedToAgent = false,
            SenderHandle = State.Profile.Handle,
            Attachments = loadedAttachments.ToList(),
            At = DateTimeOffset.UtcNow
        };
        if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                if (string.Equals(thread.Title, "New chat", StringComparison.Ordinal)
                    && !string.IsNullOrWhiteSpace(message))
                    State.RenameOwnThread(thread.Id, Titleize(message));
                State.AddOwnChatLine(thread.Id, line);
            })
            || !State.TryAdvanceScopedAsyncOperation(
                operationScope,
                out var messageOperationScope,
                topicId: thread.Id,
                messageId: line.Id))
            return;
        operationScope = messageOperationScope!;
        try
        {
            await State.FlushPersistenceAsync(callbackLifetime.Token);
            if (!State.IsCurrentAgentRuntimeScope(runtimeScope)) return;
        }
        catch
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError = "Message could not be saved. Nothing was sent.");
            return;
        }
        if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                inputValue = "";
                attachments.Clear();
                ClearWidgetMode();
                ScheduleComposerSnapshot();
                scrollToLatestRequested = true;
            })) return;
        await InvokeAsync(() =>
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                if (!disposed && State.IsCurrentAgentRuntimeScope(runtimeScope))
                    StateHasChanged();
            });
        });
    }

    async Task RequestAiResponse()
    {
        if (!CanRequestAi) return;
        var runtimeScope = State.CaptureAgentRuntimeScope();
        using var runtimeContext = State.EnterAgentRuntimeScope(runtimeScope);
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:assistant-send");
        try
        {
            var freshDevices = await TopicRouter.ListDevicesAsync(callbackLifetime.Token);
            if (!State.TryApplyScopedAsyncOperation(
                    operationScope,
                    () => executionHosts =
                        global::Mesh.Shared.DeviceExecutionEligibility.EligibleHosts(freshDevices)))
                return;
        }
        catch (Exception exception)
        {
            RuntimeDiagnostics.Current?.RecordEvent(
                "assistant-host-refresh-failed",
                $"exception={exception.GetType().FullName}");
        }

        OwnThread? thread = null;
        if (!State.TryApplyScopedAsyncOperation(
                operationScope,
                () => thread = Active))
            return;
        if (thread is null) return;
        if (!State.TryAdvanceScopedAsyncOperation(
                operationScope,
                out var threadOperationScope,
                scopeKey: $"{asyncScopeOwner}:assistant-send:{thread.Id}",
                topicId: thread.Id)
            || !State.TryCaptureActiveThreadMutationScope(
                thread.Id,
                out var capturedPresentationScope))
            return;
        operationScope = threadOperationScope!;
        var presentationScope = capturedPresentationScope!;
        if (!ActiveExecutionEligible)
        {
            IReadOnlyList<global::Mesh.Shared.DeviceInfo> freshDevices;
            try
            {
                freshDevices = await TopicRouter.ListDevicesAsync(callbackLifetime.Token);
            }
            catch
            {
                freshDevices = Array.Empty<global::Mesh.Shared.DeviceInfo>();
            }
            var freshHost = global::Mesh.Shared.DeviceExecutionEligibility.EligibleHosts(freshDevices)
                .FirstOrDefault();
            if (freshHost is not null)
            {
                if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
                    {
                        executionHosts =
                            global::Mesh.Shared.DeviceExecutionEligibility.EligibleHosts(freshDevices);
                        if (string.IsNullOrWhiteSpace(thread.AgentExecutionHostDeviceId))
                            State.AssignOwnThreadAgentExecutionHost(
                                presentationScope,
                                ToAgentExecutionHost(freshHost));
                    })) return;
            }
            else
            {
                if (freshDevices.Count > 0
                    || !global::Mesh.Shared.DevicePlatforms.IsDesktop(
                        thread.AgentExecutionHostDevicePlatform))
                {
                    var previousIds = thread.Lines.Select(line => line.Id)
                        .ToHashSet(StringComparer.Ordinal);
                    await Send();
                    if (!State.IsCurrentAgentRuntimeScope(runtimeScope)) return;
                    var trigger = thread.Lines.LastOrDefault(line =>
                        line.Role == "user" && !previousIds.Contains(line.Id));
                    if (trigger is null)
                        return;
                    if (trigger is not null)
                    {
                        var runId = Guid.NewGuid().ToString("n");
                        try
                        {
                            var durableRequest = await State.CommitAssistantAiRequestAsync(
                                thread.Id,
                                trigger,
                                runId,
                                runId,
                                target: null,
                                callbackLifetime.Token);
                            if (!State.TryApplyScopedAsyncOperation(
                                    operationScope,
                                    () => ApplyAssistantProjection(durableRequest)))
                                return;
                        }
                        catch
                        {
                            State.TryCompleteScopedAsyncOperation(
                                operationScope,
                                () => attachError =
                                    "Message could not be saved. AI was not requested.");
                            return;
                        }
                    }
                    State.TryCompleteScopedAsyncOperation(
                        operationScope,
                        StateHasChanged);
                    return;
                }
            }
        }
        if (string.IsNullOrWhiteSpace(thread.AgentExecutionHostDeviceId)
            && executionHosts.FirstOrDefault() is { } discoveredHost)
        {
            if (!State.TryApplyScopedAsyncOperation(
                    operationScope,
                    () => State.AssignOwnThreadAgentExecutionHost(
                        presentationScope,
                        ToAgentExecutionHost(discoveredHost))))
                return;
        }
        var requestedSnapshot = CaptureComposerSnapshot(thread);
        var requestedRevision = inputRevision;
        MeshDb.ComposerDraft persistedDraft;
        try
        {
            persistedDraft = await State.PersistTopicDraftSnapshotAsync(
                thread.Id,
                requestedSnapshot,
                requestedRevision,
                callbackLifetime.Token);
            if (!State.IsCurrentAgentRuntimeScope(runtimeScope)) return;
        }
        catch (Exception exception)
        {
            RuntimeDiagnostics.Current?.RecordEvent(
                "topic-send-draft-flush-failed",
                $"thread={TopicSendSnapshot.StableId("thread", thread.Id)};"
                + $"revision={TopicSendSnapshot.StableId("revision", requestedRevision.ToString(System.Globalization.CultureInfo.InvariantCulture))};"
                + $"exception={exception.GetType().FullName}");
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                attachError =
                    "The latest draft could not be saved durably. Retry before sending.";
                StateHasChanged();
            });
            return;
        }
        var durableSnapshot = persistedDraft.TopicSnapshot
            ?? throw new InvalidOperationException("The durable topic snapshot is incomplete.");
        var draftRevision = new ComposerRevisionSnapshot(
            thread.Id,
            persistedDraft.Revision,
            durableSnapshot.Text);
        if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                if (inputRevision != requestedRevision) return;
                inputRevision = persistedDraft.Revision;
                ComposerRevisions.SetExact(
                    thread.Id,
                    persistedDraft.Revision,
                    durableSnapshot.Text);
            })) return;
        var text = durableSnapshot.Text;
        var chosenWidget = durableSnapshot.Widget is null
            ? null
            : RestoreWidget(durableSnapshot.Widget);
        var files = durableSnapshot.Attachments
            .Select(file => new StagedFile(file.Name, file.Path, file.Size))
            .ToList();
        var wasWidget = durableSnapshot.WidgetMode;
        var target = ResolveTarget(thread);
        if (!string.Equals(
                target.DeviceId,
                durableSnapshot.TargetDeviceId,
                StringComparison.Ordinal))
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                attachError =
                    "The topic target changed while the draft was being saved. Review and retry.";
                StateHasChanged();
            });
            return;
        }
        var fingerprint = durableSnapshot.Fingerprint;
        var submission = TopicSends.CreateSnapshot(
            thread.Id,
            target.DeviceId,
            draftRevision.Revision,
            fingerprint,
            DateTimeOffset.UtcNow,
            State.ActiveAccountId);
        if (!State.TryAdvanceScopedAsyncOperation(
                operationScope,
                out var requestOperationScope,
                topicId: thread.Id,
                messageId: submission.LineId,
                requestId: submission.OperationId,
                runId: submission.RunId))
            return;
        operationScope = requestOperationScope!;
        var triggerHandle = State.Profile.Handle;
        var turnMode = State.Profile.PlanBeforeActing
            ? global::Mesh.Shared.TopicTurnMode.Autonomous
            : global::Mesh.Shared.TopicTurnMode.Single;
        var titleText = !string.IsNullOrWhiteSpace(text)
            ? text
            : chosenWidget is not null ? $"Use widget: {chosenWidget.Name}" : "";
        var appState = State;
        var topicRouter = TopicRouter;
        var composerRevisions = ComposerRevisions;
        long clearedRevision = 0;
        var draftCleanup = new TopicSendDraftCleanup(
            outcome => PersistSubmittedDraftCleanupAsync(
                draftRevision,
                submission,
                presentationScope,
                outcome,
                appState,
                composerRevisions,
                revision => Interlocked.Exchange(ref clearedRevision, revision),
                CancellationToken.None));

        if (submission.ComposerRevision != draftRevision.Revision
            || !string.Equals(
                submission.DraftFingerprint,
                fingerprint,
                StringComparison.Ordinal))
        {
            var recoveryDraft = new ComposerRevisionSnapshot(
                draftRevision.EntityId,
                submission.ComposerRevision,
                text);
            AttachSendObserver(
                submission,
                outcome => ApplySendOutcomeFencedAsync(
                    submission,
                    recoveryDraft,
                    Interlocked.Read(ref clearedRevision),
                    outcome,
                    presentationScope,
                    operationScope));
            ObserveComponentTask(
                TopicSends.RequestReconciliationAsync(
                    submission,
                    draftCleanup: CreateDraftCleanup(recoveryDraft, submission),
                    cancellationToken: callbackLifetime.Token),
                "reconcile-superseded-topic-send");
            State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                attachError = "A prior send identity is being reconciled before this revision can be submitted.";
                StateHasChanged();
            });
            return;
        }

        if (!State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                attachError = null;
                capacityBlockedSubmission = null;
            }))
            return;
        var outcomePresented = 0;
        async Task PresentOutcomeAsync(TopicSendOutcome outcome)
        {
            if (outcome.Kind != TopicSendOutcomeKind.Reconciling
                && Interlocked.Exchange(ref outcomePresented, 1) != 0)
                return;
            await InvokeAsync(() =>
            {
                ApplySendOutcomeFencedAsync(
                    submission,
                    draftRevision,
                    Interlocked.Read(ref clearedRevision),
                    outcome,
                    presentationScope,
                    operationScope);
            });
        }
        var submissionResult = TopicSends.Submit(
                submission,
                async (stableSubmission, handoffContext) =>
                {
                    using var handoffRuntimeContext =
                        appState.EnterAgentRuntimeScope(runtimeScope);
                    if (!appState.IsCurrentAgentRuntimeScope(runtimeScope))
                        return new TopicSendHandoff(
                            false,
                            "stale_account_scope",
                            "The active account changed before handoff started.");
                    if (!appState.TryApplyScopedAsyncOperation(operationScope, () =>
                        {
                            if (string.Equals(thread.Title, "New chat", StringComparison.Ordinal)
                                && !string.IsNullOrWhiteSpace(titleText))
                                appState.RenameOwnThread(thread.Id, Titleize(titleText));
                        }))
                        return new TopicSendHandoff(
                            false,
                            "stale_account_scope",
                            "The active account changed before handoff started.");

                    var loadedAttachments = await LoadAttachmentsAsync(
                        files,
                        CancellationToken.None).ConfigureAwait(false);
                    if (!appState.IsCurrentScopedAsyncOperation(operationScope))
                        return new TopicSendHandoff(
                            false,
                            "stale_account_scope",
                            "The active account changed while attachments were loaded.");
                    var prompt = BuildTurnPrompt(text, chosenWidget, wasWidget);
                    var trigger = new ChatLine
                    {
                        Id = stableSubmission.LineId,
                        Role = "user",
                        Text = prompt,
                        Via = "person",
                        AddressedToAgent = true,
                        SenderHandle = triggerHandle,
                        Attachments = loadedAttachments.ToList(),
                        At = stableSubmission.SubmittedAt
                    };
                    var durableRequest = await appState.CommitAssistantAiRequestAsync(
                        stableSubmission.ThreadId,
                        trigger,
                        stableSubmission.RunId,
                        stableSubmission.OperationId,
                        new AgentExecutionHost(
                            stableSubmission.TargetDeviceId,
                            thread.AgentExecutionHostDeviceName,
                            thread.AgentExecutionHostDevicePlatform
                                ?? global::Mesh.Shared.DevicePlatforms.Unknown),
                        CancellationToken.None).ConfigureAwait(false);
                    if (!appState.IsCurrentAgentRuntimeScope(runtimeScope))
                        return new TopicSendHandoff(
                            false,
                            "stale_account_scope",
                            "The active account changed while the request was committed.");
                    if (!appState.TryCaptureAssistantAiRequestMutationScope(
                            durableRequest,
                            out var capturedRequestScope))
                        return new TopicSendHandoff(
                            false,
                            "stale_account_scope",
                            "The active account changed while the request was committed.");
                    var requestScope = capturedRequestScope!;
                    var draft = new TopicTurnDraft(
                        stableSubmission.RunId,
                        stableSubmission.ThreadId,
                        stableSubmission.LineId,
                        triggerHandle,
                        prompt,
                        stableSubmission.SubmittedAt,
                        turnMode,
                        stableSubmission.TargetDeviceId,
                        chosenWidget?.Id,
                        BuildWidgetContext(chosenWidget, wasWidget),
                        loadedAttachments,
                        stableSubmission.OperationId);
                    BeforeBeginTopicRunCheckpointHook?.Invoke(
                        stableSubmission.OperationId);
                    TopicDispatchResult result;
                    try
                    {
                        result = await topicRouter.SubmitAsync(
                            draft,
                            null,
                            CancellationToken.None,
                            handoffContext).ConfigureAwait(false);
                    }
                    catch (Exception exception)
                    {
                        appState.RecordAssistantAiDispatch(
                            requestScope,
                            TopicDispatchResult.Reject(
                                "dispatch_failed",
                                stableSubmission.RunId,
                                exception.Message));
                        throw;
                    }
                    if (!appState.IsCurrentScopedAsyncOperation(operationScope))
                        return new TopicSendHandoff(
                            false,
                            "stale_account_scope",
                            "The active account changed before dispatch completed.");
                    appState.RecordAssistantAiDispatch(requestScope, result);
                    if (!result.Accepted
                        && !result.Durable
                        && string.Equals(
                            result.Code,
                            "local_persistence_failed",
                            StringComparison.Ordinal))
                        throw new InvalidOperationException(
                            result.Error ?? "The run could not be durably started.");
                    if (result.Durable)
                    {
                        DurableBeginCheckpointHook?.Invoke(stableSubmission.OperationId);
                        handoffContext.MarkDurableBoundaryEntered();
                    }
                    return new TopicSendHandoff(
                        result.Accepted,
                        result.Code,
                        result.Error);
                },
                reconcileOutcome: PresentOutcomeAsync,
                draftCleanup: draftCleanup);
        if (submissionResult.Kind is TopicSendSubmissionKind.Started
            or TopicSendSubmissionKind.AlreadyRunning
            or TopicSendSubmissionKind.ReconciliationRequired)
        {
            AttachSendObserver(
                submissionResult.Snapshot,
                PresentOutcomeAsync);
            if (submissionResult.Kind == TopicSendSubmissionKind.ReconciliationRequired)
                ObserveComponentTask(
                    TopicSends.RequestReconciliationAsync(
                        submissionResult.Snapshot,
                        draftCleanup: CreateDraftCleanup(
                            draftRevision,
                            submissionResult.Snapshot),
                        cancellationToken: callbackLifetime.Token),
                    "reconcile-topic-send");
        }
        else if (submissionResult.Kind == TopicSendSubmissionKind.CapacityExceeded)
        {
            capacityBlockedSubmission = submissionResult.Snapshot;
        }
        else
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
                attachError = submissionResult.Error
                    ?? "This topic turn could not be scheduled. Your draft is unchanged.");
        }
        State.TryApplyScopedAsyncOperation(operationScope, StateHasChanged);

    }

    Task RetryCapacityBlockedSend()
    {
        var blocked = capacityBlockedSubmission;
        capacityBlockedSubmission = null;
        if (blocked is not null
            && Active is { } thread
            && string.Equals(thread.Id, blocked.ThreadId, StringComparison.Ordinal)
            && string.Equals(
                ResolveTarget(thread).DeviceId,
                blocked.TargetDeviceId,
                StringComparison.Ordinal)
            && inputRevision == blocked.ComposerRevision)
            return RequestAiResponse();

        attachError = "The draft changed before retry. Review it and send the latest version.";
        StateHasChanged();
        return Task.CompletedTask;
    }

    Task ApplySendOutcomeFencedAsync(
        TopicSendSnapshot submission,
        ComposerRevisionSnapshot submittedDraft,
        long clearedRevision,
        TopicSendOutcome outcome,
        ActiveThreadMutationScope presentationScope,
        ScopedAsyncOperation operationScope)
    {
        Action mutation = () => ApplySendOutcome(
            submission,
            submittedDraft,
            clearedRevision,
            outcome,
            presentationScope);
        if (outcome.Kind == TopicSendOutcomeKind.Reconciling)
            State.TryApplyScopedAsyncOperation(operationScope, mutation);
        else
            State.TryCompleteScopedAsyncOperation(operationScope, mutation);
        return Task.CompletedTask;
    }

    void ApplySendOutcome(
        TopicSendSnapshot submission,
        ComposerRevisionSnapshot submittedDraft,
        long clearedRevision,
        TopicSendOutcome outcome,
        ActiveThreadMutationScope presentationScope)
    {
        if (disposed) return;
        var authoritativeRequest = State.GetAssistantAiRequest(submission.RunId);
        if (authoritativeRequest is not null
            && outcome.Kind is TopicSendOutcomeKind.Rejected
                or TopicSendOutcomeKind.Failed
                or TopicSendOutcomeKind.RetryableFailed)
        {
            var transition = State.RecordAssistantAiDispatch(
                presentationScope,
                submission.RunId,
                submission.OperationId,
                submission.LineId,
                TopicDispatchResult.Reject(
                    outcome.Handoff?.Code ?? "dispatch_failed",
                    authoritativeRequest.RunId,
                    outcome.Handoff?.Error
                    ?? outcome.Exception?.Message
                    ?? "The AI request could not be dispatched."));
            authoritativeRequest = transition.Request;
        }
        if (authoritativeRequest?.IsTerminal == true)
        {
            ApplyAssistantProjection(authoritativeRequest);
            StateHasChanged();
            return;
        }

        if (outcome.Kind == TopicSendOutcomeKind.Accepted)
        {
            scrollToLatestRequested = true;
            if (clearedRevision <= 0)
            {
                var reconciled = ComposerRevisions.GetOrCreate(
                    submittedDraft.EntityId, "");
                if (reconciled.Revision > submittedDraft.Revision
                    && reconciled.Text.Length == 0)
                    clearedRevision = reconciled.Revision;
            }
            var clearedVisibleDraft = ClearSubmittedDraftPresentation(
                submittedDraft,
                clearedRevision);
            if (clearedVisibleDraft) ObserveComponentTask(
                ResetComposer(),
                "reset-composer");
            ApplyAssistantProjection(authoritativeRequest);
        }
        else if (outcome.Kind == TopicSendOutcomeKind.Reconciling)
        {
            if (authoritativeRequest is null)
                attachError = "The durable handoff status is still being checked.";
            else
            {
                ApplyAssistantProjection(authoritativeRequest);
                attachError = outcome.Handoff?.Error
                    ?? "The durable handoff status is still being checked.";
            }
            if (TopicSends.RequiresRecovery(submission.OperationId)
                && cleanupRecoveryAttempts.Add(submission.OperationId))
                ObserveComponentTask(
                    TopicSends.RequestReconciliationAsync(
                        submission,
                        draftCleanup: CreateDraftCleanup(submittedDraft, submission),
                        cancellationToken: callbackLifetime.Token),
                    "recover-topic-draft-cleanup");
        }
        else
        {
            if (outcome.Kind == TopicSendOutcomeKind.RetryableFailed)
            {
                var current = ComposerRevisions.GetOrCreate(
                    submittedDraft.EntityId,
                    inputValue);
                if (current.Revision > submission.ComposerRevision)
                    TopicSends.TryAbandonPreHandoff(
                        submission.OperationId,
                        current.Revision);
            }
            if (authoritativeRequest is null)
            {
                aiRetryAvailable = false;
                pendingMobileAiRetry = null;
                attachError = "Message could not be saved. AI was not requested.";
            }
            else
            {
                ApplyAssistantProjection(authoritativeRequest);
                var cleanup = State.CompareAndClearTopicDraft(
                    presentationScope,
                    submittedDraft.Revision);
                if (cleanup is MeshDb.ComposerDraftClearResult.Cleared
                    or MeshDb.ComposerDraftClearResult.Missing)
                {
                    var presentationRevision = submittedDraft.Revision;
                    if (ComposerRevisions.TryClear(submittedDraft, out var clearToken)
                        && clearToken is not null)
                        presentationRevision = clearToken.ClearedRevision;
                    if (ClearSubmittedDraftPresentation(
                            submittedDraft,
                            presentationRevision))
                        ObserveComponentTask(
                            ResetComposer(),
                            "reset-durable-assistant-composer");
                }
            }
        }
        StateHasChanged();
    }

    async Task RetryAiResponse()
    {
        if (aiRetryRunning) return;
        aiRetryRunning = true;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:assistant-retry");
        try
        {
        RestorePendingAiRequest();
        var pending = pendingMobileAiRetry;
        if (pending is null)
        {
            await RequestAiResponse();
            return;
        }
        var durableRequest = State.GetPendingAssistantAiRequest(pending.ThreadId);
        if (durableRequest is null
            || !string.Equals(durableRequest.RunId, pending.RunId, StringComparison.Ordinal))
        {
            pendingMobileAiRetry = null;
            aiRetryAvailable = false;
            return;
        }
        if (!State.TryCaptureAssistantAiRequestMutationScope(
                durableRequest,
                out var capturedRequestScope))
            return;
        var requestScope = capturedRequestScope!;
        if (!State.TryAdvanceScopedAsyncOperation(
                operationScope,
                out var retryOperationScope,
                scopeKey: $"{asyncScopeOwner}:assistant-retry:{pending.ThreadId}",
                topicId: pending.ThreadId,
                messageId: pending.TriggerLineId,
                requestId: requestScope.OperationId,
                runId: requestScope.RunId))
            return;
        operationScope = retryOperationScope!;
        var threadScope = State.CaptureActiveThreadMutationScope(pending.ThreadId);
        var retryScope = State.CaptureAgentRuntimeScope();

        var thread = State.Profile.OwnThreads.FirstOrDefault(item => item.Id == pending.ThreadId);
        var trigger = thread?.Lines.FirstOrDefault(line => line.Id == pending.TriggerLineId);
        if (thread is null || trigger is null)
        {
            pendingMobileAiRetry = null;
            aiRetryAvailable = false;
            attachError = "The original message is no longer available for AI retry.";
            return;
        }

        IReadOnlyList<global::Mesh.Shared.DeviceInfo> devices;
        try
        {
            devices = await TopicRouter.ListDevicesAsync(callbackLifetime.Token);
        }
        catch (Exception exception)
        {
            State.TryApplyScopedAsyncOperation(
                operationScope,
                () => attachError =
                    $"Message retained. Could not verify an AI host: {exception.Message}");
            return;
        }
        var target = global::Mesh.Shared.DeviceExecutionEligibility.EligibleHosts(devices)
            .FirstOrDefault(device => string.Equals(
                device.DeviceId, thread.AgentExecutionHostDeviceId, StringComparison.Ordinal))
            ?? global::Mesh.Shared.DeviceExecutionEligibility.EligibleHosts(devices).FirstOrDefault();
        if (target is null)
        {
            State.TryApplyScopedAsyncOperation(
                operationScope,
                () => attachError =
                    "Message retained. AI response unavailable — choose an online agent-ready Desktop, then retry.");
            return;
        }
        if (!State.IsCurrentAgentRuntimeScope(retryScope))
            return;
        using var retryContext = State.EnterAgentRuntimeScope(retryScope);
        if (!State.MoveOwnThreadAgentExecutionHost(
                threadScope,
                ToAgentExecutionHost(target),
                requestScope))
            return;
        var reassignedRequest = State.GetAssistantAiRequest(requestScope.RunId);
        if (!State.TryApplyScopedAsyncOperation(
                operationScope,
                () => ApplyAssistantProjection(reassignedRequest)))
            return;
        if (reassignedRequest?.IsTerminal == true) return;
        var draft = new TopicTurnDraft(
            pending.RunId,
            thread.Id,
            trigger.Id,
            State.Profile.Handle,
            trigger.Text,
            trigger.At,
            global::Mesh.Shared.TopicTurnMode.Single,
            target.DeviceId,
            Attachments: trigger.Attachments,
            TriggerOperationId: durableRequest?.OperationId ?? pending.RunId);
        BeforeBeginTopicRunCheckpointHook?.Invoke(pending.RunId);
        if (!State.IsCurrentAgentRuntimeScope(retryScope))
            return;
        TopicDispatchResult result;
        try
        {
            result = await TopicRouter.SubmitAsync(draft, null, callbackLifetime.Token);
        }
        catch (Exception exception)
        {
            State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                var rejected = State.RecordAssistantAiDispatch(
                    requestScope,
                    TopicDispatchResult.Reject(
                        "dispatch_failed",
                        pending.RunId,
                        exception.Message));
                ApplyAssistantProjection(rejected.Request);
            });
            return;
        }
        State.TryApplyScopedAsyncOperation(operationScope, () =>
        {
            var transition = State.RecordAssistantAiDispatch(requestScope, result);
            ApplyAssistantProjection(transition.Request);
        });
        }
        finally
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                EnsureRosterScope();
                aiRetryRunning = false;
            });
        }
    }

    TopicSendDraftCleanup CreateDraftCleanup(
        ComposerRevisionSnapshot submittedDraft,
        TopicSendSnapshot submission)
    {
        if (!State.TryCaptureActiveThreadMutationScope(
                submission.ThreadId,
                out var presentationScope))
            throw new InvalidOperationException(
                "The active account changed before draft cleanup was scheduled.");
        return new(outcome => PersistSubmittedDraftCleanupAsync(
            submittedDraft,
            submission,
            presentationScope!,
            outcome,
            State,
            ComposerRevisions,
            null,
            callbackLifetime.Token));
    }

    static Task<TopicSendDraftCleanupResult> PersistSubmittedDraftCleanupAsync(
        ComposerRevisionSnapshot submittedDraft,
        TopicSendSnapshot submission,
        ActiveThreadMutationScope presentationScope,
        TopicSendOutcome outcome,
        AppState state,
        ComposerRevisionGuard revisions,
        Action<long>? cleared,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        if (outcome.Kind is TopicSendOutcomeKind.Rejected
            or TopicSendOutcomeKind.Failed
            or TopicSendOutcomeKind.RetryableFailed)
            state.RecordAssistantAiDispatch(
                presentationScope,
                submission.RunId,
                submission.OperationId,
                submission.LineId,
                TopicDispatchResult.Reject(
                    outcome.Handoff?.Code ?? "dispatch_failed",
                    submission.RunId,
                    outcome.Handoff?.Error
                    ?? outcome.Exception?.Message
                    ?? "The AI request could not be dispatched."));
        var result = state.CompareAndClearTopicDraft(
            presentationScope,
            submittedDraft.Revision);
        if (result == MeshDb.ComposerDraftClearResult.Superseded)
            return Task.FromResult(TopicSendDraftCleanupResult.DraftClearSuperseded);

        if (revisions.TryClear(submittedDraft, out var clearToken)
            && clearToken is not null)
            cleared?.Invoke(clearToken.ClearedRevision);
        else
            cleared?.Invoke(submittedDraft.Revision);
        return Task.FromResult(TopicSendDraftCleanupResult.DraftClearPersisted);
    }

    Task ReconcilePendingSend()
    {
        var snapshot = CurrentSendSnapshot;
        if (snapshot is null) return Task.CompletedTask;
        var submitted = new ComposerRevisionSnapshot(
            snapshot.ThreadId,
            snapshot.ComposerRevision,
            inputValue);
        ObserveComponentTask(
            TopicSends.RequestReconciliationAsync(
                snapshot,
                draftCleanup: CreateDraftCleanup(submitted, snapshot),
                cancellationToken: callbackLifetime.Token),
            "reconcile-topic-send");
        return Task.CompletedTask;
    }

    MeshDb.TopicComposerSnapshot CaptureComposerSnapshot(OwnThread thread)
        => new(
            inputValue,
            attachments
                .Select(file => MeshDb.ComposerDraftAttachment.Create(
                    file.Name,
                    file.Path,
                    file.Size))
                .ToArray(),
            widgetMode,
            selectedWidget?.Id ?? selectedWidgetId,
            ResolveTarget(thread).DeviceId,
            selectedWidget is null
                ? null
                : MeshDb.ComposerDraftWidget.Create(selectedWidget));

    void RestoreComposerSnapshot(MeshDb.TopicComposerSnapshot? snapshot)
    {
        attachments.Clear();
        widgetMode = snapshot?.WidgetMode ?? false;
        widgetPickerOpen = false;
        selectedWidget = snapshot?.Widget is not null
            ? RestoreWidget(snapshot.Widget)
            : snapshot?.WidgetId is null
                ? null
                : State.Profile.Widgets.FirstOrDefault(widget =>
                    string.Equals(widget.Id, snapshot.WidgetId, StringComparison.Ordinal));
        selectedWidgetId = snapshot?.WidgetId;
        widgetLoading = false;
        widgetLoadError = snapshot?.WidgetId is not null && selectedWidget is null
            ? "The saved widget is no longer available."
            : null;
        if (snapshot is null) return;
        foreach (var file in snapshot.Attachments)
        {
            attachments.Add(new StagedFile(file.Name, file.Path, file.Size));
            if (File.Exists(file.Path)) LocalFiles.Allow(file.Path);
        }
        if (snapshot.Widget is null
            && selectedWidget is not null
            && WidgetConsumerPolicy.RequiresBodyLoad(selectedWidget))
            ObserveComponentTask(
                HydrateSelectedWidgetAsync(selectedWidget.Id),
                "hydrate-restored-widget");
    }

    static Widget RestoreWidget(MeshDb.ComposerDraftWidget widget)
        => new()
        {
            Id = widget.Id,
            Name = widget.Name,
            Prompt = widget.Prompt,
            Html = widget.Html
        };

    private static readonly Dictionary<string, string> AttachmentMimes = new(StringComparer.OrdinalIgnoreCase)
    {
        [".png"] = "image/png", [".jpg"] = "image/jpeg", [".jpeg"] = "image/jpeg",
        [".gif"] = "image/gif", [".webp"] = "image/webp", [".bmp"] = "image/bmp",
        [".pdf"] = "application/pdf", [".txt"] = "text/plain", [".md"] = "text/markdown",
        [".json"] = "application/json", [".csv"] = "text/csv"
    };

    static async Task<IReadOnlyList<ChatAttachment>> LoadAttachmentsAsync(List<StagedFile> files, CancellationToken ct)
    {
        var result = new List<ChatAttachment>();
        foreach (var file in files)
        {
            if (file.Size > PickedFileStager.MaxAttachmentBytes) throw new InvalidOperationException($"{file.Name} is larger than the 20 MB attachment limit.");
            var extension = System.IO.Path.GetExtension(file.Path);
            var mime = AttachmentMimes.TryGetValue(extension, out var known) ? known : "application/octet-stream";
            var bytes = await System.IO.File.ReadAllBytesAsync(file.Path, ct);
            result.Add(new ChatAttachment(file.Name, mime, bytes));
        }
        return result;
    }

    static string BuildTurnPrompt(string text, Widget? widget, bool creatingWidget)
    {
        if (creatingWidget) return $"Build a widget: {text}";
        if (widget is null) return text;
        return string.IsNullOrWhiteSpace(text)
            ? $"Use widget: {widget.Name}"
            : $"Update widget {widget.Name}: {text}";
    }

    static string? BuildWidgetContext(Widget? widget, bool creatingWidget) =>
        widget is null && !creatingWidget
            ? null
            : System.Text.Json.JsonSerializer.Serialize(new
            {
                action = creatingWidget ? "build" : "useOrRefine",
                widget = widget is null ? null : new
                {
                    widget.Id,
                    widget.Name,
                    widget.Prompt,
                    widget.Html
                }
            });

    AgentExecutionHost ResolveTarget(OwnThread thread)
    {
        if (string.IsNullOrWhiteSpace(thread.AgentExecutionHostDeviceId))
            return executionHosts.FirstOrDefault() is { } eligible
                ? ToAgentExecutionHost(eligible)
                : new AgentExecutionHost(
                    "", null, global::Mesh.Shared.DevicePlatforms.Unknown);
        var known = DeviceChoices.FirstOrDefault(d =>
            string.Equals(d.DeviceId, thread.AgentExecutionHostDeviceId, StringComparison.Ordinal));
        return known is not null
               && global::Mesh.Shared.DeviceExecutionEligibility.IsEligible(known)
            ? ToAgentExecutionHost(known)
            : executionHosts.FirstOrDefault() is { } host
                ? ToAgentExecutionHost(host)
            : new AgentExecutionHost(
                thread.AgentExecutionHostDeviceId,
                thread.AgentExecutionHostDeviceName,
                thread.AgentExecutionHostDevicePlatform ?? global::Mesh.Shared.DevicePlatforms.Unknown);
    }

    static AgentExecutionHost ToAgentExecutionHost(global::Mesh.Shared.DeviceInfo device) =>
        new(device.DeviceId, device.Name, device.Platform);
    static CommunicationDestination ToCommunicationDestination(global::Mesh.Shared.DeviceInfo device) =>
        new(device.DeviceId, device.Name, device.Platform);

    bool IsCurrentDevice(global::Mesh.Shared.DeviceInfo device) =>
        string.Equals(device.DeviceId, Mesh.MyDeviceId, StringComparison.Ordinal);

    static bool CanCommunicateWith(global::Mesh.Shared.DeviceInfo device) =>
        global::Mesh.Shared.DeviceCommunicationReachability.IsAddressable(device);

    static string DeviceAvailability(global::Mesh.Shared.DeviceInfo? device) =>
        device is null
            ? "Presence unknown"
            : $"{(device.Online ? "Online" : "Offline")} · " +
              $"{(global::Mesh.Shared.DeviceExecutionEligibility.HasAgentHostCapability(device) ? "Agent ready" : "No agent runtime")}";

    bool IsTopicBusy(OwnThread thread) => RemoteRunActivity.IsBusy(
        thread,
        State.IsThreadBusy(thread.Id),
        State.GetRemoteRunProjection(thread.Id),
        IsExecutionRemote(thread),
        DateTimeOffset.UtcNow,
        UsesAuthoritativeState(thread));

    bool UsesAuthoritativeState(OwnThread thread) => RemoteRunActivity.UsesAuthoritativeState(
        Mesh.SupportsAuthoritativeTopicState,
        thread.AgentExecutionHostDeviceId,
        Mesh.MyDeviceId,
        executionHosts);

    bool IsAssignedElsewhere(OwnThread thread) =>
        !string.IsNullOrWhiteSpace(thread.CommunicationDestinationDeviceId)
        && !string.Equals(thread.CommunicationDestinationDeviceId, Mesh.MyDeviceId, StringComparison.Ordinal);

    bool IsExecutionRemote(OwnThread thread) =>
        !string.IsNullOrWhiteSpace(thread.AgentExecutionHostDeviceId)
        && !string.Equals(thread.AgentExecutionHostDeviceId, Mesh.MyDeviceId, StringComparison.Ordinal);

    bool IsDeviceOnline(string? deviceId)
    {
        if (string.IsNullOrWhiteSpace(deviceId)) return false;
        return rosterDevices.FirstOrDefault(d =>
            string.Equals(d.DeviceId, deviceId, StringComparison.Ordinal))?.Online == true;
    }

    bool IsActiveDevice(global::Mesh.Shared.DeviceInfo device) =>
        Active is not null
        && string.Equals(Active.CommunicationDestinationDeviceId ?? Mesh.MyDeviceId, device.DeviceId, StringComparison.Ordinal);

    static string FriendlyName(global::Mesh.Shared.DeviceInfo device) =>
        string.IsNullOrWhiteSpace(device.Name) ? PlatformName(device.Platform) : device.Name;

    static string FriendlyName(AgentExecutionHost device) =>
        string.IsNullOrWhiteSpace(device.DeviceName) ? PlatformName(device.Platform) : device.DeviceName;

    static string DeviceLabel(OwnThread thread) =>
        string.IsNullOrWhiteSpace(thread.CommunicationDestinationDeviceName)
            ? PlatformName(thread.CommunicationDestinationDevicePlatform)
            : thread.CommunicationDestinationDeviceName;

    static string ExecutionHostLabel(OwnThread thread) =>
        string.IsNullOrWhiteSpace(thread.AgentExecutionHostDeviceName)
            ? PlatformName(thread.AgentExecutionHostDevicePlatform)
            : thread.AgentExecutionHostDeviceName;

    string DeviceStatus(OwnThread thread)
    {
        var deviceId = thread.CommunicationDestinationDeviceId ?? Mesh.MyDeviceId;
        var device = rosterDevices.FirstOrDefault(item =>
            string.Equals(item.DeviceId, deviceId, StringComparison.Ordinal));
        return $"{DeviceLabel(thread)} · {DeviceAvailability(device)}";
    }

    static string PlatformName(string? platform) => platform?.ToLowerInvariant() switch
    {
        global::Mesh.Shared.DevicePlatforms.Windows => "Windows device",
        global::Mesh.Shared.DevicePlatforms.MacOS => "Mac",
        global::Mesh.Shared.DevicePlatforms.Android => "Android device",
        global::Mesh.Shared.DevicePlatforms.IOS => "iPhone or iPad",
        _ => "Linked device"
    };

    static string PlatformIcon(string? platform) => platform?.ToLowerInvariant() switch
    {
        global::Mesh.Shared.DevicePlatforms.Windows => "bi-windows",
        global::Mesh.Shared.DevicePlatforms.MacOS => "bi-apple",
        global::Mesh.Shared.DevicePlatforms.Android => "bi-android2",
        global::Mesh.Shared.DevicePlatforms.IOS => "bi-phone",
        _ => "bi-device-ssd"
    };

    // A short title from the first message of a new chat.
    static string Titleize(string text)
    {
        var clean = text.Replace("\r", " ").Replace("\n", " ").Trim();
        if (clean.Length == 0) return "New chat";
        return clean.Length > 40 ? clean[..40].TrimEnd() + "…" : clean;
    }

    void PinWidget(string html, ChatLine line)
    {
        pinHtml = html;
        pinName = "";
        pinPrompt = line.WidgetPrompt;
        pinError = null;
    }

    void OnPinKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(pinName)) ConfirmPin();
    }

    void ConfirmPin()
    {
        if (pinHtml is null || string.IsNullOrWhiteSpace(pinName)) return;
        var name = pinName.Trim();
        if (State.Profile.Widgets.Any(w => string.Equals(w.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            pinError = $"A widget named \"{name}\" already exists. Choose a different name.";
            return;
        }
        var widget = new Widget
        {
            Name = name,
            Html = pinHtml!,
            Prompt = pinPrompt ?? "Pinned from conversation",
            Visibility = "private",
            ModifiedAt = DateTimeOffset.UtcNow,
        };
        State.SaveAssetContent(AssetKind.Widget, widget.Id, p => p.Widgets.Add(widget));
        pinHtml = null;
        pinName = "";
        pinPrompt = null;
        pinError = null;
    }

    public ValueTask DisposeAsync()
    {
        disposalTask ??= DisposeCoreAsync();
        return new(disposalTask);
    }

    public void Dispose()
        => _ = DisposeAsync();

    async Task DisposeCoreAsync()
    {
        NotificationViews.Clear("mobile-topics");
        disposed = true;
        State.Changed -= Refresh;
        Mesh.StateChanged -= OnMeshStateChanged;
        Mesh.ReplicationStateChanged -= Refresh;
        var detachments = sendObserverSubscriptions.Values
            .Select(subscription => subscription.DisposeAsync().AsTask())
            .ToArray();
        sendObserverSubscriptions.Clear();
        callbackLifetime.Cancel();
        if (rosterRefreshLoop is not null)
        {
            try { await rosterRefreshLoop.ConfigureAwait(false); }
            catch (OperationCanceledException) { }
        }
        await Task.WhenAll(detachments).ConfigureAwait(false);
        callbackLifetime.Dispose();
        deviceRefreshes.Dispose();
        await ResetMobileThreadFlagAsync();
        selfRef?.Dispose();
    }

    async Task ResetMobileThreadFlagAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("meshUI.setMobileThreadOpen", false, asyncScopeOwner);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    void ObserveComponentTask(Task task, string operation)
    {
        _ = ObserveComponentTaskCore(task, operation);
    }

    static async Task ObserveComponentTaskCore(Task task, string operation)
    {
        try
        {
            await task.ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            RuntimeDiagnostics.Current?.RecordEvent(
                $"mobile-component-{operation}",
                $"exception={ex.GetType().FullName}");
        }
    }
}
