    // The picker lists body-less summaries; hydrate only the one the user selected so its HTML is
    // ready to use or refine. Never loads other widgets' bodies.
    async Task HydrateSelectedWidgetAsync(string id)
    {
        if (!WidgetConsumerPolicy.RequiresBodyLoad(selectedWidget)) return;
        var runtimeScope = State.CaptureAgentRuntimeScope();
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:widget:{id}",
            Active?.Id);
        widgetLoading = true;
        try
        {
            var full = await State.LoadFullWidgetAsync(id);
            State.TryApplyScopedAsyncOperation(operationScope, () =>
            {
                if (selectedWidget is null
                    || !string.Equals(selectedWidget.Id, id, StringComparison.Ordinal))
                    return;
                if (full is null) widgetLoadError = "Could not load this widget.";
                else
                {
                    selectedWidget = full;
                    selectedWidgetId = full.Id;
                    ScheduleComposerSnapshot();
                }
            });
        }
        catch (Exception ex)
        {
            State.TryApplyScopedAsyncOperation(
                operationScope,
                () => widgetLoadError = ex.Message);
        }
        finally
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => widgetLoading = false);
            await InvokeAsync(() =>
            {
                if (!disposed && State.IsCurrentAgentRuntimeScope(runtimeScope))
                    StateHasChanged();
            });
        }
    }

