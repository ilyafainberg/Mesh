@* Mobile "Me" agent chat screen. WhatsApp-style: a list of private topic chats
   that drills into a full-screen thread with the user's personal AI agent.
   The @code block is ported essentially verbatim from Components/Pages/Home.razor;
   the only adaptations are the DotNetObjectReference generic (MobileMe) and
   OnInitialized defaulting to the LIST view instead of auto-opening a thread. *@
@page "/m/me"
@inject AppState State
@inject AppShutdownCoordinator Shutdown
@inject AgentService Agent
@inject MeshClient Mesh
@inject ITopicExecutionRouter TopicRouter
@inject UiOperationCoordinator UiOperations
@inject TopicSendCoordinator TopicSends
@inject ComposerRevisionGuard ComposerRevisions
@inject LocalFileRegistry LocalFiles
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject NotificationViewState NotificationViews
@implements IAsyncDisposable
@implements IDisposable

<RendererDispatcherCapture DispatcherCaptured="CaptureObserverDispatcher" />
<MobileOverlayScope Active="@(newDeviceMenuOpen || moveMenuOpen || pendingMove is not null)" />

@if (Active is null)
{
    @* A) LIST screen: shown when no thread is selected, or the selected thread no longer exists. *@
    <div class="me-list">
        <header class="list-head">
            <h2><i class="bi bi-person-badge"></i> Me</h2>
            <p class="list-sub">your private topic chats</p>
        </header>

        <div class="new-chat-split">
            <button class="new-chat-primary" @onclick="NewThreadOnDefault"
                    disabled="@(communicationDevices.Count == 0)" aria-label="New chat on a linked device">
                <span class="new-chat-icon"><i class="bi bi-plus-lg"></i></span>
                <span class="new-chat-label">New chat</span>
                <span class="new-chat-device">Communication destination</span>
            </button>
            <button class="new-chat-menu-button" @onclick="OpenNewDeviceMenu" aria-label="Choose a device for new chat"
                    aria-haspopup="dialog" aria-expanded="@newDeviceMenuOpen">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>

        @if (State.Profile.OwnThreads.Count == 0)
        {
            <div class="list-empty">
                <i class="bi bi-chat-heart"></i>
                <p class="empty-title">No chats yet</p>
                <p class="empty-sub">Start a private topic chat with your personal agent using "New chat" above.</p>
            </div>
        }
        else
        {
            <div class="thread-rows" @ref="threadRowsEl">
                @foreach (var section in ThreadSections)
                {
                    <h3 class="thread-section-title">@section.Label</h3>
                    @foreach (var t in section.Threads)
                    {
                        <div class="thread-swipe-shell mobile-swipe-shell" data-swipe-id="@t.Id" @key="ThreadRenderKey(t)">
                            <button class="thread-swipe-action mobile-swipe-action @(t.IsPinned ? "unpin" : "pin")"
                                    tabindex="-1" aria-hidden="true"
                                    aria-label="@(t.IsPinned ? "Unpin" : "Pin") @(ThreadTitle(t))"
                                    @onclick="() => TogglePinFromSwipe(t)">
                                <i class="bi @(t.IsPinned ? "bi-pin-angle" : "bi-pin-angle-fill")"></i>
                                <span>@(t.IsPinned ? "Unpin" : "Pin")</span>
                            </button>
                            <div class="thread-row mobile-swipe-content">
                                <button class="thread-open" @onclick="() => Select(t.Id)">
                                    <span class="row-avatar"><i class="bi bi-chat-text"></i></span>
                                    <span class="row-main">
                                        <span class="row-title">@(string.IsNullOrWhiteSpace(t.Title) ? "New chat" : t.Title)</span>
                                        @if (IsAssignedElsewhere(t))
                                        {
                                            <span class="device-pill @(IsDeviceOnline(t.CommunicationDestinationDeviceId) ? "" : "offline")"
                                                  title="@DeviceStatus(t)">
                                                <i class="bi @PlatformIcon(t.CommunicationDestinationDevicePlatform)"></i>
                                                @DeviceLabel(t)
                                            </span>
                                        }
                                    </span>
                                    @if (IsTopicBusy(t))
                                    {
                                        <span class="topic-busy-indicator" title="Agent is working" aria-label="Agent is working">
                                            <i class="bi bi-arrow-repeat spin" aria-hidden="true"></i>
                                        </span>
                                    }
                                    else if (State.IsThreadCompleted(t.Id))
                                    {
                                        <span class="topic-unread" title="Agent finished" aria-label="Agent finished"></span>
                                    }
                                    @if (t.IsPinned) { <i class="bi bi-pin-angle-fill row-pin-status" title="Pinned" aria-label="Pinned"></i> }
                                    <i class="bi bi-chevron-right row-chevron"></i>
                                </button>
                                <button class="swipe-accessible-pin" @onclick="() => TogglePinFromSwipe(t)"
                                        aria-label="@(t.IsPinned ? "Unpin" : "Pin") @(ThreadTitle(t))">
                                    @(t.IsPinned ? "Unpin" : "Pin")
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>

    @if (newDeviceMenuOpen)
    {
        <MobileOverlayScope />
        <div class="sheet-scrim" @onclick="CloseDeviceMenus">
            <div class="device-sheet" role="dialog" aria-modal="true" aria-label="Choose a device" tabindex="-1" autofocus
                 @onclick:stopPropagation @onkeydown="OnDeviceMenuKey">
                <div class="sheet-handle"></div>
                <h3>Start a new chat</h3>
                @foreach (var device in DeviceChoices)
                {
                    <button class="device-choice"
                            disabled="@(!CanCommunicateWith(device))"
                            @onclick="() => NewThread(device)">
                        <i class="bi @PlatformIcon(device.Platform)"></i>
                        <span class="device-choice-main">
                            <strong>@(IsCurrentDevice(device) ? "Talk to this device" : $"Talk to {FriendlyName(device)}")</strong>
                            <small>@DeviceAvailability(device)</small>
                        </span>
                    </button>
                }
            </div>
        </div>
    }
}
else
{
    @* B) THREAD screen: full-screen overlay that covers the app bottom tab bar. *@
    <div class="thread-overlay">
        <header class="thread-bar">
            <button class="bar-btn back-btn" @onclick="() => activeThread = null" title="Back to chats" aria-label="Back to chats">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="thread-heading">
                <div class="thread-title-row">
                    <span class="bar-title">@(string.IsNullOrWhiteSpace(Active.Title) ? "New chat" : Active.Title)</span>
                    <button class="bar-btn more-btn" title="Topic actions" aria-label="Topic actions"
                            aria-haspopup="menu" aria-expanded="@actionsMenuOpen"
                            @onclick="ToggleActionsMenu"><i class="bi bi-three-dots-vertical"></i></button>
                </div>
                @if (IsAssignedElsewhere(Active))
                {
                    <span class="device-pill @(ActiveDeviceOnline ? "" : "offline")"
                          title="@DeviceStatus(Active)">
                        <i class="bi @PlatformIcon(Active.CommunicationDestinationDevicePlatform)"></i>
                        @DeviceLabel(Active)
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Active.AgentExecutionHostDeviceId))
                {
                    <span class="device-pill" title="AI execution host">
                        <i class="bi bi-cpu"></i>
                        AI host: @ExecutionHostLabel(Active)
                    </span>
                }
            </div>
            @if (actionsMenuOpen)
            {
                <div class="topic-actions-menu" role="menu" aria-label="Topic actions">
                    <button role="menuitem" @onclick="ToggleActivePinFromActions">
                        <i class="bi @(Active.IsPinned ? "bi-pin-angle" : "bi-pin-angle-fill")"></i>
                        @(Active.IsPinned ? "Unpin topic" : "Pin topic")
                    </button>
                    <button role="menuitem" @onclick="BeginRenameFromMenu"><i class="bi bi-pencil"></i> Rename</button>
                    <button role="menuitem" @onclick="OpenMoveMenuFromActions"><i class="bi bi-phone-flip"></i> Change communication destination</button>
                    <button role="menuitem" @onclick="OpenHostMenu"><i class="bi bi-cpu"></i> Change AI execution host</button>
                    @if (Active.Lines.Count > 0)
                    {
                        <button role="menuitem" @onclick="OpenReportFromActions"><i class="bi bi-flag"></i> Report AI content</button>
                    }
                    <button role="menuitem" class="danger-action" @onclick="ConfirmDeleteFromActions"><i class="bi bi-trash"></i> Clear or delete</button>
                </div>
            }
        </header>

        @if (confirmDelete)
        {
            <div class="topic-delete-bar">
                <button class="ghost" title="Clear messages, keep the chat" @onclick="ClearActive">Clear</button>
                <button class="danger" title="Delete this chat and its history" @onclick="DeleteActive">Delete</button>
                <button class="ghost icon-btn" title="Cancel" @onclick="() => confirmDelete = false" aria-label="Cancel"><i class="bi bi-x-lg"></i></button>
            </div>
        }

        @if (renaming)
        {
            <div class="rename-row">
                <input class="rename-input" @bind="renameText" @bind:event="oninput" @onkeydown="OnRenameKey" aria-label="Chat title" />
                <button class="primary" title="Save" @onclick="SaveRename" aria-label="Save title"><i class="bi bi-check-lg"></i> Save</button>
                <button class="ghost" title="Cancel" @onclick="() => renaming = false" aria-label="Cancel rename">Cancel</button>
            </div>
        }

        <div class="messages-frame">
            <div class="messages" @ref="scrollEl">
                <div class="messages-wrap">
                @{
                    var allVisibleLines = OrderedVisibleLines;
                    var renderedLines = MessageRenderWindow.Latest(allVisibleLines, messageRenderCount);
                    var hiddenMessageCount = MessageRenderWindow.HiddenCount(allVisibleLines.Count, messageRenderCount);
                    var transcriptItems = TopicTranscriptPresentation.Compose(
                        renderedLines, IsQueued, ActiveBusy ? Active.Id : null);
                }
                @if (hiddenMessageCount > 0)
                {
                    <div class="message-history-more">
                        <button type="button" class="ghost" @onclick="ShowEarlierMessages">
                            <i class="bi bi-clock-history"></i> Show @MessageRenderWindow.NextPageSize(allVisibleLines.Count, messageRenderCount) earlier messages
                        </button>
                    </div>
                }
                @if (Active.Lines.Count == 0)
                {
                    <div class="empty">
                        This is your private assistant. It knows everything in your Knowledge and Skills,
                        and helps you manage what your public agent shares with others. Ask it anything.
                    </div>
                }
                @foreach (var item in transcriptItems)
                {
                    if (item.Line is { } line)
                    {
                        var queued = IsQueued(line);
                        <div class="bubble @TopicTranscriptPresentation.BubbleRole(line)" @key="item.Key">
                            @if (!queued)
                            {
                                <ModelAttribution ModelId="@line.ModelId" />
                                @if (!string.IsNullOrEmpty(line.Reasoning))
                                {
                                    <button class="reasoning-toggle" @onclick="() => ToggleReasoning(line)" aria-label="Show reasoning">
                                        <i class="bi bi-lightbulb"></i>
                                        <span>Reasoning</span>
                                        <i class="bi @(expandedReasoning.Contains(line) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    </button>
                                    @if (expandedReasoning.Contains(line))
                                    {
                                        <div class="reasoning-body">@((MarkupString)Markdown.ToHtml(line.Reasoning!))</div>
                                    }
                                }
                            }
                            <MessageActions Markdown="@line.Text" IsMobile="true" IsInternal="@line.Internal">
                                <MessageContent Text="@line.Text" Attachments="@line.Attachments"
                                                OnPin="html => PinWidget(html, line)" />
                            </MessageActions>
                            @if (queued)
                            {
                                <div class="msg-tag queue-tag">
                                    <i class="bi @QueueIcon(line)"></i>
                                    <span>@QueueLabel(line)</span>
                                    <button type="button" class="queue-cancel" title="Cancel queued turn"
                                            aria-label="Cancel queued turn" @onclick="() => CancelQueued(line)"
                                            disabled="@IsQueuedCancellationPending(line)"
                                            @onclick:stopPropagation="true">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bubble assistant" @key="item.Key">
                            @{ var run = Active is null ? null : State.AgentRunFor(Active.Id); }
                            @if (run is not null)
                            {
                                @if (run.Phase == AgentRunPhase.Planning)
                                {
                                    <div class="planning-row"><i class="bi bi-diagram-3"></i> Planning</div>
                                }
                                else
                                {
                                    <div class="text md">@((MarkupString)Markdown.ToHtml(run.Plan))</div>
                                    <div class="msg-tag"><i class="bi bi-diagram-3"></i> @run.Phase.ToString().ToLowerInvariant()</div>
                                }
                            }
                            @{ var steps = Active is null ? null : State.AgentStepsFor(Active.Id); }
                            @if (steps is { Count: > 0 })
                            {
                                <div class="agent-steps">
                                    @foreach (var s in steps)
                                    {
                                        <div class="agent-step-item">
                                            <div class="agent-step @s.State.ToString().ToLowerInvariant()">
                                                <i class="bi @StepIcon(s.State)"></i>
                                                <span>@s.Label</span>
                                            </div>
                                            @if (showStepDetails && (!string.IsNullOrEmpty(s.Arguments) || !string.IsNullOrEmpty(s.Result)))
                                            {
                                                <div class="agent-step-detail">
                                                    @if (!string.IsNullOrEmpty(s.Arguments))
                                                    {
                                                        <ToolStepDetail Tool="@(s.ToolName ?? s.Tool)"
                                                                        Content="@s.Arguments" />
                                                    }
                                                    @if (!string.IsNullOrEmpty(s.Result))
                                                    {
                                                        <ToolStepDetail Tool="@(s.ToolName ?? s.Tool)"
                                                                        Content="@s.Result" IsOutput="true" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <button class="step-details-toggle" @onclick="() => showStepDetails = !showStepDetails">
                                    <i class="bi @(showStepDetails ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    @(showStepDetails ? "Hide details" : "Show details")
                                </button>
                            }
                            @{ var draft = Active is null ? null : State.AssistantDraftFor(Active.Id); }
                            @if (draft is { HasReasoning: true })
                            {
                                <button class="reasoning-toggle" @onclick="ToggleDraftReasoning" aria-label="Show reasoning">
                                    <i class="bi bi-lightbulb"></i>
                                    <span>Reasoning</span>
                                    <i class="bi @(draftReasoningExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </button>
                                @if (draftReasoningExpanded)
                                {
                                    <div class="reasoning-body">@((MarkupString)Markdown.ToHtml(draft.Reasoning))</div>
                                }
                            }
                            @if (draft is { HasAnswer: true })
                            {
                                <div class="text md">@((MarkupString)Markdown.ToHtml(draft.Answer))</div>
                            }
                            @if (RemoteRun is { } remote)
                            {
                                @if (!string.IsNullOrWhiteSpace(remote.Plan))
                                {
                                    <div class="text md">@((MarkupString)Markdown.ToHtml(remote.Plan))</div>
                                }
                                <div class="planning-row">
                                    <i class="bi bi-arrow-repeat spin"></i>
                                    @RemoteRunPresentation.StatusLabel(remote)
                                </div>
                                @if (remote.Steps is { Count: > 0 })
                                {
                                    <div class="agent-steps">
                                        @foreach (var step in remote.Steps)
                                        {
                                            <div class="agent-step-item">
                                                <div class="agent-step @step.State.ToString().ToLowerInvariant()">
                                                    <i class="bi @RemoteStepIcon(step.State)"></i>
                                                    <span>@step.Label</span>
                                                </div>
                                                @if (showStepDetails && (!string.IsNullOrEmpty(step.Arguments) || !string.IsNullOrEmpty(step.Result)))
                                                {
                                                    <div class="agent-step-detail">
                                                        @if (!string.IsNullOrEmpty(step.Arguments))
                                                        {
                                                            <ToolStepDetail Tool="@(step.ToolName ?? step.Tool)"
                                                                            Content="@step.Arguments" />
                                                        }
                                                        @if (!string.IsNullOrEmpty(step.Result))
                                                        {
                                                            <ToolStepDetail Tool="@(step.ToolName ?? step.Tool)"
                                                                            Content="@step.Result" IsOutput="true" />
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <button class="step-details-toggle" @onclick="() => showStepDetails = !showStepDetails">
                                        <i class="bi @(showStepDetails ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        @(showStepDetails ? "Hide details" : "Show details")
                                    </button>
                                }
                                @if (remote.Queued > 0)
                                {
                                    <div class="msg-tag"><i class="bi bi-hourglass-split"></i> @remote.Queued queued</div>
                                }
                            }
                            else if (run?.Phase != AgentRunPhase.Planning
                                     && (draft is null or { HasReasoning: false, HasAnswer: false }))
                            {
                                <div class="text muted">@(ActiveBuilding ? "…building widget" : "…thinking")</div>
                            }
                        </div>
                    }
                }
                @if (Active is not null)
                {
                    @foreach (var bubble in State.AskUserPromptsFor(Active.Id))
                    {
                        <AskUserBubble Bubble="@bubble"
                                       IsResolving="@askResolving.Contains(bubble.PromptId)"
                                       IsFocused="@(bubble.PromptId == State.FocusedAskUserPromptId)"
                                       OnSelect="optionId => ResolveAskAsync(bubble.PromptId, optionId)" />
                    }
                }
                </div>
            </div>
            <button type="button" class="scroll-to-latest" @ref="scrollToLatestEl" hidden aria-hidden="true"
                    title="Jump to latest message" aria-label="Jump to latest message" @onclick="ScrollToLatest">
                <i class="bi bi-arrow-down"></i>
            </button>
        </div>

        <div class="composer-area">
            <div class="composer-inner">
                @if (pinHtml is not null)
                {
                    <div class="pin-bar">
                        <i class="bi bi-pin-angle"></i>
                        <input @bind="pinName" placeholder="Name this widget…" @onkeydown="OnPinKey" aria-label="Name this widget" />
                        <button class="primary" @onclick="ConfirmPin" disabled="@string.IsNullOrWhiteSpace(pinName)">Pin</button>
                        <button class="ghost icon-btn" @onclick="() => { pinHtml = null; pinError = null; }" title="Cancel" aria-label="Cancel"><i class="bi bi-x-lg"></i></button>
                    </div>
                    @if (pinError is not null) { <p class="err-text" role="alert">@pinError</p> }
                }
                @if (widgetMode)
                {
                    <div class="mode-chip">
                        <i class="bi bi-window-stack"></i> widget
                        <button class="chip-x" @onclick="ClearWidgetMode" title="Cancel widget" aria-label="Cancel widget"><i class="bi bi-x"></i></button>
                        <span class="mode-hint">describe the mini-app you want</span>
                    </div>
                }
                else if (selectedWidget is not null)
                {
                    <div class="mode-chip selected-widget-chip">
                        <i class="bi bi-window-stack"></i>
                        <span class="widget-chip-name">@selectedWidget.Name</span>
                        <button class="chip-x" @onclick="ClearWidgetMode" title="Remove widget" aria-label="Remove selected widget"><i class="bi bi-x"></i></button>
                        @if (widgetLoading)
                        {
                            <span class="mode-hint">loading widget…</span>
                        }
                        else if (widgetLoadError is not null)
                        {
                            <span class="mode-hint err-text" role="alert">@widgetLoadError</span>
                        }
                        else
                        {
                            <span class="mode-hint">send to use, or describe changes</span>
                        }
                    </div>
                }
                @if (attachments.Count > 0)
                {
                    <div class="attach-bar">
                        @foreach (var a in attachments)
                        {
                            <span class="attach-chip">
                                <i class="bi bi-paperclip"></i>
                                <span class="attach-name">@a.Name</span>
                                <span class="attach-size">@a.SizeLabel</span>
                                <button class="chip-x" @onclick="() => RemoveAttachment(a)" title="Remove" aria-label="Remove attachment"><i class="bi bi-x"></i></button>
                            </span>
                        }
                    </div>
                }
                <div class="composer">
                    <div class="widget-picker-anchor">
                        <button class="ghost icon-btn plus-btn @(widgetMode || selectedWidget is not null || widgetPickerOpen ? "on" : "")"
                                @onclick="ToggleWidgetPicker" disabled="@ActiveBusy" title="Create or choose a widget"
                                aria-label="Create or choose a widget" aria-haspopup="menu" aria-expanded="@widgetPickerOpen"
                                aria-controls="mobile-widget-picker">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        @if (widgetPickerOpen)
                        {
                            <div id="mobile-widget-picker" class="widget-picker" role="menu" aria-label="Choose a widget">
                                <button class="widget-picker-item widget-picker-create" role="menuitem" @onclick="CreateNewWidget">
                                    <i class="bi bi-magic"></i>
                                    <span>Create new widget</span>
                                </button>
                                <div class="widget-picker-separator" role="separator"></div>
                                @if (State.Profile.Widgets.Count == 0)
                                {
                                    <div class="widget-picker-empty">No saved widgets yet</div>
                                }
                                else
                                {
                                    <div class="widget-picker-list">
                                        @foreach (var widget in State.Profile.Widgets)
                                        {
                                            <button class="widget-picker-item" role="menuitem" @onclick="() => SelectWidget(widget)" @key="widget.Id">
                                                <i class="bi bi-window-stack"></i>
                                                <span>@widget.Name</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <button class="ghost icon-btn plus-btn" @onclick="PickFile" disabled="@ActiveBusy" title="Attach an image or document" aria-label="Attach an image or document">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    <textarea @ref="composerEl" @bind="input" @bind:event="oninput" rows="1" class="composer-input"
                              placeholder="@ComposerPlaceholder" aria-label="@ComposerAriaLabel"></textarea>
                    <button class="primary send-btn" @onclick="PrimaryComposerAction" disabled="@(!CanSend || SendPending)"
                            title="@PrimaryActionTitle" aria-label="@PrimaryActionLabel">
                        <i class="bi bi-send"></i>
                    </button>
                    @if (ShowStopAction)
                    {
                        <button class="primary send-btn stop-btn" @onclick="StopActive"
                                disabled="@StopPending"
                                title="@(StopPending ? "Cancellation pending" : "Stop current run")"
                                aria-label="@(StopPending ? "Cancellation pending" : "Stop current run")">
                            <i class="bi bi-stop-fill"></i>
                        </button>
                    }
                    else
                    {
                        @if (IsCommunicationTopic)
                        {
                            <button class="ghost" @onclick="RequestAiResponse" disabled="@(!CanSend || SendPending)"
                                    title="Request an AI response on the selected agent host"
                                    aria-label="Ask assistant">Ask assistant</button>
                        }
                        else
                        {
                            <button class="ghost" @onclick="Send" disabled="@(!CanSend)"
                                    title="Send message without requesting an AI response"
                                    aria-label="Send message only">Send message only</button>
                        }
                    }
                </div>
                @if (TopicRestorePending)
                {
                    <div class="warn-banner" role="status"><i class="bi bi-arrow-repeat"></i> Restoring local topic state…</div>
                }
                @if (SendPending)
                {
                    <div class="warn-banner" role="status" aria-live="polite">
                        <i class="bi bi-arrow-repeat spin"></i>
                        @(ReconciliationPending
                            ? "Checking the durable handoff status…"
                            : "Preparing durable local handoff…")
                        @if (ReconciliationPending)
                        {
                            <button class="link-btn" @onclick="ReconcilePendingSend" aria-label="Check status">Check status</button>
                        }
                    </div>
                }
                else if (ReconciliationPending)
                {
                    <div class="warn-banner" role="status" aria-live="polite">
                        <i class="bi bi-shield-exclamation"></i>
                        Durable handoff status is unavailable. No duplicate was submitted.
                        <button class="link-btn" @onclick="ReconcilePendingSend" aria-label="Retry status">Retry status</button>
                    </div>
                }
                @if (VisibleOperationError is not null)
                {
                    <p class="err-text" role="alert">
                        @VisibleOperationError
                        @if (aiRetryAvailable)
                        {
                            <button class="link-btn" @onclick="RetryAiResponse" aria-label="Retry AI response">Retry AI response</button>
                            <button class="link-btn" @onclick="OpenHostMenu">Change AI host</button>
                        }
                    </p>
                }
                else if (aiRetryAvailable)
                {
                    <p class="err-text" role="status" aria-live="polite">
                        Message saved. AI response retry pending.
                        <button class="link-btn" @onclick="RetryAiResponse" aria-label="Retry AI response">Retry AI response</button>
                        <button class="link-btn" @onclick="OpenHostMenu">Change AI host</button>
                    </p>
                }
                @if (capacityBlockedSubmission is not null)
                {
                    <p class="err-text" role="alert" aria-live="assertive">
                        Too many topic sends are being prepared right now. Your draft is unchanged.
                        <button class="link-btn" @onclick="RetryCapacityBlockedSend">Retry send</button>
                    </p>
                }
                @if (DraftError is not null)
                {
                    <p class="err-text" role="alert">
                        @DraftError <button class="link-btn" @onclick="RetryDraft">Retry save</button>
                    </p>
                }
                @if (Active is not null && !ActiveExecutionEligible)
                {
                    <div class="warn-banner" role="status">
                        <i class="bi bi-exclamation-triangle"></i>
                        AI response unavailable. Messages remain saved; connect or choose an online agent-ready Desktop.
                        @if (Active.Lines.Any(line => line.Role == "user"))
                        {
                            <button class="link-btn" @onclick="RetryAiResponse" aria-label="Retry AI response">Retry AI response</button>
                        }
                        <button class="link-btn" @onclick="OpenHostMenu">Change AI host</button>
                    </div>
                }
                @if (ActiveUsesCurrentDevice && !Agent.IsModelReady)
                {
                    <div class="warn-banner"><i class="bi bi-exclamation-triangle"></i> No model configured. Go to <a href="settings">Settings</a>.</div>
                }
                else if (ActiveUsesCurrentDevice && QuotaExhausted)
                {
                    <div class="warn-banner">
                        <i class="bi bi-hourglass-bottom"></i>
                        Today's free-model limit is reached. <a href="settings">Add your own model key</a> for unlimited use, or switch to an on-device model.
                    </div>
                }
            </div>
        </div>
    </div>

    @if (moveMenuOpen)
    {
        <MobileOverlayScope />
        <div class="sheet-scrim" @onclick="CloseDeviceMenus">
            <div class="device-sheet" role="dialog" aria-modal="true" aria-label="Move topic to device" tabindex="-1" autofocus
                 @onclick:stopPropagation @onkeydown="OnDeviceMenuKey">
                <div class="sheet-handle"></div>
                <h3>Move topic</h3>
                <p class="sheet-copy">The full topic history stays with this chat.</p>
                @foreach (var device in DeviceChoices)
                {
                    <button class="device-choice"
                            disabled="@(!CanCommunicateWith(device) || IsActiveDevice(device))"
                            @onclick="() => ChooseMoveTarget(device)">
                        <i class="bi @PlatformIcon(device.Platform)"></i>
                        <span class="device-choice-main">
                            <strong>@(IsCurrentDevice(device) ? "This device" : FriendlyName(device))</strong>
                            <small>@DeviceAvailability(device)</small>
                        </span>
                    </button>
                }
                @if (hostMenuOpen)
                {
                    <MobileOverlayScope />
                    <div class="sheet-scrim" @onclick="CloseDeviceMenus">
                        <div class="device-sheet" role="dialog" aria-modal="true" aria-label="Change AI execution host" tabindex="-1" autofocus
                             @onclick:stopPropagation @onkeydown="OnDeviceMenuKey">
                            <div class="sheet-handle"></div>
                            <h3>Change AI execution host</h3>
                            <p class="sheet-copy">Only an online agent-ready Desktop can run the assistant.</p>
                            @foreach (var device in executionHosts)
                            {
                                <button class="device-choice"
                                        disabled="@(!global::Mesh.Shared.DeviceExecutionEligibility.IsEligible(device))"
                                        @onclick="() => ChooseExecutionHost(device)">
                                    <i class="bi @PlatformIcon(device.Platform)"></i>
                                    <span class="device-choice-main">
                                        <strong>@FriendlyName(device)</strong>
                                        <small>Online · Agent ready</small>
                                    </span>
                                </button>
                            }
                            @if (executionHosts.Count == 0)
                            {
                                <p class="sheet-copy" role="status">No online agent-ready Desktop is available.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    @if (pendingMove is not null)
    {
        <MobileOverlayScope />
        <div class="sheet-scrim">
            <div class="confirm-card" role="alertdialog" aria-modal="true" aria-labelledby="move-confirm-title" tabindex="-1" autofocus
                 @onkeydown="OnDeviceMenuKey">
                <h3 id="move-confirm-title">Move running topic?</h3>
                <p>The current run will be stopped before this topic moves to @FriendlyName(pendingMove).</p>
                <div class="confirm-actions">
                    <button class="ghost" @onclick="() => pendingMove = null">Cancel</button>
                    <button class="primary" @onclick="ConfirmRunningMove">Stop and move</button>
                </div>
            </div>
        </div>
    }
}

