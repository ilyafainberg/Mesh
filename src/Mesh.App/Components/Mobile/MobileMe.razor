    async Task ChooseMoveTarget(global::Mesh.Shared.DeviceInfo device)
    {
        if (Active is null
            || !global::Mesh.Shared.DeviceCommunicationReachability.IsAddressable(device)
            || IsActiveDevice(device)) return;
        var scope = State.CaptureActiveThreadMutationScope(Active.Id);
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:communication-move:{Active.Id}",
            Active.Id);
        IReadOnlyList<global::Mesh.Shared.DeviceInfo> freshDevices;
        try
        {
            freshDevices = await TopicRouter.ListDevicesAsync(callbackLifetime.Token);
        }
        catch (Exception exception)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError =
                    $"Could not verify the communication destination: {exception.Message}");
            return;
        }
        if (!State.IsCurrentScopedAsyncOperation(operationScope)
            || !State.IsCurrentActiveThreadMutationScope(scope)) return;
        var fresh = freshDevices.FirstOrDefault(candidate =>
            string.Equals(candidate.DeviceId, device.DeviceId, StringComparison.Ordinal)
            && global::Mesh.Shared.DeviceCommunicationReachability.IsAddressable(candidate));
        if (fresh is null)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError =
                    $"{FriendlyName(device)} is no longer a communication destination.");
            return;
        }
        State.TryCompleteScopedAsyncOperation(operationScope, () =>
        {
            moveMenuOpen = false;
            MoveActiveTo(fresh, scope);
        });
    }

    async Task ChooseExecutionHost(global::Mesh.Shared.DeviceInfo device)
    {
        if (Active is null) return;
        var threadScope = State.CaptureActiveThreadMutationScope(Active.Id);
        var requestScope = State.GetPendingAssistantAiRequest(Active.Id) is { } pendingRequest
            ? State.CaptureAssistantAiRequestMutationScope(pendingRequest)
            : null;
        var runtimeScope = State.CaptureAgentRuntimeScope();
        using var runtimeContext = State.EnterAgentRuntimeScope(runtimeScope);
        var threadId = Active.Id;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:execution-host:{threadId}",
            threadId,
            requestId: requestScope?.OperationId,
            runId: requestScope?.RunId);
        IReadOnlyList<global::Mesh.Shared.DeviceInfo> freshDevices;
        try
        {
            freshDevices = await TopicRouter.ListEligibleDevicesAsync(callbackLifetime.Token);
            if (!State.IsCurrentAgentRuntimeScope(runtimeScope)) return;
        }
        catch (Exception exception)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError = $"Could not verify the AI host: {exception.Message}");
            return;
        }
        var fresh = freshDevices.FirstOrDefault(candidate =>
            string.Equals(candidate.DeviceId, device.DeviceId, StringComparison.Ordinal)
            && global::Mesh.Shared.DeviceExecutionEligibility.IsEligible(candidate));
        if (fresh is null)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError =
                    $"{FriendlyName(device)} is no longer online and agent-ready.");
            return;
        }
        if (ActiveBusy)
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError =
                    "Stop the active run before changing the AI execution host.");
            return;
        }
        var host = ToAgentExecutionHost(fresh);
        State.TryCompleteScopedAsyncOperation(operationScope, () =>
        {
            if (!State.MoveOwnThreadAgentExecutionHost(
                    threadScope,
                    host,
                    requestScope,
                    operationScope: operationScope))
                return;
            attachError = null;
            CloseDeviceMenus();
        });
    }

    async Task ConfirmRunningMove()
    {
        var target = pendingMove;
        pendingMove = null;
        if (target is null || Active is null) return;
        var thread = Active;
        var runId = RemoteRun?.RunId
                    ?? thread.ExecutionRunId
                    ?? State.AgentRunFor(thread.Id)?.RunId;
        if (string.IsNullOrWhiteSpace(runId)) return;
        var threadScope = State.CaptureActiveThreadMutationScope(thread.Id);
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:confirm-move:{thread.Id}",
            thread.Id,
            runId: runId);
        if (!await TopicRouter.StopAsync(operationScope, callbackLifetime.Token))
        {
            State.TryCompleteScopedAsyncOperation(
                operationScope,
                () => attachError = "The active run could not be stopped.");
            return;
        }
        State.TryCompleteScopedAsyncOperation(
            operationScope,
            () => MoveActiveTo(target, threadScope, operationScope));
    }

    void MoveActiveTo(
        global::Mesh.Shared.DeviceInfo device,
        ActiveThreadMutationScope? capturedScope = null,
        ScopedAsyncOperation? operationScope = null)
    {
        if (Active is null
            || !global::Mesh.Shared.DeviceCommunicationReachability.IsAddressable(device)) return;
        var scope = capturedScope ?? State.CaptureActiveThreadMutationScope(Active.Id);
        if (!State.MoveOwnThreadCommunicationDestination(
                scope,
                ToCommunicationDestination(device),
                operationScope: operationScope))
            return;
        ScheduleComposerSnapshot();
        CloseDeviceMenus();
    }

