    async Task SelectWidget(Widget widget)
    {
        widgetPickerOpen = false;
        widgetMode = false;
        selectedWidget = widget;
        selectedWidgetId = widget.Id;
        widgetLoadError = null;
        ScheduleComposerSnapshot();
        await HydrateSelectedWidgetAsync(widget.Id);
    }

    // The picker lists body-less summaries; hydrate only the one the user selected so its HTML is
    // ready to use or refine. Never loads other widgets' bodies.
    async Task HydrateSelectedWidgetAsync(string id)
    {
        if (!WidgetConsumerPolicy.RequiresBodyLoad(selectedWidget)) return;
        widgetLoading = true;
        try
        {
            var full = await State.LoadFullWidgetAsync(id);
            if (selectedWidget is not null && string.Equals(selectedWidget.Id, id, StringComparison.Ordinal))
            {
                if (full is null) widgetLoadError = "Could not load this widget.";
                else
                {
                    selectedWidget = full;
                    selectedWidgetId = full.Id;
                    ScheduleComposerSnapshot();
                }
            }
        }
        catch (Exception ex)
        {
            widgetLoadError = ex.Message;
        }
        finally
        {
            widgetLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    void ClearWidgetMode()
    {
        widgetPickerOpen = false;
        widgetMode = false;
        selectedWidget = null;
        selectedWidgetId = null;
        widgetLoading = false;
        widgetLoadError = null;
        ScheduleComposerSnapshot();
    }

    void RemoveAttachment(StagedFile attachment)
    {
        if (attachments.Remove(attachment))
            ScheduleComposerSnapshot();
    }

    long ScheduleComposerSnapshot()
    {
        var thread = Active;
        if (activeThreadValue is null || thread is null) return 0;
        var snapshot = CaptureComposerSnapshot(thread);
        try
        {
            inputRevision = State.SetTopicDraftSnapshotRevision(
                activeThreadValue,
                snapshot);
            attachError = null;
        }
        catch (Exception exception)
        {
            RuntimeDiagnostics.Current?.RecordEvent(
                "topic-draft-stage-failed",
                $"thread={TopicSendSnapshot.StableId("thread", thread.Id)};"
                + $"exception={exception.GetType().FullName}");
            attachError = "The latest edit could not be staged durably. Retry before sending.";
            return 0;
        }
        if (inputRevision > 0)
            ComposerRevisions.SetExact(activeThreadValue, inputRevision, inputValue);
        return inputRevision;
    }

    void OpenReport()
    {
        var thread = Active;
        if (thread is null || thread.Lines.Count == 0) return;
        reportDialog?.Show($"Me topic: {thread.Title}", thread.Lines,
            l => l.Role == "assistant" ? "agent" : "me", State.CurrentModelKey());
    }

