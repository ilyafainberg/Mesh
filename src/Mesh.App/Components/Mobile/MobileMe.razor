        {
            await JS.InvokeVoidAsync("meshUI.prepareForNativePicker", composerEl);
            var file = await Microsoft.Maui.Storage.FilePicker.Default.PickAsync();
            if (file is null) return;
            await using var stream = await file.OpenReadAsync();
            var staged = await PickedFileStager.StageAsync(file.FileName, file.ContentType, stream);
            LocalFiles.Allow(staged.Path);
            attachments.Add(new StagedFile(staged.Name, staged.Path, staged.Size));
        }
        catch (Exception ex) { attachError = "Couldn't attach that file: " + ex.Message; }
    }

    static string Human(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }

    async Task StopActive()
    {
        var thread = Active;
        var runId = RemoteRun?.RunId ?? thread?.ExecutionRunId ?? State.AgentRunFor(thread?.Id ?? "")?.RunId;
        if (thread is null || string.IsNullOrWhiteSpace(runId)) return;
        try
        {
            var stopped = await TopicRouter.StopAsync(thread.Id, runId, CancellationToken.None);
            // No live run to cancel (a stranded run id from a completed or lost remote run): reconcile
            // locally so the phantom "thinking" indicator and Stop button clear immediately.
            if (!stopped && RemoteRun is null && IsAssignedElsewhere(thread))
                State.ClearRemoteRunProjection(thread.Id, runId);
        }
        catch (Exception ex)
        {
            attachError = $"Could not stop this run: {ex.Message}";
        }
    }

    async Task Send()
    {
        if (!CanSend) return;

        var text = input;
        var thread = Active ?? State.NewOwnThread("New chat", ToExecutionDevice(CurrentDevice));
        activeThread = thread.Id;
        input = text;
        var chosenWidget = selectedWidget;
        var titleText = !string.IsNullOrWhiteSpace(text)
            ? text
            : chosenWidget is not null ? $"Use widget: {chosenWidget.Name}" : "";
        if (string.Equals(thread.Title, "New chat", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(titleText))
            State.RenameOwnThread(thread.Id, Titleize(titleText));

        var files = attachments.ToList();
        var wasWidget = widgetMode;
        var target = ResolveTarget(thread);

        if (string.IsNullOrWhiteSpace(thread.ExecutionDeviceId))
            State.BindOwnThreadForSend(thread.Id, target);

        IReadOnlyList<ChatAttachment> loadedAttachments;
        try
        {
            loadedAttachments = await LoadAttachmentsAsync(files, CancellationToken.None);
        }
        catch (Exception ex)
        {
            attachError = $"Could not read the attachments: {ex.Message}";
            return;
        }

        var runId = Guid.NewGuid().ToString("n");
        var prompt = BuildTurnPrompt(text, chosenWidget, wasWidget);
        var trigger = new ChatLine
        {
            Id = Guid.NewGuid().ToString("n"),
            Role = "user",
            Text = prompt,
            Attachments = loadedAttachments.ToList(),
            At = DateTimeOffset.UtcNow
        };
        scrollToLatestRequested = true;
        State.AddOwnChatLine(thread.Id, trigger);

        // Hydrate a picker summary's body before it is sent so the widget context is never blank.
        if (WidgetConsumerPolicy.RequiresBodyLoad(chosenWidget))
        {
            var full = await State.LoadFullWidgetAsync(chosenWidget!.Id);
            if (full is not null) chosenWidget = full;
        }

        var widgetContext = BuildWidgetContext(chosenWidget, wasWidget);
        var draft = new TopicTurnDraft(
            runId,
            thread.Id,
            trigger.Id,
            State.Profile.Handle,
            prompt,
            trigger.At,
            State.Profile.PlanBeforeActing ? global::Mesh.Shared.TopicTurnMode.Autonomous : global::Mesh.Shared.TopicTurnMode.Single,
            target.DeviceId,
            chosenWidget?.Id,
            widgetContext,
            loadedAttachments);

        var clearedVisibleDraft = ClearSubmittedDraft(thread.Id, text);
        attachments.Clear();
        widgetMode = false;
        widgetPickerOpen = false;
        selectedWidget = null;
        widgetLoading = false;
        widgetLoadError = null;
        attachError = null;
        if (clearedVisibleDraft) _ = ResetComposer();

        // Paint the persisted prompt before dispatch can classify it as queued or start streaming.
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await TopicRouter.SubmitAsync(draft, null, CancellationToken.None);
            if (!result.Accepted)
            {
                attachError = result.Error ?? $"The topic turn was not accepted ({result.Code}).";
                State.AddOwnChatLine(thread.Id, new ChatLine
                {
                    Role = "assistant",
                    Text = $"[{attachError}]",
                    ReplyToLineId = trigger.Id
                });
            }
        }
        catch (Exception ex)
        {
            attachError = $"Could not send this topic turn: {ex.Message}";
            State.AddOwnChatLine(thread.Id, new ChatLine
            {
                Role = "assistant",
                Text = $"[{attachError}]",
                ReplyToLineId = trigger.Id
            });
        }
    }

    private static readonly Dictionary<string, string> AttachmentMimes = new(StringComparer.OrdinalIgnoreCase)
    {
        [".png"] = "image/png", [".jpg"] = "image/jpeg", [".jpeg"] = "image/jpeg",
        [".gif"] = "image/gif", [".webp"] = "image/webp", [".bmp"] = "image/bmp",
        [".pdf"] = "application/pdf", [".txt"] = "text/plain", [".md"] = "text/markdown",
        [".json"] = "application/json", [".csv"] = "text/csv"
    };

    static async Task<IReadOnlyList<ChatAttachment>> LoadAttachmentsAsync(List<StagedFile> files, CancellationToken ct)
    {
        var result = new List<ChatAttachment>();
        foreach (var file in files)
        {
            if (file.Size > PickedFileStager.MaxAttachmentBytes) throw new InvalidOperationException($"{file.Name} is larger than the 20 MB attachment limit.");
            var extension = System.IO.Path.GetExtension(file.Path);
            var mime = AttachmentMimes.TryGetValue(extension, out var known) ? known : "application/octet-stream";
            var bytes = await System.IO.File.ReadAllBytesAsync(file.Path, ct);
            result.Add(new ChatAttachment(file.Name, mime, bytes));
        }
        return result;
    }

    static string BuildTurnPrompt(string text, Widget? widget, bool creatingWidget)
    {
        if (creatingWidget) return $"Build a widget: {text}";
        if (widget is null) return text;
        return string.IsNullOrWhiteSpace(text)
            ? $"Use widget: {widget.Name}"
            : $"Update widget {widget.Name}: {text}";
    }

    static string? BuildWidgetContext(Widget? widget, bool creatingWidget) =>
        widget is null && !creatingWidget
            ? null
            : System.Text.Json.JsonSerializer.Serialize(new
            {
                action = creatingWidget ? "build" : "useOrRefine",
                widget = widget is null ? null : new
                {
                    widget.Id,
                    widget.Name,
                    widget.Prompt,
                    widget.Html
                }
            });

    ExecutionDevice ResolveTarget(OwnThread thread)
    {
        if (string.IsNullOrWhiteSpace(thread.ExecutionDeviceId)) return ToExecutionDevice(CurrentDevice);
        var known = DeviceChoices.FirstOrDefault(d =>
            string.Equals(d.DeviceId, thread.ExecutionDeviceId, StringComparison.Ordinal));
        return known is not null
            ? ToExecutionDevice(known)
            : new ExecutionDevice(
                thread.ExecutionDeviceId,
                thread.ExecutionDeviceName,
                thread.ExecutionDevicePlatform ?? global::Mesh.Shared.DevicePlatforms.Unknown);
    }

    static ExecutionDevice ToExecutionDevice(global::Mesh.Shared.DeviceInfo device) =>
        new(device.DeviceId, device.Name, device.Platform);

    bool IsCurrentDevice(global::Mesh.Shared.DeviceInfo device) =>
        string.Equals(device.DeviceId, Mesh.MyDeviceId, StringComparison.Ordinal);

    // Whether a device can be chosen to run a topic. The current device runs the turn locally (in the
    // foreground), so it only needs a ready local model. This holds on mobile, which can run its own
    // chats but cannot host a remote turn for another device. Any other device must be an online,
    // eligible remote host (a desktop with the remote agent enabled).
    bool CanRunHere(global::Mesh.Shared.DeviceInfo device) =>
        IsCurrentDevice(device)
            ? Agent.IsModelReady
            : device.Online && device.CanHostRemoteTurn;

    bool IsTopicBusy(OwnThread thread) => RemoteRunActivity.IsBusy(
        thread,
        State.IsThreadBusy(thread.Id),
        State.GetRemoteRunProjection(thread.Id),
        IsAssignedElsewhere(thread),
        DateTimeOffset.UtcNow,
        UsesAuthoritativeState(thread));

    bool UsesAuthoritativeState(OwnThread thread) => RemoteRunActivity.UsesAuthoritativeState(
        Mesh.SupportsAuthoritativeTopicState,
        thread.ExecutionDeviceId,
        Mesh.MyDeviceId,
        eligibleDevices);

    bool IsAssignedElsewhere(OwnThread thread) =>
        !string.IsNullOrWhiteSpace(thread.ExecutionDeviceId)
        && !string.Equals(thread.ExecutionDeviceId, Mesh.MyDeviceId, StringComparison.Ordinal);

    bool IsDeviceOnline(string? deviceId)
    {
        if (string.IsNullOrWhiteSpace(deviceId)
            || string.Equals(deviceId, Mesh.MyDeviceId, StringComparison.Ordinal))
            return true;
        return eligibleDevices.FirstOrDefault(d =>
            string.Equals(d.DeviceId, deviceId, StringComparison.Ordinal))?.Online == true;
    }

    bool IsActiveDevice(global::Mesh.Shared.DeviceInfo device) =>
        Active is not null
        && string.Equals(Active.ExecutionDeviceId ?? Mesh.MyDeviceId, device.DeviceId, StringComparison.Ordinal);

    static string FriendlyName(global::Mesh.Shared.DeviceInfo device) =>
        string.IsNullOrWhiteSpace(device.Name) ? PlatformName(device.Platform) : device.Name;

    static string FriendlyName(ExecutionDevice device) =>
        string.IsNullOrWhiteSpace(device.DeviceName) ? PlatformName(device.Platform) : device.DeviceName;

    static string DeviceLabel(OwnThread thread) =>
        string.IsNullOrWhiteSpace(thread.ExecutionDeviceName)
            ? PlatformName(thread.ExecutionDevicePlatform)
            : thread.ExecutionDeviceName;

    static string PlatformName(string? platform) => platform?.ToLowerInvariant() switch
    {
        global::Mesh.Shared.DevicePlatforms.Windows => "Windows device",
        global::Mesh.Shared.DevicePlatforms.MacOS => "Mac",
        global::Mesh.Shared.DevicePlatforms.Android => "Android device",
        global::Mesh.Shared.DevicePlatforms.IOS => "iPhone or iPad",
        _ => "Linked device"
    };

    static string PlatformIcon(string? platform) => platform?.ToLowerInvariant() switch
    {
        global::Mesh.Shared.DevicePlatforms.Windows => "bi-windows",
        global::Mesh.Shared.DevicePlatforms.MacOS => "bi-apple",
        global::Mesh.Shared.DevicePlatforms.Android => "bi-android2",
        global::Mesh.Shared.DevicePlatforms.IOS => "bi-phone",
        _ => "bi-device-ssd"
    };

    // A short title from the first message of a new chat.
    static string Titleize(string text)
    {
        var clean = text.Replace("\r", " ").Replace("\n", " ").Trim();
        if (clean.Length == 0) return "New chat";
        return clean.Length > 40 ? clean[..40].TrimEnd() + "…" : clean;
    }

    void PinWidget(string html, ChatLine line)
    {
        pinHtml = html;
        pinName = "";
        pinPrompt = line.WidgetPrompt;
        pinError = null;
    }

    void OnPinKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(pinName)) ConfirmPin();
    }

    void ConfirmPin()
    {
        if (pinHtml is null || string.IsNullOrWhiteSpace(pinName)) return;
        var name = pinName.Trim();
        if (State.Profile.Widgets.Any(w => string.Equals(w.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            pinError = $"A widget named \"{name}\" already exists. Choose a different name.";
            return;
        }
        var widget = new Widget
        {
            Name = name,
            Html = pinHtml!,
            Prompt = pinPrompt ?? "Pinned from conversation",
            Visibility = "private",
            ModifiedAt = DateTimeOffset.UtcNow,
        };
        State.SaveAssetContent(AssetKind.Widget, widget.Id, p => p.Widgets.Add(widget));
        pinHtml = null;
        pinName = "";
        pinPrompt = null;
        pinError = null;
    }

    public void Dispose()
    {
        disposed = true;
        _ = JS.InvokeVoidAsync("meshUI.setMobileThreadOpen", false);
        State.Changed -= Refresh;
        Mesh.StateChanged -= OnMeshStateChanged;
        Mesh.ReplicationStateChanged -= Refresh;
        selfRef?.Dispose();
    }
}
