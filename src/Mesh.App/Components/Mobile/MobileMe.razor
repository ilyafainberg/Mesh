    void RestoreTopicState(string threadId)
    {
        var generation = navigationGeneration;
        var revision = inputRevision;
        var operationKey =
            $"topic.open:{componentLifecycleId}:{threadId}";
        var requestId = $"{generation}:{revision}";
        restoreOperationKey = operationKey;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:restore:{threadId}",
            threadId);
        UiOperations.RunLatest(
            operationKey,
            requestId,
            componentLifecycleId,
            "ui.topic.open",
            ct =>
            {
                ct.ThrowIfCancellationRequested();
                MeshDb.ComposerDraft? draft = null;
                State.TryApplyScopedAsyncOperation(operationScope, () =>
                {
                    draft = State.GetTopicDraftState(threadId);
                    ct.ThrowIfCancellationRequested();
                    State.MarkThreadSeen(threadId);
                });
                return Task.FromResult(draft);
            },
            outcome => ApplyTopicRestoreOutcomeAsync(
                threadId, generation, revision, operationKey, operationScope, outcome),
            callbackLifetime.Token,
            TimeSpan.FromSeconds(8));
    }

    Task ApplyTopicRestoreOutcomeAsync(
        string threadId,
        long generation,
        long revision,
        string operationKey,
        ScopedAsyncOperation operationScope,
        UiOperationOutcome<MeshDb.ComposerDraft?> outcome)
        => InvokeAsync(() =>
        {
            State.TryCompleteScopedAsyncOperation(operationScope, () =>
            {
                if (disposed
                    || generation != navigationGeneration
                    || !string.Equals(activeThread, threadId, StringComparison.Ordinal))
                    return;

                if (string.Equals(restoreOperationKey, operationKey, StringComparison.Ordinal)
                    && !UiOperations.IsRunning(operationKey))
                    restoreOperationKey = null;

                switch (outcome.Kind)
                {
                    case UiOperationOutcomeKind.Succeeded:
                        if (revision != inputRevision)
                        {
                            topicRestoreError = "Draft state changed while recovery was running; reconciling the latest revision.";
                            AttachPendingSendObserver(threadId);
                            RestoreTopicState(threadId);
                        }
                        else if (outcome.Result is { IsMalformed: true })
                        {
                            inputValue = outcome.Result.Text;
                            inputRevision = 0;
                            topicRestoreError = "This legacy draft has an invalid revision and must be edited before sending.";
                            AttachPendingSendObserver(threadId);
                        }
                        else
                        {
                            var restored = outcome.Result;
                            inputValue = restored?.Text ?? "";
                            inputRevision = restored?.Revision ?? 0;
                            RestoreComposerSnapshot(restored?.TopicSnapshot);
                            if (inputRevision > 0)
                                ComposerRevisions.SetExact(threadId, inputRevision, inputValue);
                            topicRestoreError = null;
                            AttachPendingSendObserver(threadId);
                        }
                        break;
                    case UiOperationOutcomeKind.TimedOut:
                        topicRestoreError = "This topic opened, but local draft recovery is still pending.";
                        ScheduleTopicRestoreRetry(threadId, generation);
                        break;
                    case UiOperationOutcomeKind.Failed:
                        topicRestoreError = "This topic opened, but its local draft could not be restored.";
                        ScheduleTopicRestoreRetry(threadId, generation);
                        break;
                    case UiOperationOutcomeKind.Cancelled:
                        ScheduleTopicRestoreRetry(threadId, generation);
                        break;
                }
                StateHasChanged();
            });
        });

    void AttachPendingSendObserver(string threadId)
    {
        var thread = Active;
        if (thread is null || !string.Equals(thread.Id, threadId, StringComparison.Ordinal))
            return;
        var targetDeviceId = ResolveTarget(thread).DeviceId;
        if (!TopicSends.TryGetSnapshot(
                threadId,
                targetDeviceId,
                inputRevision,
                out var submission)
            || submission is null)
            return;

        var submittedDraft = new ComposerRevisionSnapshot(
            threadId,
            submission.ComposerRevision,
            inputValue);
        if (!State.TryCaptureActiveThreadMutationScope(threadId, out var presentationScope))
            return;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:send-outcome:{submission.OperationId}",
            submission.ThreadId,
            submission.LineId,
            submission.OperationId,
            submission.RunId);
        AttachSendObserver(
            submission,
            outcome =>
            {
                var current = ComposerRevisions.GetOrCreate(threadId, "");
                var clearedRevision = outcome.Kind == TopicSendOutcomeKind.Accepted
                                      && current.Text.Length == 0
                    ? current.Revision
                    : 0;
                return ApplySendOutcomeFencedAsync(
                    submission,
                    submittedDraft,
                    clearedRevision,
                    outcome,
                    presentationScope!,
                    operationScope);
            });
        if (TopicSends.RequiresRecovery(submission.OperationId))
            ObserveComponentTask(
                TopicSends.RequestReconciliationAsync(
                    submission,
                    draftCleanup: CreateDraftCleanup(submittedDraft, submission),
                    cancellationToken: callbackLifetime.Token),
                "reconcile-topic-send");
    }

    void AttachSendObserver(
        TopicSendSnapshot submission,
        Func<TopicSendOutcome, Task> observer)
    {
        if (sendObserverSubscriptions.ContainsKey(submission.OperationId)) return;
        var dispatcher = observerDispatcher
            ?? throw new InvalidOperationException(
                "The renderer dispatcher must be captured before attaching a topic-send observer.");
        var subscription = TopicSends.Observe(
            submission.OperationId,
            componentLifecycleId,
            dispatcher,
            observer,
            callbackLifetime.Token);
        if (subscription is not null)
            sendObserverSubscriptions.Add(submission.OperationId, subscription);
    }

    void CaptureObserverDispatcher(ITopicSendObserverDispatcher dispatcher)
        => observerDispatcher ??= dispatcher;

    void ScheduleTopicRestoreRetry(string threadId, long generation)
    {
        ObserveComponentTask(
            RetryTopicRestoreAsync(threadId, generation),
            "retry-topic-restore");
    }

    async Task RetryTopicRestoreAsync(string threadId, long generation)
    {
        if (!State.TryCaptureActiveThreadMutationScope(threadId, out _)) return;
        var operationScope = State.CaptureScopedAsyncOperation(
            $"{asyncScopeOwner}:restore:{threadId}",
            threadId);
        try
        {
            await Task.Delay(100, callbackLifetime.Token);
            await InvokeAsync(() =>
            {
                if (!disposed
                    && generation == navigationGeneration
                    && string.Equals(activeThread, threadId, StringComparison.Ordinal))
                    State.TryCompleteScopedAsyncOperation(
                        operationScope,
                        () => RestoreTopicState(threadId));
            });
        }
        catch (OperationCanceledException) when (callbackLifetime.IsCancellationRequested)
        {
        }
    }

