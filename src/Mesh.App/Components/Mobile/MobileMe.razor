        if (option.IsRecommended) label += " (recommended)";
        if (!string.IsNullOrWhiteSpace(option.Description)) label += ". " + option.Description;
        return label;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            selfRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);

        // Wire each helper when its element actually exists. On mobile the list and composer are
        // mutually exclusive, so firstRender alone cannot initialize both.
        if (Active is null)
        {
            composerWired = false;
            lastScrolledThread = null;
            try { await JS.InvokeVoidAsync("meshUI.setMobileThreadOpen", false); } catch { }
            try { await JS.InvokeVoidAsync("meshUI.swipeActions", threadRowsEl); } catch { }
            return;
        }

        try { await JS.InvokeVoidAsync("meshUI.setMobileThreadOpen", true); } catch { }

        if (selfRef is not null)
        {
            if (!composerWired)
            {
                try
                {
                    await JS.InvokeVoidAsync("meshUI.composer", composerEl, selfRef, 5);
                    await JS.InvokeVoidAsync("meshPaste.attach", composerEl, selfRef);
                    composerWired = true;
                }
                catch { }
            }
        }

        try { await JS.InvokeVoidAsync("meshUI.autoScroll", scrollEl, scrollToLatestEl); } catch { }

        var scrollToLatest = scrollToLatestRequested;
        scrollToLatestRequested = false;
        if (preserveHistoryScroll)
        {
            preserveHistoryScroll = false;
            if (!scrollToLatest) return;
        }

        // Scroll on first paint, when a line is added, AND when the active thread's turn finishes
        // (busy true->false): the reply is added while the thread is still busy, so tracking that
        // transition guarantees the final answer scrolls into view even if its line count collides
        // with an earlier render.
        var count = Active?.Lines.Count ?? 0;
        var activeChanged = activeThread != lastScrolledThread;
        if (activeChanged)
        {
            try { await JS.InvokeVoidAsync("meshUI.resizeComposer", composerEl, 5); } catch { }
        }
        if (scrollToLatest || firstRender || activeChanged || count != lastCount || ActiveBusy != lastBusy || ActiveBusy)
        {
            lastCount = count;
            lastBusy = ActiveBusy;
            lastScrolledThread = activeThread;
            var method = scrollToLatest || firstRender || activeChanged
                ? "meshUI.scrollToBottom"
                : "meshUI.scrollToBottomIfPinned";
            try { await JS.InvokeVoidAsync(method, scrollEl); } catch { }
        }
    }

    async Task ScrollToLatest()
    {
        try { await JS.InvokeVoidAsync("meshUI.scrollToBottom", scrollEl); } catch { }
    }

    /// <summary>Invoked from JS when the user presses Enter (without Shift) in the composer.</summary>
