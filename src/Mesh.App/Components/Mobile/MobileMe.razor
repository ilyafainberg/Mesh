    long ScheduleComposerSnapshot()
    {
        var thread = Active;
        if (activeThreadValue is null || thread is null) return 0;
        var snapshot = CaptureComposerSnapshot(thread);
        try
        {
            inputRevision = State.SetTopicDraftSnapshotRevision(
                activeThreadValue,
                snapshot);
            composerPersistenceError = null;
        }
        catch (Exception exception)
        {
            RuntimeDiagnostics.Current?.RecordEvent(
                "topic-draft-stage-failed",
                $"thread={TopicSendSnapshot.StableId("thread", thread.Id)};"
                + $"exception={exception.GetType().FullName}");
            composerPersistenceError = "The latest edit could not be staged durably. Retry before sending.";
            return 0;
        }
        if (inputRevision > 0)
            ComposerRevisions.SetExact(activeThreadValue, inputRevision, inputValue);
        return inputRevision;
    }

