@* Mobile "Me" agent chat screen. WhatsApp-style: a list of private topic chats
   that drills into a full-screen thread with the user's personal AI agent.
   The @code block is ported essentially verbatim from Components/Pages/Home.razor;
   the only adaptations are the DotNetObjectReference generic (MobileMe) and
   OnInitialized defaulting to the LIST view instead of auto-opening a thread. *@
@page "/m/me"
@inject AppState State
@inject AgentService Agent
@inject MeshClient Mesh
@inject LocalFileRegistry LocalFiles
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

@if (Active is null)
{
    @* A) LIST screen: shown when no thread is selected, or the selected thread no longer exists. *@
    <div class="me-list">
        <header class="list-head">
            <h2><i class="bi bi-person-badge"></i> Me</h2>
            <p class="list-sub">your private topic chats</p>
        </header>

        <button class="new-chat-row" @onclick="NewThread" aria-label="New chat">
            <span class="new-chat-icon"><i class="bi bi-plus-lg"></i></span>
            <span class="new-chat-label">New chat</span>
        </button>

        @if (State.Profile.OwnThreads.Count == 0)
        {
            <div class="list-empty">
                <i class="bi bi-chat-heart"></i>
                <p class="empty-title">No chats yet</p>
                <p class="empty-sub">Start a private topic chat with your personal agent using "New chat" above.</p>
            </div>
        }
        else
        {
            <div class="thread-rows">
                @foreach (var t in Threads)
                {
                    <button class="thread-row" @onclick="() => Select(t.Id)">
                        <span class="row-avatar"><i class="bi bi-chat-text"></i></span>
                        <span class="row-title">@(string.IsNullOrWhiteSpace(t.Title) ? "New chat" : t.Title)</span>
                        <i class="bi bi-chevron-right row-chevron"></i>
                    </button>
                }
            </div>
        }
    </div>
}
else
{
    @* B) THREAD screen: full-screen overlay that covers the app bottom tab bar. *@
    <div class="thread-overlay">
        <header class="thread-bar">
            <button class="bar-btn back-btn" @onclick="() => activeThread = null" title="Back to chats" aria-label="Back to chats">
                <i class="bi bi-chevron-left"></i>
            </button>
            @if (renaming)
            {
                <input class="rename-input" @bind="renameText" @bind:event="oninput" @onkeydown="OnRenameKey" aria-label="Chat title" />
                <button class="bar-btn" title="Save" @onclick="SaveRename" aria-label="Save title"><i class="bi bi-check-lg"></i></button>
                <button class="bar-btn" title="Cancel" @onclick="() => renaming = false" aria-label="Cancel rename"><i class="bi bi-x-lg"></i></button>
            }
            else
            {
                <span class="bar-title">@(string.IsNullOrWhiteSpace(Active.Title) ? "New chat" : Active.Title)</span>
                <span class="bar-actions">
                    <TokenMeter Compact="true" />
                    <button class="bar-btn" title="Rename chat" aria-label="Rename chat" @onclick="BeginRename"><i class="bi bi-pencil"></i></button>
                    @if (confirmDelete)
                    {
                        <button class="bar-btn text-btn" title="Clear messages, keep the chat" @onclick="ClearActive">Clear</button>
                        <button class="bar-btn danger-btn" title="Delete this chat and its history" @onclick="DeleteActive">Delete</button>
                        <button class="bar-btn" title="Cancel" @onclick="() => confirmDelete = false" aria-label="Cancel"><i class="bi bi-x-lg"></i></button>
                    }
                    else
                    {
                        <button class="bar-btn" title="Delete chat" aria-label="Delete chat" @onclick="() => confirmDelete = true"><i class="bi bi-trash"></i></button>
                    }
                </span>
            }
        </header>

        <div class="messages" @ref="scrollEl">
            <div class="messages-wrap">
                @if (Active.Lines.Count == 0)
                {
                    <div class="empty">
                        This is your private assistant. It knows everything in your Knowledge and Skills,
                        and helps you manage what your public agent shares with others. Ask it anything.
                    </div>
                }
                @foreach (var line in Active.Lines)
                {
                    <div class="bubble @(line.Role)">
                        <MessageContent Text="@line.Text" OnPin="PinWidget" />
                        @if (IsQueued(line))
                        {
                            <div class="msg-tag"><i class="bi bi-hourglass-split"></i> queued</div>
                        }
                    </div>
                }
                @if (busy) { <div class="bubble assistant"><div class="text muted">@(building ? "…building widget" : "…thinking")</div></div> }
            </div>
        </div>

        <div class="composer-area">
            <div class="composer-inner">
                @if (pinHtml is not null)
                {
                    <div class="pin-bar">
                        <i class="bi bi-pin-angle"></i>
                        <input @bind="pinName" placeholder="Name this widget…" @onkeydown="OnPinKey" aria-label="Name this widget" />
                        <button class="primary" @onclick="ConfirmPin" disabled="@string.IsNullOrWhiteSpace(pinName)">Pin</button>
                        <button class="ghost icon-btn" @onclick="() => pinHtml = null" title="Cancel" aria-label="Cancel"><i class="bi bi-x-lg"></i></button>
                    </div>
                }
                @if (widgetMode)
                {
                    <div class="mode-chip">
                        <i class="bi bi-window-stack"></i> widget
                        <button class="chip-x" @onclick="() => widgetMode = false" title="Cancel widget" aria-label="Cancel widget"><i class="bi bi-x"></i></button>
                        <span class="mode-hint">describe the mini-app you want</span>
                    </div>
                }
                else if (ShowPreview)
                {
                    <div class="composer-preview">
                        <span class="preview-label"><i class="bi bi-eye"></i> preview</span>
                        <div class="text md">@((MarkupString)Markdown.ToHtml(input))</div>
                    </div>
                }
                @if (attachments.Count > 0)
                {
                    <div class="attach-bar">
                        @foreach (var a in attachments)
                        {
                            <span class="attach-chip">
                                <i class="bi bi-paperclip"></i>
                                <span class="attach-name">@a.Name</span>
                                <span class="attach-size">@a.SizeLabel</span>
                                <button class="chip-x" @onclick="() => attachments.Remove(a)" title="Remove" aria-label="Remove attachment"><i class="bi bi-x"></i></button>
                            </span>
                        }
                    </div>
                }
                <div class="composer">
                    <button class="ghost icon-btn plus-btn @(widgetMode ? "on" : "")" @onclick="ToggleWidget" disabled="@busy" title="Create a widget (mini-app)" aria-label="Create a widget">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                    <button class="ghost icon-btn plus-btn" @onclick="PickFile" disabled="@busy" title="Attach an image or document" aria-label="Attach an image or document">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    @if (!IsDesktop)
                    {
                        <button class="ghost icon-btn plus-btn @(homeMode ? "on" : "")" @onclick="() => homeMode = !homeMode" disabled="@busy"
                                title="Ask my home agent (runs on my desktop with full tools)" aria-label="Ask my home agent">
                            <i class="bi bi-house-gear"></i>
                        </button>
                    }
                    <textarea @ref="composerEl" @bind="input" @bind:event="oninput" rows="1" class="composer-input"
                              placeholder="@(widgetMode ? "Describe the widget you want…" : "Message your assistant…")" aria-label="Message your assistant"></textarea>
                    <button class="primary send-btn" @onclick="Send" disabled="@(string.IsNullOrWhiteSpace(input) && attachments.Count == 0)" title="Send" aria-label="Send">
                        <i class="bi @(widgetMode ? "bi-magic" : "bi-send")"></i>
                    </button>
                </div>
                @if (attachError is not null) { <p class="err-text">@attachError</p> }
                @if (!Agent.IsModelReady)
                {
                    <div class="warn-banner"><i class="bi bi-exclamation-triangle"></i> No model configured. Go to <a href="settings">Settings</a>.</div>
                }
                else if (QuotaExhausted)
                {
                    <div class="warn-banner">
                        <i class="bi bi-hourglass-bottom"></i>
                        Today's free-model limit is reached. <a href="settings">Add your own model key</a> for unlimited use, or switch to an on-device model.
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    string input = "";
    bool busy;
    bool building;
    bool widgetMode;
    bool homeMode;
    bool confirmDelete;
    bool renaming;
    string renameText = "";
    string? activeThread;
    string? pinHtml;
    string pinName = "";
    ElementReference scrollEl;
    ElementReference composerEl;
    Microsoft.JSInterop.DotNetObjectReference<MobileMe>? selfRef;
    bool composerWired;
    int lastCount = -1;
    bool lastBusy;

    readonly List<StagedFile> attachments = new();
    string? attachError;

    // Tier-1 steerable input: messages submitted while a turn is running are queued (shown
    // immediately as a subtle "queued" line) and answered together in ONE follow-up turn after
    // the current one finishes, in order. Never runs two agent turns concurrently.
    readonly List<ChatLine> queued = new();
    bool IsQueued(ChatLine line) => queued.Contains(line);

    sealed record StagedFile(string Name, string Path, long Size)
    {
        public string SizeLabel => Human(Size);
    }

    // Desktop clients are the home agent, so the "ask my home agent" shortcut is only useful on mobile.
    static bool IsDesktop => OperatingSystem.IsWindows() || OperatingSystem.IsMacCatalyst() || OperatingSystem.IsMacOS();

    IReadOnlyList<OwnThread> Threads => State.Profile.OwnThreads;
    OwnThread? Active => activeThread is null ? null : State.Profile.OwnThreads.FirstOrDefault(t => t.Id == activeThread);

    bool ShowPreview => !string.IsNullOrWhiteSpace(input) && Markdown.LooksLikeMarkdown(input);

    // The free model returns a friendly limit message when the daily token budget is spent.
    bool QuotaExhausted
    {
        get
        {
            if (State.Profile.Model.Provider != global::Mesh.App.Domain.ModelProvider.MeshHosted) return false;
            var last = Active?.Lines.LastOrDefault(l => l.Role == "assistant");
            return last is not null && last.Text.StartsWith("You've reached today's free-model limit", StringComparison.Ordinal);
        }
    }

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        // Deep-link: /m/me?thread=id opens that topic (used by Search). Otherwise land on the LIST
        // view - on mobile we do NOT auto-open the most recent thread; the user picks one.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var wanted = ParseQueryValue(uri.Query, "thread");
        if (!string.IsNullOrWhiteSpace(wanted) && State.Profile.OwnThreads.Any(t => t.Id == wanted))
            activeThread = wanted;
        else
            activeThread = null;
    }

    static string? ParseQueryValue(string queryString, string key)
    {
        if (string.IsNullOrEmpty(queryString)) return null;
        foreach (var pair in queryString.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0) continue;
            if (Uri.UnescapeDataString(pair[..eq]) == key) return Uri.UnescapeDataString(pair[(eq + 1)..]);
        }
        return null;
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !composerWired)
        {
            composerWired = true;
            selfRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("meshUI.composer", composerEl, selfRef, 5); } catch { }
        }

        // Scroll on first paint, when a line is added, AND when the agent finishes (busy true->false):
        // the reply is added while busy is still true, so tracking busy transitions guarantees the
        // final answer scrolls into view even if its line count collides with an earlier render.
        var count = Active?.Lines.Count ?? 0;
        if (firstRender || count != lastCount || busy != lastBusy)
        {
            lastCount = count;
            lastBusy = busy;
            try { await JS.InvokeVoidAsync("meshUI.scrollToBottom", scrollEl); } catch { }
        }
    }

    /// <summary>Invoked from JS when the user presses Enter (without Shift) in the composer.</summary>
    [Microsoft.JSInterop.JSInvokable]
    public Task SendFromComposer() => Send();

    void Select(string id) { activeThread = id; confirmDelete = false; renaming = false; }

    void NewThread()
    {
        var t = State.NewOwnThread();
        activeThread = t.Id;
        confirmDelete = false;
        renaming = false;
        input = "";
    }

    void BeginRename()
    {
        if (Active is null) return;
        renameText = Active.Title;
        renaming = true;
    }

    void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveRename();
        else if (e.Key == "Escape") renaming = false;
    }

    void SaveRename()
    {
        if (Active is not null) State.RenameOwnThread(Active.Id, renameText);
        renaming = false;
    }

    void ClearActive()
    {
        if (Active is not null) State.ClearOwnThread(Active.Id);
        confirmDelete = false;
    }

    void DeleteActive()
    {
        if (Active is null) return;
        var id = Active.Id;
        confirmDelete = false;
        State.DeleteOwnThread(id);
        activeThread = State.Profile.OwnThreads.Count > 0 ? State.Profile.OwnThreads[^1].Id : null;
    }

    void ToggleWidget() { widgetMode = !widgetMode; }

    async Task ResetComposer()
    {
        try { await JS.InvokeVoidAsync("meshUI.resetComposer", composerEl); } catch { }
    }

    async Task PickFile()
    {
        attachError = null;
        try
        {
            var file = await Microsoft.Maui.Storage.FilePicker.Default.PickAsync();
            if (file is null) return;
            var path = file.FullPath;
            if (string.IsNullOrWhiteSpace(path) || !System.IO.File.Exists(path))
            {
                attachError = "Could not resolve that file's path on disk.";
                return;
            }
            long size = 0;
            try { size = new System.IO.FileInfo(path).Length; } catch { }
            LocalFiles.Allow(path);
            attachments.Add(new StagedFile(file.FileName, path, size));
        }
        catch (Exception ex) { attachError = "Couldn't attach that file: " + ex.Message; }
    }

    static string Human(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }

    async Task Send()
    {
        if (string.IsNullOrWhiteSpace(input) && attachments.Count == 0) return;

        // Ensure there is a thread to write into, and name a fresh one after its first message.
        var thread = Active ?? State.NewOwnThread();
        activeThread = thread.Id;
        var text = input;
        if (string.Equals(thread.Title, "New chat", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(text))
            State.RenameOwnThread(thread.Id, Titleize(text));

        var files = attachments.ToList();
        input = "";
        attachments.Clear();
        _ = ResetComposer();

        // A turn is already running: queue this input for the next turn instead of starting a
        // second concurrent agent call. Show it immediately as a subtle "queued" user line; it is
        // already in the thread history, so the drain turn below answers it in order.
        if (busy)
        {
            var qLine = new ChatLine { Role = "user", Text = ComposeOwnerPrompt(text, files) };
            State.AddOwnChatLine(thread.Id, qLine);
            queued.Add(qLine);
            return;
        }

        busy = true;
        try
        {
            if (widgetMode)
            {
                building = true;
                widgetMode = false;
                var html = await Agent.BuildWidgetAsync(text);
                State.AddOwnChatLine(thread.Id, new ChatLine { Role = "user", Text = $"Build a widget: {text}" });
                State.AddOwnChatLine(thread.Id, new ChatLine { Role = "assistant", Text = html });
            }
            else if (homeMode)
            {
                State.AddOwnChatLine(thread.Id, new ChatLine { Role = "user", Text = text });
                var ok = await Mesh.AskHomeAgentAsync(text);
                State.AddOwnChatLine(thread.Id, new ChatLine
                {
                    Role = "assistant",
                    Text = ok
                        ? "Sent to your home agent. Its reply will arrive in Messages (from your own handle) and as a notification."
                        : "[could not reach your home agent: not connected, or no device has 'Answer my other devices' enabled]"
                });
            }
            else
            {
                await Agent.AskAsOwnerAsync(thread.Id, ComposeOwnerPrompt(text, files));
            }

            // Drain anything queued while the turn above ran. Each drain answers ALL currently
            // queued lines together in one continuation turn (they are consecutive user turns
            // already in the history); loop in case more were queued while draining.
            while (queued.Count > 0)
            {
                queued.Clear(); // they are now being answered, not waiting
                building = false;
                await Agent.ContinueAsOwnerAsync(thread.Id);
            }
        }
        catch (Exception ex) { State.AddOwnChatLine(thread.Id, new ChatLine { Role = "assistant", Text = $"[error: {ex.Message}]" }); }
        finally { busy = false; building = false; }
    }

    // Builds the owner prompt, appending any staged local file paths the agent can open on request.
    static string ComposeOwnerPrompt(string? text, List<StagedFile> files)
    {
        var prompt = text ?? "";
        if (files.Count > 0)
        {
            var sb = new System.Text.StringBuilder(prompt);
            if (sb.Length > 0) sb.Append("\n\n");
            sb.Append("Attached local files (use the read_local_file tool to open any you need):");
            foreach (var f in files) sb.Append($"\n- {f.Path}");
            prompt = sb.ToString();
        }
        return prompt;
    }

    // A short title from the first message of a new chat.
    static string Titleize(string text)
    {
        var clean = text.Replace("\r", " ").Replace("\n", " ").Trim();
        if (clean.Length == 0) return "New chat";
        return clean.Length > 40 ? clean[..40].TrimEnd() + "…" : clean;
    }

    void PinWidget(string html)
    {
        pinHtml = html;
        pinName = "";
    }

    void OnPinKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(pinName)) ConfirmPin();
    }

    void ConfirmPin()
    {
        if (pinHtml is null || string.IsNullOrWhiteSpace(pinName)) return;
        State.Mutate(p => p.Widgets.Add(new Widget { Name = pinName.Trim(), Html = pinHtml!, Visibility = "private" }));
        pinHtml = null;
        pinName = "";
    }

    public void Dispose()
    {
        State.Changed -= Refresh;
        selfRef?.Dispose();
    }
}
