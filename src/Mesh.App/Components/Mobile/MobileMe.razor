    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        Mesh.ReplicationStateChanged += Refresh;
        Agent.EnsureAskUserResumeRegistered();
        ObserveComponentTask(State.RecoverPendingAskUserPromptsAsync(), "recover-ask-user");
        // Deep-link: /m/me?thread=id opens that topic (used by Search). Otherwise land on the LIST
        // view - on mobile we do NOT auto-open the most recent thread; the user picks one.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var wanted = ParseQueryValue(uri.Query, "thread");
        if (!string.IsNullOrWhiteSpace(wanted) && State.Profile.OwnThreads.Any(t => t.Id == wanted))
        {
            activeThread = wanted;
            RestoreTopicState(wanted);
        }
        else
            activeThread = null;
        Mesh.StateChanged += OnMeshStateChanged;
        RequestDeviceRefresh();
    }

    void OnMeshStateChanged()
    {
        if (disposed || Shutdown.IsStopping) return;
        RequestDeviceRefresh();
        Refresh();
    }

    static string? ParseQueryValue(string queryString, string key)
    {
        if (string.IsNullOrEmpty(queryString)) return null;
        foreach (var pair in queryString.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0) continue;
            if (Uri.UnescapeDataString(pair[..eq]) == key) return Uri.UnescapeDataString(pair[(eq + 1)..]);
        }
        return null;
    }

    void Refresh()
    {
        if (disposed || Shutdown.IsStopping || Interlocked.Exchange(ref renderQueued, 1) != 0) return;
        Shutdown.Track(InvokeAsync(() =>
        {
            Interlocked.Exchange(ref renderQueued, 0);
            if (!disposed && !Shutdown.IsStopping) StateHasChanged();
        }), "mobile Me refresh");
    }

    readonly HashSet<string> askResolving = new(StringComparer.Ordinal);

    async Task ResolveAskAsync(string promptId, string optionId)
    {
        if (!askResolving.Add(promptId)) return; // one click wins; ignore re-entrancy
        try
        {
            await State.ResolveAskUserPromptAsync(promptId, optionId);
        }
        finally
        {
            askResolving.Remove(promptId);
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            selfRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);

        // Wire each helper when its element actually exists. On mobile the list and composer are
        // mutually exclusive, so firstRender alone cannot initialize both.
        if (Active is null)
        {
            composerWired = false;
            lastScrolledThread = null;
            try { await JS.InvokeVoidAsync("meshUI.setMobileThreadOpen", false); } catch { }
            try { await JS.InvokeVoidAsync("meshUI.swipeActions", threadRowsEl); } catch { }
            return;
        }

        try { await JS.InvokeVoidAsync("meshUI.setMobileThreadOpen", true); } catch { }

        if (selfRef is not null)
        {
            if (!composerWired)
            {
                try
                {
                    await JS.InvokeVoidAsync("meshUI.composer", composerEl, selfRef, 5);
                    await JS.InvokeVoidAsync("meshPaste.attach", composerEl, selfRef);
                    composerWired = true;
                }
                catch { }
            }
        }

        try { await JS.InvokeVoidAsync("meshUI.autoScroll", scrollEl, scrollToLatestEl); } catch { }

        var scrollToLatest = scrollToLatestRequested;
        scrollToLatestRequested = false;
        if (preserveHistoryScroll)
        {
            preserveHistoryScroll = false;
            if (!scrollToLatest) return;
        }

        // Scroll on first paint, when a line is added, AND when the active thread's turn finishes
        // (busy true->false): the reply is added while the thread is still busy, so tracking that
        // transition guarantees the final answer scrolls into view even if its line count collides
        // with an earlier render.
        var count = Active?.Lines.Count ?? 0;
        var activeChanged = activeThread != lastScrolledThread;
        if (activeChanged)
        {
            try { await JS.InvokeVoidAsync("meshUI.resizeComposer", composerEl, 5); } catch { }
        }
        if (scrollToLatest || firstRender || activeChanged || count != lastCount || ActiveBusy != lastBusy || ActiveBusy)
        {
            lastCount = count;
            lastBusy = ActiveBusy;
            lastScrolledThread = activeThread;
            var method = scrollToLatest || firstRender || activeChanged
                ? "meshUI.scrollToBottom"
                : "meshUI.scrollToBottomIfPinned";
            try { await JS.InvokeVoidAsync(method, scrollEl); } catch { }
        }
    }

    async Task ScrollToLatest()
    {
        try { await JS.InvokeVoidAsync("meshUI.scrollToBottom", scrollEl); } catch { }
    }

    /// <summary>Invoked from JS when the user presses Enter (without Shift) in the composer.</summary>
    [Microsoft.JSInterop.JSInvokable]
    public Task SendFromComposer() => Send();

    /// <summary>
    /// Invoked from paste.js when a file is pasted into the composer. Writes the pasted bytes to a temp
    /// file and stages it so it sends by path (the same flow as the attach button), then re-renders.
    /// </summary>
    [Microsoft.JSInterop.JSInvokable]
    public Task OnPasteFile(string name, string mime, string base64)
    {
        attachError = null;
        var staged = PasteFiles.SaveTemp(name, mime, base64);
        if (staged is { } s)
        {
            LocalFiles.Allow(s.Path);
            attachments.Add(new StagedFile(s.Name, s.Path, s.Size));
            ScheduleComposerSnapshot();
        }
        else
        {
            attachError = "Could not read the pasted file.";
        }
        return InvokeAsync(StateHasChanged);
    }

    void RequestDeviceRefresh()
    {
        deviceRefreshes.Request(
            async cancellationToken =>
            {
                var devices = await TopicRouter.ListEligibleDevicesAsync(cancellationToken)
                    .ConfigureAwait(false);
                if (disposed) return;
                await InvokeAsync(() =>
                {
                    if (disposed) return;
                    eligibleDevices = devices;
                    StateHasChanged();
                });
            },
            ex =>
            {
            RuntimeDiagnostics.Current?.RecordEvent(
                "topic-device-list-failed",
                $"exception={ex.GetType().FullName}");
            });
    }

    void ShowEarlierMessages()
    {
        messageRenderCount = MessageRenderWindow.NextCount(OrderedVisibleLines.Count, messageRenderCount);
        preserveHistoryScroll = true;
    }

    void Select(string id)
    {
        activeThread = id;
        actionsMenuOpen = false;
        confirmDelete = false;
        renaming = false;
        RestoreTopicState(id);
    }

    void RestoreTopicState(string threadId)
    {
        var generation = navigationGeneration;
        var revision = inputRevision;
        var operationKey =
            $"topic.open:{componentLifecycleId}:{threadId}";
        var requestId = $"{generation}:{revision}";
        restoreOperationKey = operationKey;
        UiOperations.RunLatest(
            operationKey,
            requestId,
            componentLifecycleId,
            "ui.topic.open",
            ct =>
            {
                ct.ThrowIfCancellationRequested();
                var draft = State.GetTopicDraftState(threadId);
                ct.ThrowIfCancellationRequested();
                State.MarkThreadSeen(threadId);
                return Task.FromResult(draft);
            },
            outcome => ApplyTopicRestoreOutcomeAsync(
                threadId, generation, revision, operationKey, outcome),
            callbackLifetime.Token,
            TimeSpan.FromSeconds(8));
    }

    Task ApplyTopicRestoreOutcomeAsync(
        string threadId,
        long generation,
        long revision,
        string operationKey,
        UiOperationOutcome<MeshDb.ComposerDraft?> outcome)
        => InvokeAsync(() =>
        {
            if (disposed
                || generation != navigationGeneration
                || !string.Equals(activeThread, threadId, StringComparison.Ordinal))
                return;

            if (string.Equals(restoreOperationKey, operationKey, StringComparison.Ordinal)
                && !UiOperations.IsRunning(operationKey))
                restoreOperationKey = null;

            switch (outcome.Kind)
            {
                case UiOperationOutcomeKind.Succeeded:
                    if (revision != inputRevision)
                    {
                        attachError = "Draft state changed while recovery was running; reconciling the latest revision.";
                        AttachPendingSendObserver(threadId);
                        RestoreTopicState(threadId);
                    }
                    else if (outcome.Result is { IsMalformed: true })
                    {
                        inputValue = outcome.Result.Text;
                        inputRevision = 0;
                        attachError = "This legacy draft has an invalid revision and must be edited before sending.";
                        AttachPendingSendObserver(threadId);
                    }
                    else
                    {
                        var restored = outcome.Result;
                        inputValue = restored?.Text ?? "";
                        inputRevision = restored?.Revision ?? 0;
                        RestoreComposerSnapshot(restored?.TopicSnapshot);
                        if (inputRevision > 0)
                            ComposerRevisions.SetExact(threadId, inputRevision, inputValue);
                        attachError = null;
                        AttachPendingSendObserver(threadId);
                    }
                    break;
                case UiOperationOutcomeKind.TimedOut:
                    attachError = "This topic opened, but local draft recovery is still pending.";
                    ScheduleTopicRestoreRetry(threadId, generation);
                    break;
                case UiOperationOutcomeKind.Failed:
                    attachError = "This topic opened, but its local draft could not be restored.";
                    ScheduleTopicRestoreRetry(threadId, generation);
                    break;
                case UiOperationOutcomeKind.Cancelled:
                    ScheduleTopicRestoreRetry(threadId, generation);
                    break;
            }
            StateHasChanged();
        });

    void AttachPendingSendObserver(string threadId)
    {
        var thread = Active;
        if (thread is null || !string.Equals(thread.Id, threadId, StringComparison.Ordinal))
            return;
        var targetDeviceId = ResolveTarget(thread).DeviceId;
        if (!TopicSends.TryGetSnapshot(
                threadId,
                targetDeviceId,
                inputRevision,
                out var submission)
            || submission is null)
            return;

        var submittedDraft = new ComposerRevisionSnapshot(
            threadId,
            submission.ComposerRevision,
            inputValue);
        AttachSendObserver(
            submission,
            outcome =>
            {
                var current = ComposerRevisions.GetOrCreate(threadId, "");
                var clearedRevision = outcome.Kind == TopicSendOutcomeKind.Accepted
                                      && current.Text.Length == 0
                    ? current.Revision
                    : 0;
                return ApplySendOutcomeAsync(
                    submission,
                    submittedDraft,
                    clearedRevision,
                    outcome);
            });
        if (TopicSends.RequiresRecovery(submission.OperationId))
            ObserveComponentTask(
                TopicSends.RequestReconciliationAsync(
                    submission,
                    draftCleanup: CreateDraftCleanup(submittedDraft),
                    cancellationToken: callbackLifetime.Token),
                "reconcile-topic-send");
    }

    void AttachSendObserver(
        TopicSendSnapshot submission,
        Func<TopicSendOutcome, Task> observer)
    {
        if (sendObserverSubscriptions.ContainsKey(submission.OperationId)) return;
        var dispatcher = observerDispatcher
            ?? throw new InvalidOperationException(
                "The renderer dispatcher must be captured before attaching a topic-send observer.");
        var subscription = TopicSends.Observe(
            submission.OperationId,
            componentLifecycleId,
            dispatcher,
            observer,
            callbackLifetime.Token);
        if (subscription is not null)
            sendObserverSubscriptions.Add(submission.OperationId, subscription);
    }

    void CaptureObserverDispatcher(ITopicSendObserverDispatcher dispatcher)
        => observerDispatcher ??= dispatcher;

    void ScheduleTopicRestoreRetry(string threadId, long generation)
    {
        ObserveComponentTask(
            RetryTopicRestoreAsync(threadId, generation),
            "retry-topic-restore");
    }

    async Task RetryTopicRestoreAsync(string threadId, long generation)
    {
        try
        {
            await Task.Delay(100, callbackLifetime.Token);
            await InvokeAsync(() =>
            {
                if (!disposed
                    && generation == navigationGeneration
                    && string.Equals(activeThread, threadId, StringComparison.Ordinal))
                    RestoreTopicState(threadId);
            });
        }
        catch (OperationCanceledException) when (callbackLifetime.IsCancellationRequested)
        {
        }
    }

    void TogglePinFromSwipe(OwnThread thread)
    {
        State.SetOwnThreadPinned(thread.Id, !thread.IsPinned);
    }

    void OpenNewDeviceMenu()
    {
        newDeviceMenuOpen = true;
        moveMenuOpen = false;
        RequestDeviceRefresh();
    }

    void OpenMoveMenu()
    {
        moveMenuOpen = true;
        actionsMenuOpen = false;
        newDeviceMenuOpen = false;
        RequestDeviceRefresh();
    }

    void CloseDeviceMenus()
    {
        newDeviceMenuOpen = false;
        moveMenuOpen = false;
        actionsMenuOpen = false;
        pendingMove = null;
    }

    void ToggleActionsMenu()
    {
        actionsMenuOpen = !actionsMenuOpen;
        newDeviceMenuOpen = false;
        moveMenuOpen = false;
