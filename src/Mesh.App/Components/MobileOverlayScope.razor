@inject MobileOverlayState MobileOverlays
@implements IDisposable

@code {
    [Parameter] public bool Active { get; set; } = true;

    readonly object owner = new();
    bool registered;

    protected override void OnParametersSet()
    {
        if (registered == Active) return;
        MobileOverlays.SetActive(owner, Active);
        registered = Active;
    }

    public void Dispose()
    {
        if (!registered) return;
        MobileOverlays.SetActive(owner, false);
        registered = false;
    }
}
