{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Mesh": {
    "MessageRatePerMinute": 120,
    "MessageBurst": 30,
    "GroupMessageRatePerMinute": 120,
    "GroupMessageBurst": 30,
    "MaxFanoutRecipients": 128,
    "RatePolicyCacheSeconds": 60,
    "LiveFaultsEnabled": false,
    "LiveFaultMaxTtlSeconds": 3600,
    "LiveFaultMaxUses": 1000
  },
  "AllowedHosts": "*"
}
