<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mesh.App.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);DEVICE_TOPIC_EXECUTION_TESTS</DefineConstants>
    <NoWarn>$(NoWarn);NETSDK1150</NoWarn>
